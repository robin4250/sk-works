-- REVIEW ONLY. Depends on company_common_payroll_bridge_20261020 (#1276).
-- No activation, publication, backfill or production recalculation on install.
begin;
set local lock_timeout = '5s';
do $$ begin
 if not exists(select 1 from pg_proc where oid=to_regprocedure('payroll_unit_private.resolve_company_common(uuid,uuid,date,date)') and md5(prosrc)='db2de83c4b93ccd56b7c2e5219a0fcbe' and prosecdef and proconfig=ARRAY['search_path=""'])
 or not exists(select 1 from pg_proc where oid=to_regprocedure('payroll_unit_private.augment_settings(uuid,uuid,date,date,jsonb)') and md5(prosrc)='8d5ebc9c0b59e2a4057e1a316767b739')
 or not exists(select 1 from pg_proc where oid=to_regprocedure('payroll_unit_private.common_state(uuid,uuid,date)') and md5(prosrc)='905491b19029f1811b792bdeb71c6552')
 or to_regprocedure('company_common_allowance_private.lock_writer(uuid)') is null then
  raise exception 'dated company common payroll prerequisite differs';end if;
end $$;
create table company_common_allowance_private.payroll_publications(
 company_id uuid not null,version bigint not null check(version between 1 and 9007199254740991),
 payroll_type text not null check(payroll_type in ('daily','hourly','monthly')),
 starts_on date not null check(starts_on=date_trunc('month',starts_on)::date),
 common_version bigint not null,items jsonb not null check(jsonb_typeof(items)='array'),
 request_id uuid not null,actor_id uuid not null,published_at timestamptz not null default clock_timestamp(),
 primary key(company_id,version),unique(company_id,request_id)
);
create index common_payroll_effective on company_common_allowance_private.payroll_publications(company_id,payroll_type,starts_on desc,version desc);
create table company_common_allowance_private.payroll_publication_receipts(
 company_id uuid not null,request_id uuid not null,actor_id uuid not null,
 payload jsonb not null,result jsonb not null,primary key(company_id,request_id)
);
alter table company_common_allowance_private.payroll_publications enable row level security;
alter table company_common_allowance_private.payroll_publication_receipts enable row level security;
revoke all on company_common_allowance_private.payroll_publications,company_common_allowance_private.payroll_publication_receipts from public,anon,authenticated,service_role;
create function company_common_allowance_private.protect_payroll_publication() returns trigger
language plpgsql security definer set search_path='' as $$
begin raise exception 'company common payroll history is immutable' using errcode='55000';end $$;
revoke all on function company_common_allowance_private.protect_payroll_publication() from public,anon,authenticated,service_role;
create trigger immutable_common_payroll_publication before update or delete on company_common_allowance_private.payroll_publications
 for each row execute function company_common_allowance_private.protect_payroll_publication();
create trigger immutable_common_payroll_receipt before update or delete on company_common_allowance_private.payroll_publication_receipts
 for each row execute function company_common_allowance_private.protect_payroll_publication();

create or replace function payroll_unit_private.resolve_company_common(cid uuid,wid uuid,p_start date,p_end date)
returns jsonb language plpgsql stable security definer set search_path='' as $$
declare item jsonb; publication company_common_allowance_private.payroll_publications%rowtype;
 typ text;quantity numeric;amount numeric;rows jsonb:='[]';earnings jsonb:='[]';deductions jsonb:='[]';blocked boolean:=false;
begin
 if p_start is null or p_end is null or p_start<>date_trunc('month',p_start)::date
 or p_end<>(p_start+interval '1 month - 1 day')::date then
  raise exception 'canonical payroll month required' using errcode='22023';end if;
 if not exists(select 1 from company_common_allowance_private.payroll_activation a where a.company_id=cid and a.starts_on<=p_start) then
  return jsonb_build_object('items',rows,'earnings',earnings,'deductions',deductions,'blocked',false,'history_missing',false);end if;
 select s.pay_type into typ from public.worker_payroll_settings s join public.workers w on w.company_id=s.company_id and w.id=s.worker_id where s.company_id=cid and s.worker_id=wid;
 select * into publication from company_common_allowance_private.payroll_publications p
  where p.company_id=cid and p.payroll_type=typ and p.starts_on<=p_start order by p.starts_on desc,p.version desc limit 1;
 if not found then
  return jsonb_build_object('items',rows,'earnings',earnings,'deductions',deductions,'blocked',true,'history_missing',true);end if;
 for item in select value from jsonb_array_elements(publication.items) loop
  quantity:=null;amount:=null;
  if item->>'unit'='month' then quantity:=1;
  elsif item->>'unit'='day' then
   select count(distinct ae.work_date) into quantity from public.attendance_entries ae
    where ae.company_id=cid and ae.worker_id=wid and ae.work_date between p_start and p_end
     and ae.work_date<=(current_timestamp at time zone 'Asia/Tokyo')::date and ae.base_man_days>0;
  elsif item->>'unit'='hour' then
   select q.hours into quantity from payroll_unit_private.quantities q
    where q.company_id=cid and q.worker_id=wid and q.item_id=(item->>'id')::uuid and q.month=p_start;
  end if;
  if quantity is null then blocked:=true;
  else
   amount:=round((item->>'amount_yen')::numeric*quantity);
   if amount>2147483647 then raise exception 'company common amount exceeds range' using errcode='22023';end if;
   if item->>'section'='earning' then earnings:=earnings||jsonb_build_array(jsonb_build_object('name',item->>'name','amount_yen',amount));
   else deductions:=deductions||jsonb_build_array(jsonb_build_object('name',item->>'name','amount_yen',amount));end if;
  end if;
  rows:=rows||jsonb_build_array(jsonb_build_object('id',item->>'id','origin','company_common',
   'payroll_type',typ,'section',item->>'section','unit',item->>'unit','name',item->>'name',
   'rate_yen',item->'amount_yen','quantity',quantity,'quantity_month',p_start,'amount_yen',amount,
   'publication_version',publication.version,'starts_on',publication.starts_on));
 end loop;
 return jsonb_build_object('items',rows,'earnings',earnings,'deductions',deductions,'blocked',blocked,
  'history_missing',false,'publication_version',publication.version,'starts_on',publication.starts_on);
end $$;

create or replace function payroll_unit_private.common_state(cid uuid,wid uuid,p_month date)
returns jsonb language plpgsql stable security definer set search_path='' as $$
declare result jsonb;typ text;activation date;frozen public.payroll_statements%rowtype;items jsonb;
begin
 select * into frozen from public.payroll_statements ps where ps.company_id=cid and ps.worker_id=wid and ps.period_start=p_month
  and (ps.workflow_state is distinct from 'draft' or ps.automatic_calculation is distinct from true) limit 1;
 if found then
  select coalesce(jsonb_agg(i order by ord),'[]') into items from jsonb_array_elements(coalesce(frozen.detail#>'{unit_resolution,items}','[]')) with ordinality e(i,ord)
   where i->>'origin'='company_common';
  return jsonb_build_object('contract_version',1,'items',items,'history_missing',false,'frozen',true,
   'source',jsonb_build_object('statement_id',frozen.id,'statement_revision',frozen.revision,'items',items));
 end if;
 result:=payroll_unit_private.resolve_company_common(cid,wid,p_month,(p_month+interval '1 month - 1 day')::date);
 select pay_type into typ from public.worker_payroll_settings where company_id=cid and worker_id=wid;
 select starts_on into activation from company_common_allowance_private.payroll_activation where company_id=cid;
 return jsonb_build_object('contract_version',1,'items',result->'items','history_missing',result->'history_missing','frozen',false,'source',
  jsonb_build_object('starts_on',activation,'pay_type',typ,'items',result->'items','publication_version',result->'publication_version'));
end $$;
create or replace function payroll_unit_private.augment_settings(cid uuid,wid uuid,p_start date,p_end date,settings jsonb)
returns jsonb language plpgsql stable security definer set search_path='' as $$
declare resolved jsonb;common_items jsonb;
begin
 resolved:=payroll_unit_private.resolve(cid,wid,p_start,p_end);
 common_items:=payroll_unit_private.resolve_company_common(cid,wid,p_start,p_end);
 resolved:=resolved||jsonb_build_object('items',(resolved->'items')||(common_items->'items'),
  'earnings',(resolved->'earnings')||(common_items->'earnings'),'deductions',(resolved->'deductions')||(common_items->'deductions'),
  'blocked',(resolved->>'blocked')::boolean or (common_items->>'blocked')::boolean,
  'company_common_history_missing',common_items->'history_missing');
 if resolved->'items'='[]'::jsonb and (resolved->>'blocked')::boolean is not true then return settings;end if;
 return coalesce(settings,'{}')||jsonb_build_object('custom_earnings',coalesce(settings->'custom_earnings','[]')||(resolved->'earnings'),
 'custom_deductions',coalesce(settings->'custom_deductions','[]')||(resolved->'deductions'),'_unit_resolution',resolved);
end $$;

create function company_common_allowance_private.read_payroll_publications(cid uuid)
returns jsonb language plpgsql stable security definer set search_path='' as $$
declare entries jsonb;editable boolean;
begin
 editable:=company_common_allowance_private.authorize(cid,false);
 select coalesce(jsonb_agg(jsonb_build_object('version',p.version,'payroll_type',p.payroll_type,'starts_on',p.starts_on,
  'common_version',p.common_version,'request_id',p.request_id,'published_at',p.published_at) order by p.version desc),'[]') into entries
  from (select * from company_common_allowance_private.payroll_publications where company_id=cid order by version desc limit 100) p;
 return jsonb_build_object('contract_version',1,'company_id',cid,'can_edit',editable,
  'timeline_version',coalesce((select max(version) from company_common_allowance_private.payroll_publications where company_id=cid),0),
  'common_version',coalesce((select version from company_common_allowance_private.state where company_id=cid),0),
  'common_source',company_common_allowance_private.source(cid),'entries',entries);
end $$;

create function company_common_allowance_private.publish_payroll(cid uuid,typ text,p_start date,p_common_version bigint,
 p_common_source jsonb,p_timeline_version bigint,rid uuid)
returns jsonb language plpgsql security definer set search_path='' as $$
declare current_version bigint;common_version bigint;payload jsonb;snapshot jsonb;next_start date;
 receipt company_common_allowance_private.payroll_publication_receipts%rowtype;scope record;affected int:=0;result jsonb;
begin
 perform company_common_allowance_private.lock_writer(cid);
 if typ is null or typ not in ('daily','hourly','monthly') or p_start is null or p_start<>date_trunc('month',p_start)::date
 or rid is null or p_common_version is null or p_timeline_version is null then
  raise exception 'invalid payroll publication request' using errcode='22023';end if;
 payload:=jsonb_build_object('payroll_type',typ,'starts_on',p_start,'common_version',p_common_version,'common_source',p_common_source,'timeline_version',p_timeline_version);
 select * into receipt from company_common_allowance_private.payroll_publication_receipts where company_id=cid and request_id=rid;
 if found then
  if receipt.actor_id is distinct from auth.uid() or receipt.payload is distinct from payload then
   raise exception 'payroll publication request mismatch' using errcode='22023';end if;
  return receipt.result;
 end if;
 if p_start<date_trunc('month',current_timestamp at time zone 'Asia/Tokyo')::date then
  raise exception 'past payroll publication requires separate review' using errcode='22023';end if;
 if not exists(select 1 from company_common_allowance_private.payroll_activation where company_id=cid and starts_on<=p_start) then
  raise exception 'company payroll activation is not configured' using errcode='55000';end if;
 select coalesce(max(version),0) into current_version from company_common_allowance_private.payroll_publications where company_id=cid;
 select coalesce((select version from company_common_allowance_private.state where company_id=cid),0) into common_version;
 if current_version<>p_timeline_version or common_version<>p_common_version
 or p_common_source is distinct from company_common_allowance_private.source(cid) then
  raise exception 'payroll publication source conflict' using errcode='40001';end if;
 if current_version>=9007199254740991 then raise exception 'payroll publication version exceeds range' using errcode='22023';end if;
 snapshot:=company_common_allowance_private.active_items(cid,typ);
 insert into company_common_allowance_private.payroll_publications(company_id,version,payroll_type,starts_on,common_version,items,request_id,actor_id)
 values(cid,current_version+1,typ,p_start,common_version,snapshot,rid,auth.uid());
 select min(starts_on) into next_start from company_common_allowance_private.payroll_publications
  where company_id=cid and payroll_type=typ and starts_on>p_start;
 -- Established company -> worker -> month ordering. Only editable automatic drafts.
 for scope in
  select x.worker_id,x.period_start from (
   select ps.worker_id,ps.period_start from public.payroll_statements ps join public.worker_payroll_settings s on s.company_id=ps.company_id and s.worker_id=ps.worker_id
    where ps.company_id=cid and s.pay_type=typ and ps.automatic_calculation is true and ps.workflow_state='draft'
     and ps.period_start>=p_start and (next_start is null or ps.period_start<next_start)
   union
   select s.worker_id,p_start from public.worker_payroll_settings s where s.company_id=cid and s.pay_type=typ
    and p_start=date_trunc('month',current_timestamp at time zone 'Asia/Tokyo')::date
    and not exists(select 1 from public.payroll_statements ps where ps.company_id=cid and ps.worker_id=s.worker_id and ps.period_start=p_start
      and (ps.automatic_calculation is distinct from true or ps.workflow_state is distinct from 'draft'))
  ) x order by x.worker_id,x.period_start loop
  perform payroll_scope_private.lock_scopes(jsonb_build_array(jsonb_build_object('cid',cid,'wid',scope.worker_id,'day',scope.period_start)));
  perform private.refresh_automatic_payroll(cid,scope.worker_id,scope.period_start);
  perform private.sync_payroll_attendance_detail(cid,scope.worker_id,scope.period_start);
  affected:=affected+1;
 end loop;
 perform company_common_allowance_private.authorize(cid,true);
 result:=jsonb_build_object('contract_version',1,'company_id',cid,'request_id',rid,'publication_version',current_version+1,
  'starts_on',p_start,'payroll_type',typ,'recalculated_scopes',affected,'timeline',company_common_allowance_private.read_payroll_publications(cid));
 insert into company_common_allowance_private.payroll_publication_receipts values(cid,rid,auth.uid(),payload,result);
 return result;
end $$;
revoke all on function company_common_allowance_private.read_payroll_publications(uuid),company_common_allowance_private.publish_payroll(uuid,text,date,bigint,jsonb,bigint,uuid) from public,anon,authenticated,service_role;
grant execute on function company_common_allowance_private.read_payroll_publications(uuid),company_common_allowance_private.publish_payroll(uuid,text,date,bigint,jsonb,bigint,uuid) to authenticated;
create function public.read_company_common_payroll_publications(p_company_id uuid) returns jsonb
language sql stable security invoker set search_path='' as $$select company_common_allowance_private.read_payroll_publications(p_company_id)$$;
create function public.publish_company_common_payroll(p_company_id uuid,p_payroll_type text,p_starts_on date,p_common_version bigint,p_common_source jsonb,p_timeline_version bigint,p_request_id uuid) returns jsonb
language sql security invoker set search_path='' as $$select company_common_allowance_private.publish_payroll(p_company_id,p_payroll_type,p_starts_on,p_common_version,p_common_source,p_timeline_version,p_request_id)$$;
revoke all on function public.read_company_common_payroll_publications(uuid),public.publish_company_common_payroll(uuid,text,date,bigint,jsonb,bigint,uuid) from public,anon,service_role;
grant execute on function public.read_company_common_payroll_publications(uuid),public.publish_company_common_payroll(uuid,text,date,bigint,jsonb,bigint,uuid) to authenticated;
commit;
