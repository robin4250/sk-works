-- REVIEW ONLY: separate administrator-own correction purpose; initial OFF.
-- Not an approval endpoint. Existing employee requests/other-actor approvals
-- are neither modified nor reused as self-approval. No object bytes are written.
begin;
do $$begin
 if to_regprocedure('public.worker_document_admin_self_correction(text,jsonb)') is not null
 or to_regclass('private.worker_document_admin_corrections') is not null
 or to_regprocedure('private.require_reauthentication_session()') is null
 or to_regprocedure('private.has_company_feature(uuid,text)') is null
 or to_regprocedure('private.worker_document_photos_are_retained(text)') is null
 then raise exception 'administrator correction prerequisites require review' using errcode='55000';end if;
end$$;

create table private.worker_document_admin_correction_state(
 singleton boolean primary key default true check(singleton),enabled boolean not null default false);
insert into private.worker_document_admin_correction_state values(true,false);
create table private.worker_document_admin_corrections(
 request_id uuid primary key,company_id uuid not null,actor_id uuid not null,
 target_id uuid not null,worker_id uuid not null,requirement_id uuid not null,
 session_id uuid not null,state text not null check(state in('applied','cancelled')),
 command_sha256 text,reason text,before_snapshot jsonb,after_snapshot jsonb,
 recorded_at timestamptz not null default clock_timestamp(),
 check((state='applied' and command_sha256 is not null and length(reason) between 1 and 1000
  and before_snapshot is not null and after_snapshot is not null)
  or(state='cancelled' and command_sha256 is null and reason is null
  and before_snapshot is null and after_snapshot is null)));
create table private.worker_document_admin_correction_tickets(
 target_id uuid primary key,request_id uuid unique not null,actor_id uuid not null,
 session_id uuid not null,tx_id bigint not null,before_snapshot jsonb not null,expected_after jsonb not null);
create table private.worker_document_admin_correction_photos(
 request_id uuid not null,path text not null,object_id uuid not null,
 primary key(request_id,path));
alter table private.worker_document_admin_correction_state enable row level security;
alter table private.worker_document_admin_corrections enable row level security;
alter table private.worker_document_admin_correction_tickets enable row level security;
alter table private.worker_document_admin_correction_photos enable row level security;
revoke all on private.worker_document_admin_correction_state,private.worker_document_admin_corrections,
 private.worker_document_admin_correction_tickets,private.worker_document_admin_correction_photos
 from public,anon,authenticated,service_role;

create function private.worker_document_admin_correction_immutable() returns trigger
language plpgsql security definer set search_path='' as $$begin
 raise exception 'administrator revision archive is append only' using errcode='42501';end$$;
revoke all on function private.worker_document_admin_correction_immutable() from public,anon,authenticated,service_role;
create trigger worker_document_admin_correction_immutable before update or delete
 on private.worker_document_admin_corrections for each row execute function private.worker_document_admin_correction_immutable();
create trigger worker_document_admin_correction_photos_immutable before update or delete
 on private.worker_document_admin_correction_photos for each row execute function private.worker_document_admin_correction_immutable();

create function private.worker_document_admin_correction_retains(p_path text) returns boolean
language sql stable security definer set search_path='' as $$
 select exists(select 1 from private.worker_document_admin_correction_photos where path=p_path);
$$;
revoke all on function private.worker_document_admin_correction_retains(text) from public,anon,service_role;
grant execute on function private.worker_document_admin_correction_retains(text) to authenticated;
-- Additional restrictions only: no upload/read/UPDATE/DELETE grant is added.
create policy worker_document_admin_archive_no_overwrite on storage.objects
 as restrictive for update to authenticated
 using(bucket_id<>'worker-documents' or not private.worker_document_admin_correction_retains(name))
 with check(bucket_id<>'worker-documents' or not private.worker_document_admin_correction_retains(name));
create policy worker_document_admin_archive_no_delete on storage.objects
 as restrictive for delete to authenticated
 using(bucket_id<>'worker-documents' or not private.worker_document_admin_correction_retains(name));

create function private.worker_document_admin_correction_ticket_guard() returns trigger
language plpgsql security definer set search_path='' as $$
declare t private.worker_document_admin_correction_tickets%rowtype;
begin
 select * into t from private.worker_document_admin_correction_tickets where target_id=old.id for update;
 if not found then return new;end if;
 if t.actor_id is distinct from auth.uid() or t.session_id is distinct from private.require_reauthentication_session()
 or t.tx_id is distinct from txid_current() or t.before_snapshot is distinct from to_jsonb(old)
 or (t.expected_after-'updated_at') is distinct from(to_jsonb(new)-'updated_at')
 then raise exception 'administrator correction ticket mismatch' using errcode='42501';end if;
 delete from private.worker_document_admin_correction_tickets where target_id=old.id;
 return new;
end$$;
revoke all on function private.worker_document_admin_correction_ticket_guard() from public,anon,authenticated,service_role;
create trigger zzz_worker_document_admin_correction_ticket before update on public.worker_document_statuses
 for each row execute function private.worker_document_admin_correction_ticket_guard();

create function public.worker_document_admin_self_correction(p_action text,p_data jsonb default '{}'::jsonb)
returns jsonb language plpgsql security definer set search_path='' as $$
declare actor uuid:=auth.uid();sid uuid;cid uuid;wid uuid;rid uuid;target uuid;request uuid;
 oldrow jsonb;newrow jsonb;expected jsonb;patch jsonb;paths text[];oldpaths text[];p text;oid uuid;
 enabled boolean;conflict boolean;digest text;reason text;receipt jsonb;
 saved private.worker_document_admin_corrections%rowtype;
begin
 sid:=private.require_reauthentication_session();
 if jsonb_typeof(p_data) is distinct from 'object' then raise exception 'object required' using errcode='22023';end if;
 cid:=(p_data->>'company_id')::uuid;target:=(p_data->>'target_id')::uuid;
 if cid is null or target is null then raise exception 'exact company and target required' using errcode='22023';end if;
 perform 1 from public.company_members where company_id=cid and user_id=actor
  and role::text in('owner','admin','manager') for share;
 if not found then raise exception 'administrator required' using errcode='42501';end if;
 perform 1 from public.member_feature_permissions where company_id=cid and user_id=actor for share;
 if private.has_company_feature(cid,'can_manage_people') is not true then
  raise exception 'people permission required' using errcode='42501';end if;
 if p_action<>'capability' then
  request:=(p_data->>'request_id')::uuid;
  if request is null then raise exception 'fixed request ID required' using errcode='22023';end if;
  perform pg_advisory_xact_lock(hashtextextended('worker-document-admin-correction:'||request::text,0));
  select * into saved from private.worker_document_admin_corrections where request_id=request;
  if found and(saved.company_id is distinct from cid or saved.actor_id is distinct from actor
   or saved.target_id is distinct from target)
  then raise exception 'request identity conflict' using errcode='23505';end if;
 end if;
 -- A committed opaque receipt remains recoverable after the status row is
 -- legitimately removed; its exact archived worker/company still require
 -- current administrator authority and an own active worker.
 if saved.request_id is not null then wid:=saved.worker_id;rid:=saved.requirement_id;
 else
  select s.worker_id,s.requirement_id into wid,rid from public.worker_document_statuses s
   where s.id=target and s.company_id=cid;
 end if;
 perform 1 from public.workers where id=wid and company_id=cid and user_id=actor and status::text='active' for share;
 if not found then raise exception 'own active worker required' using errcode='42501';end if;
 perform 1 from public.document_requirements where id=rid and company_id=cid for share;
 if not found then raise exception 'current document requirement required' using errcode='42501';end if;
 select s.enabled into enabled from private.worker_document_admin_correction_state s where singleton for share;
 if p_action='capability' then
  if (select count(*) from jsonb_object_keys(p_data))<>2 then raise exception 'unexpected capability fields' using errcode='22023';end if;
  return jsonb_build_object('version',1,'contract','worker_document_admin_self_correction','company_id',cid,
   'target_id',target,'actor_id',actor,'available',enabled is true,'new_upload_available',false,'max_photos',20);
 end if;
 if p_action in('get','reconcile_cancel') then
  if (select count(*) from jsonb_object_keys(p_data))<>3 then raise exception 'ID-only recovery required' using errcode='22023';end if;
  if saved.request_id is null and p_action='get' then
   return jsonb_build_object('version',1,'contract','worker_document_admin_self_correction','request_id',request,
    'company_id',cid,'target_id',target,'actor_id',actor,'status','unknown');
  end if;
  if saved.request_id is null then
   insert into private.worker_document_admin_corrections(request_id,company_id,actor_id,target_id,worker_id,requirement_id,session_id,state)
    values(request,cid,actor,target,wid,rid,sid,'cancelled') returning * into saved;
  end if;
 elsif p_action='correct' then
  if enabled is not true then raise exception 'administrator correction stopped' using errcode='55000';end if;
  if (select count(*) from jsonb_object_keys(p_data))<>6 or not(p_data ?& array['company_id','target_id','request_id','expected_snapshot','fields','reason'])
  then raise exception 'exact correction fields required' using errcode='22023';end if;
  expected:=p_data->'expected_snapshot';patch:=p_data->'fields';reason:=p_data->>'reason';
  if jsonb_typeof(p_data->'reason') is distinct from 'string' or reason is distinct from btrim(reason)
   or length(reason) not between 1 and 1000 or jsonb_typeof(expected) is distinct from 'object'
   or jsonb_typeof(patch) is distinct from 'object' or(select count(*) from jsonb_object_keys(patch))<>3
   or not(patch ?& array['attachment_paths','expires_at','notes'])
   or jsonb_typeof(patch->'attachment_paths') is distinct from 'array'
   or jsonb_array_length(patch->'attachment_paths')>20
   or jsonb_typeof(patch->'notes') not in('string','null') or length(patch->>'notes')>4000
   or jsonb_typeof(patch->'expires_at') not in('string','null')
  then raise exception 'reviewed reason and metadata required' using errcode='22023';end if;
  if patch->>'expires_at' is not null and((patch->>'expires_at')!~'^\d{4}-\d{2}-\d{2}$'
   or ((patch->>'expires_at')::date)::text is distinct from patch->>'expires_at')
  then raise exception 'exact expiry date required' using errcode='22023';end if;
  if exists(select 1 from jsonb_array_elements(patch->'attachment_paths') v
   where jsonb_typeof(v) is distinct from 'string' or btrim(v#>>'{}')='' or v#>>'{}' is distinct from btrim(v#>>'{}'))
  then raise exception 'saved photo paths required' using errcode='22023';end if;
  paths:=array(select jsonb_array_elements_text(patch->'attachment_paths'));
  if cardinality(paths)<>(select count(distinct v) from unnest(paths) v) then raise exception 'duplicate photos' using errcode='22023';end if;
  digest:=encode(sha256(convert_to(p_data::text,'UTF8')),'hex');
  if saved.request_id is not null then
   if saved.state<>'applied' or saved.command_sha256 is distinct from digest then raise exception 'request already fixed' using errcode='23505';end if;
  else
   select to_jsonb(s) into oldrow from public.worker_document_statuses s where id=target and company_id=cid for update;
   if oldrow is distinct from expected then raise exception 'document changed; reload' using errcode='40001';end if;
   -- Do not take old-request row locks after the target lock: legacy approval
   -- locks in the opposite order. Its prepare serializes on this target/CAS.
   if to_regclass('private.worker_document_changes') is not null then
    execute 'select exists(select 1 from private.worker_document_changes where target_id=$1 and status in(''draft'',''pending''))'
     into conflict using target;
    if conflict then raise exception 'personal change request unresolved' using errcode='55000';end if;
   end if;
   oldpaths:=coalesce(array(select jsonb_array_elements_text(oldrow->'attachment_paths')),'{}'::text[]);
   if cardinality(oldpaths)=0 and oldrow->>'attachment_path' is not null then oldpaths:=array[oldrow->>'attachment_path'];end if;
   foreach p in array paths loop
    if not(p=any(oldpaths)) then raise exception 'new photos unavailable' using errcode='22023';end if;
   end loop;
   -- Archive original object identities, including removed photos, without
   -- fetching, changing or copying their bytes. Missing originals stop saving.
   foreach p in array oldpaths loop
    select id into oid from storage.objects where bucket_id='worker-documents' and name=p for share;
    if not found then raise exception 'original object unavailable' using errcode='55000';end if;
    insert into private.worker_document_admin_correction_photos values(request,p,oid);
   end loop;
   newrow:=oldrow||jsonb_build_object('attachment_paths',to_jsonb(paths),'attachment_path',paths[1],
    'expires_at',patch->'expires_at','notes',patch->'notes','status','submitted','original_verified',false,'updated_by',actor);
   insert into private.worker_document_admin_correction_tickets values(target,request,actor,sid,txid_current(),oldrow,newrow);
   update public.worker_document_statuses set attachment_paths=paths,attachment_path=paths[1],
    expires_at=(patch->>'expires_at')::date,notes=patch->>'notes',status='submitted',original_verified=false,
    updated_by=actor,updated_at=clock_timestamp() where id=target and company_id=cid;
   if exists(select 1 from private.worker_document_admin_correction_tickets where target_id=target)
   then raise exception 'correction guard did not consume ticket' using errcode='55000';end if;
   select to_jsonb(s) into newrow from public.worker_document_statuses s where id=target and company_id=cid;
   insert into private.worker_document_admin_corrections(request_id,company_id,actor_id,target_id,worker_id,requirement_id,
    session_id,state,command_sha256,reason,before_snapshot,after_snapshot)
   values(request,cid,actor,target,wid,rid,sid,'applied',digest,reason,oldrow,newrow) returning * into saved;
  end if;
 else raise exception 'unsupported correction action' using errcode='22023';end if;
 return jsonb_build_object('version',1,'contract','worker_document_admin_self_correction','request_id',saved.request_id,
  'company_id',saved.company_id,'target_id',saved.target_id,'actor_id',saved.actor_id,'status',saved.state);
end$$;
revoke all on function public.worker_document_admin_self_correction(text,jsonb) from public,anon,service_role;
grant execute on function public.worker_document_admin_self_correction(text,jsonb) to authenticated;
commit;
