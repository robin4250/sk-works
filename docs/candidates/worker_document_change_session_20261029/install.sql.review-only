-- REVIEW ONLY: no application database/migration use without independent approval.
-- New uploads stay OFF. Only existing saved paths may be reordered/removed.
begin;
-- REVIEW ONLY: new module only; no shared function replacement; no production apply.
do $pin$ declare p record;begin
 for p in select * from (values
 ('private.require_reauthentication_session()','165d0f26da6f6e346bb2766ae70282f7','{postgres=X/postgres}','search_path=""'),
 ('private.has_company_feature(uuid,text)','e669fb9e3fe1af2b73eee1745703b272',null,'search_path=public, private, pg_temp'),
 ('private.account_access_allowed()','313d371759a4de968cfe99db050ee65d','{postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}','search_path=""')
 ) v(signature,hash,acl,config) loop
 if not exists(select 1 from pg_proc f where f.oid=to_regprocedure(p.signature)
  and md5(pg_get_functiondef(f.oid))=p.hash and f.prosecdef
  and pg_get_userbyid(f.proowner)='postgres' and f.proacl::text is not distinct from p.acl
  and f.proconfig=array[p.config]) then
  raise sqlstate '55000' using message='Document prerequisite definition/attributes changed';end if;
 end loop;
 if to_regclass('private.worker_document_change_rollout') is not null then raise sqlstate '55000' using message='Inspect existing module';end if;
end $pin$;
create table private.worker_document_change_rollout(enabled boolean not null default false,singleton boolean primary key default true check(singleton));
insert into private.worker_document_change_rollout values(false,true);
create table private.worker_document_change_events(event_id bigint generated always as identity primary key,request_id uuid not null,actor_id uuid not null,session_id uuid not null,action text not null,created_at timestamptz not null default clock_timestamp());
create table private.worker_document_change_installation(singleton boolean primary key default true check(singleton),catalog jsonb not null);
alter table private.worker_document_change_rollout enable row level security;
alter table private.worker_document_change_events enable row level security;
alter table private.worker_document_change_installation enable row level security;
revoke all on private.worker_document_change_rollout,private.worker_document_change_events,private.worker_document_change_installation from public,anon,authenticated,service_role;
revoke all on sequence private.worker_document_change_events_event_id_seq from public,anon,authenticated,service_role;
create function private.worker_document_change_enabled() returns boolean language sql volatile security definer set search_path='' as $$select coalesce((select enabled from private.worker_document_change_rollout where singleton for share),false)$$;
revoke all on function private.worker_document_change_enabled() from public,anon,authenticated,service_role;

do $guard$ begin
 if to_regclass('public.worker_document_status_history') is null
  or to_regclass('storage.objects') is null
  or to_regclass('public.company_approval_assignees') is null
  or not exists(select 1 from information_schema.columns where table_schema='public'
   and table_name='worker_document_status_history' and column_name='attachment_paths')
  or to_regprocedure('private.account_access_allowed()') is null
  or not exists(select 1 from information_schema.columns where table_schema='public'
   and table_name='worker_document_statuses' and column_name='attachment_paths') then
  raise exception 'Document change prerequisites unavailable';end if;
 if to_regclass('private.worker_document_changes') is not null
  or to_regprocedure('public.worker_document_change(text,jsonb)') is not null then
  raise exception 'Document candidate already exists; inspect rather than replace';end if;
end $guard$;
create table private.worker_document_changes (
 id uuid primary key,company_id uuid not null,worker_id uuid not null,requirement_id uuid not null,
 target_id uuid not null,requested_by uuid not null,created_session_id uuid not null default private.require_reauthentication_session(),
 status text not null default 'draft' check(status in ('draft','pending','approved','rejected','cancelled')),
 previous jsonb not null,proposed jsonb not null,
 created_at timestamptz not null default clock_timestamp(),reviewed_at timestamptz,reviewed_by uuid,reason text
);
create table private.worker_document_apply_tickets (
 target_id uuid primary key,request_id uuid not null,actor_id uuid not null,transaction_id bigint not null,
 previous jsonb not null,next_row jsonb not null,session_id uuid not null default private.require_reauthentication_session()
);
alter table private.worker_document_changes enable row level security;
alter table private.worker_document_apply_tickets enable row level security;
revoke all on private.worker_document_changes,private.worker_document_apply_tickets from public,anon,authenticated;

create function private.worker_document_change_snapshot(p_row jsonb) returns jsonb
language sql immutable set search_path='' as $$
 select jsonb_build_object('id',p_row->'id','company_id',p_row->'company_id',
 'worker_id',p_row->'worker_id','requirement_id',p_row->'requirement_id','status',p_row->'status',
 'expires_at',p_row->'expires_at','original_verified',p_row->'original_verified',
 'attachment_path',p_row->'attachment_path','attachment_paths',p_row->'attachment_paths',
 'notes',p_row->'notes','updated_at',p_row->'updated_at') $$;
revoke all on function private.worker_document_change_snapshot(jsonb) from public,anon,authenticated;
-- Union of existing manager ALL and people-feature ALL policies, with account gate.
create function private.worker_document_change_can_manage(cid uuid) returns boolean
language sql stable security definer set search_path='' as $$
 select auth.uid() is not null and private.account_access_allowed() and (
 private.has_company_feature(cid,'can_manage_people') or exists(
 select 1 from public.company_members m where m.company_id=cid and m.user_id=auth.uid()
 and m.role::text in ('owner','admin','manager'))) $$;
revoke all on function private.worker_document_change_can_manage(uuid) from public,anon,authenticated,service_role;
create function private.worker_document_change_can_review(cid uuid) returns boolean
language sql stable security definer set search_path='' as $$select private.worker_document_change_can_manage(cid)$$;
revoke all on function private.worker_document_change_can_review(uuid) from public,anon,authenticated,service_role;

create function private.worker_document_change_can_access(cid uuid,wid uuid) returns boolean
language sql stable security definer set search_path='' as $$
 select private.account_access_allowed() and exists(select 1 from public.company_members m where m.company_id=cid and m.user_id=auth.uid())
 and (private.worker_document_change_can_manage(cid) or exists(select 1 from public.workers w where w.id=wid and w.company_id=cid and w.user_id=auth.uid())) $$;
revoke all on function private.worker_document_change_can_access(uuid,uuid) from public,anon,authenticated,service_role;

create function private.worker_document_change_guard() returns trigger
language plpgsql security definer set search_path='' as $$
declare before_row jsonb;after_row jsonb;ticket private.worker_document_apply_tickets%rowtype;
 oldpaths text[];newpaths text[];initial_blank boolean;
begin
 -- OFF, INSERT, DELETE and unrelated targets preserve existing product behavior.
 if not private.worker_document_change_enabled() then if tg_op='DELETE' then return old;else return new;end if;end if;
 if tg_op='DELETE' then return old;end if;
 if tg_op='INSERT' then return new;end if;
 if not exists(select 1 from private.worker_document_changes r where r.target_id=old.id and r.status in ('draft','pending')) then return new;end if;
 -- Status/original-only product updates (including own bank synchronization) stay with existing RLS.
 if (to_jsonb(new)-array['status','original_verified','updated_at','updated_by'])=
    (to_jsonb(old)-array['status','original_verified','updated_at','updated_by']) then return new;end if;
 perform private.require_reauthentication_session();
 if auth.uid() is null or not coalesce(private.account_access_allowed(),false) then
  raise exception 'Document actor unavailable' using errcode='42501';end if;

 if new.updated_by is distinct from auth.uid() then raise exception 'Document updater mismatch' using errcode='42501';end if;
 if tg_op='INSERT' then
  if (new.original_verified or new.status='verified') and not private.worker_document_change_can_manage(new.company_id) then
   raise exception 'Manager verification required' using errcode='42501';end if;
  return new;
 end if; -- Existing initial INSERT/RLS/storage gates remain authoritative.
 if (new.id,new.company_id,new.worker_id,new.requirement_id) is distinct from
    (old.id,old.company_id,old.worker_id,old.requirement_id) then
  raise exception 'Document identity cannot change' using errcode='42501';end if;
 before_row:=private.worker_document_change_snapshot(to_jsonb(old));
 after_row:=private.worker_document_change_snapshot(to_jsonb(new));
 select * into ticket from private.worker_document_apply_tickets where target_id=old.id;
 if found and ticket.actor_id=auth.uid() and ticket.transaction_id=txid_current()
  and ticket.session_id=private.require_reauthentication_session()
  and ticket.previous=before_row and ticket.next_row=after_row
  and exists(select 1 from private.worker_document_changes r where r.id=ticket.request_id
   and r.target_id=old.id and r.status='pending' and r.requested_by<>auth.uid()
   and private.worker_document_change_can_review(r.company_id)) then
  delete from private.worker_document_apply_tickets where target_id=old.id;
  return new;
 end if;
 if (new.status,new.original_verified) is distinct from (old.status,old.original_verified)
  and (new.original_verified or new.status='verified') and not private.worker_document_change_can_manage(new.company_id) then
  raise exception 'Manager verification required' using errcode='42501';end if;
 oldpaths:=case when cardinality(old.attachment_paths)>0 then old.attachment_paths
  when old.attachment_path is not null then array[old.attachment_path] else '{}'::text[] end;
 newpaths:=case when cardinality(new.attachment_paths)>0 then new.attachment_paths
  when new.attachment_path is not null then array[new.attachment_path] else '{}'::text[] end;
 -- Verification-only manager actions and legacy canonicalization preserve content.
 if (to_jsonb(new)-array['status','original_verified','updated_at','updated_by','attachment_path','attachment_paths'])=
    (to_jsonb(old)-array['status','original_verified','updated_at','updated_by','attachment_path','attachment_paths'])
  and oldpaths=newpaths then
  if (new.status,new.original_verified) is distinct from (old.status,old.original_verified)
   and not private.worker_document_change_can_manage(old.company_id) then
   raise exception 'Manager verification required' using errcode='42501';end if;
  return new;
 end if;
 -- First-save exception needs positive INSERT history, not just an empty current row.
 initial_blank:=old.status in ('not_submitted','missing') and not old.original_verified
  and cardinality(oldpaths)=0 and old.expires_at is null and nullif(btrim(old.notes),'') is null
  and exists(select 1 from public.worker_document_status_history h where h.source_status_id=old.id
   and h.company_id=old.company_id and h.worker_id=old.worker_id and h.requirement_id=old.requirement_id
   and h.operation='insert')
  and not exists(select 1 from public.worker_document_status_history h where
   h.company_id=old.company_id and h.worker_id=old.worker_id and h.requirement_id=old.requirement_id and
   (h.status not in ('not_submitted','missing') or h.original_verified or h.expires_at is not null
    or nullif(btrim(h.notes),'') is not null or h.attachment_path is not null or cardinality(h.attachment_paths)>0));
 if initial_blank then return new;end if;
 raise exception 'Saved document content requires an approved change request' using errcode='42501';
end $$;
revoke all on function private.worker_document_change_guard() from public,anon,authenticated;
-- Runs after existing normalize_* and baseline BEFORE triggers, without replacing them.
create trigger zz_worker_document_change_guard before insert or update or delete on public.worker_document_statuses
for each row execute function private.worker_document_change_guard();

create function private.worker_document_change_result(r private.worker_document_changes) returns jsonb
language sql stable security definer set search_path='' as $$
 select jsonb_build_object('version',1,'id',r.id,'company_id',r.company_id,'worker_id',r.worker_id,
 'requirement_id',r.requirement_id,'target_id',r.target_id,'requested_by',r.requested_by,'status',r.status,
 'previous',r.previous,'proposed',r.proposed,'created_at',r.created_at,'reviewed_at',r.reviewed_at,'reason',r.reason,
 'can_review',r.requested_by<>auth.uid() and private.worker_document_change_can_review(r.company_id)) $$;
revoke all on function private.worker_document_change_result(private.worker_document_changes) from public,anon,authenticated;

create function private.worker_document_change(p_action text,p_data jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare r private.worker_document_changes%rowtype;official public.worker_document_statuses%rowtype;
 previous jsonb;proposed jsonb;next_row jsonb;paths text[];oldpaths text[];path text;
 actor uuid:=auth.uid();rid uuid;stamp timestamptz;can_manage boolean;can_review boolean;can_own boolean;
begin
 perform private.require_reauthentication_session();
 if not private.worker_document_change_enabled() then raise sqlstate '42501' using message='Document change unavailable';end if;
 -- Serialize permission changes and scope changes through the operation commit.
 perform 1 from public.company_members where user_id=actor for share;
 perform 1 from public.member_feature_permissions where user_id=actor for share;
 if actor is null or not coalesce(private.account_access_allowed(),false) or jsonb_typeof(p_data) is distinct from 'object' then
  raise exception 'Document change unavailable' using errcode='42501';end if;
 if p_action='capability' then return jsonb_build_object('version',1,'change_requests_available',true,
  'new_upload_available',false,'max_photos',20,'self_approval_allowed',false);end if;
 if p_action='list' then
  return coalesce((select jsonb_agg(private.worker_document_change_result(x) order by x.created_at desc,x.id)
   from private.worker_document_changes x where exists(select 1 from public.company_members m join public.companies c on c.id=m.company_id
    where m.company_id=x.company_id and m.user_id=actor) and
    (private.worker_document_change_can_access(x.company_id,x.worker_id) and (x.requested_by=actor or private.worker_document_change_can_manage(x.company_id)))),'[]');
 end if;
 rid:=(p_data->>'request_id')::uuid;
 if rid is null then raise exception 'Request ID required' using errcode='22023';end if;
 if p_action='prepare' then
  select * into official from public.worker_document_statuses where id=(p_data->>'status_id')::uuid for update;
  if not found then raise exception 'Document unavailable' using errcode='42501';end if;
  can_manage:=private.worker_document_change_can_manage(official.company_id);
  can_own:=exists(select 1 from public.workers w join public.company_members m on m.company_id=w.company_id
   join public.companies c on c.id=w.company_id where w.id=official.worker_id and w.company_id=official.company_id
    and w.user_id=actor and m.user_id=actor);
  perform 1 from public.workers where id=official.worker_id and company_id=official.company_id and status='active' for share;
  if not found then raise sqlstate '42501' using message='Document worker unavailable';end if;
  perform 1 from public.document_requirements where id=official.requirement_id and company_id=official.company_id and is_active for share;
  if not found then raise sqlstate '42501' using message='Document requirement unavailable';end if;
  if not(can_manage or can_own) or not exists(select 1 from public.document_requirements d
    where d.id=official.requirement_id and d.company_id=official.company_id and d.is_active) then
   raise exception 'Document access unavailable' using errcode='42501';end if;
  proposed:=p_data->'proposed';
  if jsonb_typeof(proposed) is distinct from 'object' or proposed-array['attachment_paths','expires_at','notes']<>'{}'::jsonb
   or not(proposed ?& array['attachment_paths','expires_at','notes']) or jsonb_typeof(proposed->'attachment_paths')<>'array'
   or jsonb_array_length(proposed->'attachment_paths')>20
   or (proposed->>'expires_at' is not null and
    (proposed->>'expires_at' !~ '^\d{4}-\d{2}-\d{2}$' or to_char((proposed->>'expires_at')::date,'YYYY-MM-DD')<>proposed->>'expires_at'))
   or (proposed->'notes'<>'null'::jsonb and (jsonb_typeof(proposed->'notes')<>'string'
    or length(proposed->>'notes')>4000 or nullif(btrim(proposed->>'notes'),'') is distinct from proposed->>'notes')) then
   raise exception 'Invalid document proposal' using errcode='22023';end if;
  paths:=array(select jsonb_array_elements_text(proposed->'attachment_paths'));
  if exists(select 1 from jsonb_array_elements(proposed->'attachment_paths') x where jsonb_typeof(x)<>'string')
   or cardinality(paths)<>(select count(distinct p) from unnest(paths) p) then
   raise exception 'Invalid document photos' using errcode='22023';end if;
  select * into r from private.worker_document_changes where id=rid for update;
  if found then
   if r.requested_by is distinct from actor or r.target_id is distinct from official.id or r.proposed is distinct from proposed
    or (r.previous->>'updated_at')::timestamptz is distinct from (p_data->>'expected_updated_at')::timestamptz then
    raise exception 'Fixed document request differs' using errcode='23505';end if;
   return private.worker_document_change_result(r);
  end if;
  if official.updated_at is distinct from (p_data->>'expected_updated_at')::timestamptz then
   raise exception 'Document changed; reload' using errcode='40001';end if;
  oldpaths:=case when cardinality(official.attachment_paths)>0 then official.attachment_paths
   when official.attachment_path is not null then array[official.attachment_path] else '{}'::text[] end;
  foreach path in array paths loop
   if path is null or not(path=any(oldpaths)) then raise exception 'New document uploads are unavailable' using errcode='22023';end if;
  end loop;
  insert into private.worker_document_changes(id,company_id,worker_id,requirement_id,target_id,requested_by,previous,proposed)
   values(rid,official.company_id,official.worker_id,official.requirement_id,official.id,actor,
    private.worker_document_change_snapshot(to_jsonb(official)),proposed) returning * into r;
  return private.worker_document_change_result(r);
 end if;
 select * into r from private.worker_document_changes where id=rid for update;
 if not found or not exists(select 1 from public.company_members m join public.companies c on c.id=m.company_id
  where m.company_id=r.company_id and m.user_id=actor) then raise exception 'Request unavailable' using errcode='42501';end if;
 if p_action<>'detail' then
  perform 1 from public.workers where id=r.worker_id and company_id=r.company_id and status='active' for share;
  if not found then raise sqlstate '42501' using message='Document worker unavailable';end if;
  perform 1 from public.document_requirements where id=r.requirement_id and company_id=r.company_id and is_active for share;
  if not found then raise sqlstate '42501' using message='Document requirement unavailable';end if;
 end if;
 can_manage:=private.worker_document_change_can_manage(r.company_id);
 can_review:=private.worker_document_change_can_review(r.company_id) and r.requested_by<>actor;
 if not private.worker_document_change_can_access(r.company_id,r.worker_id) or (r.requested_by<>actor and not can_manage and not can_review) then raise exception 'Request unavailable' using errcode='42501';end if;
 if p_action='detail' then return private.worker_document_change_result(r);end if;
 if p_action='cancel' then
  if r.requested_by<>actor or r.status not in ('draft','cancelled') then raise exception 'Only own draft can be cancelled' using errcode='42501';end if;
  update private.worker_document_changes set status='cancelled' where id=rid returning * into r;
  return private.worker_document_change_result(r);
 end if;
 if p_action='submit' and r.requested_by=actor and r.status in ('pending','approved') then return private.worker_document_change_result(r);end if;
 if p_action='approve' and can_review and r.status='approved' then return private.worker_document_change_result(r);end if;
 if p_action='reject' and can_review and r.status='rejected' and r.reason is not distinct from nullif(btrim(p_data->>'reason'),'') then return private.worker_document_change_result(r);end if;
 if (p_action='submit' and (r.requested_by<>actor or r.status<>'draft')) or
    (p_action in ('approve','reject') and (not can_review or r.status<>'pending')) or
    p_action not in ('submit','approve','reject') then raise exception 'Request action unavailable' using errcode='42501';end if;
 select * into official from public.worker_document_statuses where id=r.target_id and company_id=r.company_id for update;
 if not found or private.worker_document_change_snapshot(to_jsonb(official)) is distinct from r.previous then
  raise exception 'Official document changed; prepare again' using errcode='40001';end if;
 perform 1 from public.workers where id=r.worker_id and company_id=r.company_id and status='active' for share;
 if not found then raise sqlstate '42501' using message='Document worker unavailable';end if;
 perform 1 from public.document_requirements where id=r.requirement_id and company_id=r.company_id and is_active for share;
 if not found then raise sqlstate '42501' using message='Document requirement unavailable';end if;
 perform 1 from public.company_members where company_id=r.company_id and user_id=r.requested_by for share;
 perform 1 from public.member_feature_permissions where company_id=r.company_id and user_id=r.requested_by for share;
 if not exists(select 1 from public.workers w where w.id=r.worker_id and w.company_id=r.company_id and w.status='active')
  or not exists(select 1 from public.document_requirements d where d.id=r.requirement_id and d.company_id=r.company_id and d.is_active)
  or not exists(select 1 from public.company_members m where m.company_id=r.company_id and m.user_id=r.requested_by) then
  raise exception 'Document scope changed' using errcode='42501';end if;
 if not exists(select 1 from public.workers w join public.company_members m on m.company_id=w.company_id
  where w.id=r.worker_id and w.company_id=r.company_id and m.user_id=r.requested_by
   and (w.user_id=r.requested_by or m.role::text in ('owner','admin','manager') or exists(select 1 from public.member_feature_permissions p where p.company_id=m.company_id and p.user_id=m.user_id and p.can_manage_people))) then
  raise exception 'Requester document scope changed' using errcode='42501';end if;
 if p_action='submit' then
  update private.worker_document_changes set status='pending' where id=rid returning * into r;
  return private.worker_document_change_result(r);
 end if;
 if p_action='reject' then
  if nullif(btrim(p_data->>'reason'),'') is null then raise exception 'Rejection reason required' using errcode='22023';end if;
  update private.worker_document_changes set status='rejected',reason=btrim(p_data->>'reason'),reviewed_at=clock_timestamp(),reviewed_by=actor
   where id=rid returning * into r;
  return private.worker_document_change_result(r);
 end if;
 paths:=array(select jsonb_array_elements_text(r.proposed->'attachment_paths'));
 foreach path in array paths loop
  if not exists(select 1 from storage.objects o where o.bucket_id='worker-documents' and o.name=path) then
   raise exception 'Saved document attachment unavailable' using errcode='22023';end if;
 end loop;
 stamp:=clock_timestamp();
 next_row:=r.previous||jsonb_build_object('attachment_paths',to_jsonb(paths),'attachment_path',paths[1],
  'expires_at',r.proposed->'expires_at','notes',r.proposed->'notes','updated_at',to_jsonb(stamp));
 insert into private.worker_document_apply_tickets(target_id,request_id,actor_id,transaction_id,previous,next_row)
  values(r.target_id,r.id,actor,txid_current(),r.previous,next_row);
 update public.worker_document_statuses set attachment_paths=paths,attachment_path=paths[1],
  expires_at=(r.proposed->>'expires_at')::date,notes=r.proposed->>'notes',updated_at=stamp,updated_by=actor
  where id=r.target_id and updated_at=(r.previous->>'updated_at')::timestamptz;
 if not found then raise exception 'Document update conflict' using errcode='40001';end if;
 if exists(select 1 from private.worker_document_apply_tickets where target_id=r.target_id) then
  raise exception 'Document guard did not consume ticket';end if;
 update private.worker_document_changes set status='approved',reviewed_at=stamp,reviewed_by=actor where id=rid returning * into r;
 return private.worker_document_change_result(r);
end $$;
revoke all on function private.worker_document_change(text,jsonb) from public,anon;
revoke all on function private.worker_document_change(text,jsonb) from authenticated,service_role;
create function public.worker_document_change(p_action text,p_data jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
 declare result jsonb;sid uuid;begin
 sid:=private.require_reauthentication_session();
 result:=private.worker_document_change(p_action,p_data);
 if p_action in ('prepare','submit','approve','reject','cancel') then
  insert into private.worker_document_change_events(request_id,actor_id,session_id,action)
   values((result->>'id')::uuid,auth.uid(),sid,p_action);
 end if;
 return result;end $$;
revoke all on function public.worker_document_change(text,jsonb) from public,anon;
grant execute on function public.worker_document_change(text,jsonb) to authenticated;
-- No app/service direct access to request/ticket/event/rollout or private dispatcher.
revoke all on private.worker_document_changes,private.worker_document_apply_tickets from service_role;
create function private.worker_document_change_catalog() returns jsonb
language sql stable security definer set search_path='' as $$
 select jsonb_build_object('functions',(select jsonb_agg(jsonb_build_object('signature',p.oid::regprocedure::text,'definition',pg_get_functiondef(p.oid),'owner',pg_get_userbyid(p.proowner),'acl',p.proacl::text,'config',p.proconfig,'definer',p.prosecdef) order by p.oid::regprocedure::text)
 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname in ('private','public') and (p.proname like 'worker_document_change%' or p.oid in('private.require_reauthentication_session()'::regprocedure,'private.has_company_feature(uuid,text)'::regprocedure,'private.account_access_allowed()'::regprocedure))),
 'trigger',(select jsonb_agg(jsonb_build_object('definition',pg_get_triggerdef(t.oid),'enabled',t.tgenabled)) from pg_trigger t where t.tgrelid='public.worker_document_statuses'::regclass and t.tgname='zz_worker_document_change_guard'),
 'tables',(select jsonb_agg(jsonb_build_object('name',c.relname,'owner',pg_get_userbyid(c.relowner),'acl',c.relacl::text,'rls',c.relrowsecurity) order by c.relname) from pg_class c join pg_namespace n on n.oid=c.relnamespace where n.nspname='private' and c.relname in ('worker_document_changes','worker_document_apply_tickets','worker_document_change_events','worker_document_change_rollout','worker_document_change_installation')))
 $$;
revoke all on function private.worker_document_change_catalog() from public,anon,authenticated,service_role;
insert into private.worker_document_change_installation(catalog) select private.worker_document_change_catalog();

commit;
