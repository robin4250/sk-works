-- REVIEW ONLY. Receipt calculator core, not a deployable/full integration unit.
-- Does not enable payroll, alter a writer, copy prices, or compute worked hours.
-- The writer-bound capture and exact source patches must be reviewed together.
create schema company_checkout_allowance_private;
revoke all on schema company_checkout_allowance_private from public,anon,authenticated,service_role;

-- Pure aggregation of SERVER-CAPTURED rows only. This function accepts no client
-- amount as an authorization boundary; its sole owner may call it from the
-- source-bound monthly resolver after reading protected attendance receipts.
create function company_checkout_allowance_private.aggregate(p_receipts jsonb)
returns jsonb language plpgsql immutable security invoker set search_path='' as $aggregate$
declare r jsonb; item jsonb; k text; day_key text; entry jsonb; seen jsonb:='{}';
 rows jsonb:='[]';earnings jsonb:='[]';deductions jsonb:='[]';reasons jsonb:='[]';
 grouped jsonb:='{}'; quantity numeric;amount numeric;rate numeric;
begin
 if jsonb_typeof(p_receipts) is distinct from 'array' or jsonb_array_length(p_receipts)>10000 then
  raise exception 'invalid server receipt set' using errcode='22023';end if;
 for r in select value from jsonb_array_elements(p_receipts) loop
  if jsonb_typeof(r) is distinct from 'object' or r->>'contract_version' is distinct from '1'
   or coalesce(r->>'work_date','')!~'^20[0-9]{2}-[0-9]{2}-[0-9]{2}$'
   or jsonb_typeof(r->'items') is distinct from 'array' then
   raise exception 'invalid server receipt row' using errcode='22023';end if;
  perform (r->>'work_date')::date;
  for item in select value from jsonb_array_elements(r->'items') loop
   if jsonb_typeof(item) is distinct from 'object'
    or coalesce(item->>'origin','') not in ('company_legacy','company_common')
    or coalesce(item->>'id','')!~'^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
    or nullif(trim(item->>'name'),'') is null or length(item->>'name')>4096
    or coalesce(item->>'section','') not in ('earning','deduction') or coalesce(item->>'unit','') not in ('day','hour')
    or jsonb_typeof(item->'rate_yen') is distinct from 'number'
    or (item->>'rate_yen')::numeric<0 or (item->>'rate_yen')::numeric>2147483647
    or trunc((item->>'rate_yen')::numeric)<>(item->>'rate_yen')::numeric then
    raise exception 'invalid server receipt item' using errcode='22023';end if;
   -- ID + source identify an item. Same-day multiple site/route receipts must
   -- agree on the captured registration snapshot; choose no arbitrary winner.
   item:=jsonb_set(item,'{id}',to_jsonb((item->>'id')::uuid::text));
   k:=(item->>'origin')||':'||(item->>'id');day_key:=k||':'||(r->>'work_date');
   if seen?day_key then
    if seen->day_key is distinct from item then
     reasons:=reasons||jsonb_build_array(jsonb_build_object('code','same_day_registration_conflict','id',item->>'id','work_date',r->>'work_date'));
    end if;
    continue;
   end if;
   seen:=jsonb_set(seen,array[day_key],item,true);
   if grouped?k then
    entry:=grouped->k;
    if entry->'snapshot' is distinct from item then
     -- Mid-month configured price/label changes cannot be merged into one
     -- rate row. Keep each exact snapshot as a separate calculation row.
     k:=k||':'||encode(sha256(convert_to(item::text,'UTF8')),'hex');
    end if;
   end if;
   if item->>'unit'='day' then quantity:=1;
   else
    -- No inferred 8h/day, raw elapsed clock span, or monthly manual quantity.
    -- A future reviewed paid-work-hours source must supply this server basis.
    quantity:=null;
    reasons:=reasons||jsonb_build_array(jsonb_build_object('code','actual_work_hours_unavailable','id',item->>'id','work_date',r->>'work_date'));
   end if;
   entry:=coalesce(grouped->k,jsonb_build_object('snapshot',item,'quantity',0,'work_dates','[]'::jsonb));
   entry:=jsonb_set(entry,'{work_dates}',(entry->'work_dates')||jsonb_build_array(r->>'work_date'));
   entry:=jsonb_set(entry,'{quantity}',case when quantity is null or entry->'quantity'='null'::jsonb then 'null'::jsonb else to_jsonb((entry->>'quantity')::numeric+quantity) end);
   grouped:=jsonb_set(grouped,array[k],entry,true);
  end loop;
 end loop;
 for k,entry in select key,value from jsonb_each(grouped) order by key loop
  item:=entry->'snapshot';quantity:=(entry->>'quantity')::numeric;rate:=(item->>'rate_yen')::numeric;
  amount:=case when quantity is null then null else round(rate*quantity) end;
  if amount>2147483647 then raise exception 'company allowance exceeds range' using errcode='22023';end if;
  rows:=rows||jsonb_build_array(item||jsonb_build_object('quantity',quantity,'amount_yen',amount,'work_dates',entry->'work_dates','source','confirmed_checkout_receipt'));
  if amount is not null then
   if item->>'section'='earning' then earnings:=earnings||jsonb_build_array(jsonb_build_object('name',item->>'name','amount_yen',amount));
   else deductions:=deductions||jsonb_build_array(jsonb_build_object('name',item->>'name','amount_yen',amount));end if;
  end if;
 end loop;
 return jsonb_build_object('contract_version',1,'items',rows,'earnings',earnings,'deductions',deductions,'blocked',jsonb_array_length(reasons)>0,'reasons',reasons);
end $aggregate$;
revoke all on function company_checkout_allowance_private.aggregate(jsonb) from public,anon,authenticated,service_role;
