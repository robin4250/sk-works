-- REVIEW ONLY. No production install or Auth configuration change is authorized here.
-- Two additive routines; no table grants, schema USAGE changes or existing routines.
begin;
do $$
begin
 if to_regprocedure('private.account_access_allowed()') is null
 or to_regclass('private.account_deletion_access_restrictions') is null
 or to_regclass('auth.sessions') is null or to_regclass('auth.users') is null then
  raise exception 'primary_password_status_prerequisites_unavailable';
 end if;
 if not exists(select 1 from pg_proc p where p.oid='private.account_access_allowed()'::regprocedure
  and pg_get_userbyid(p.proowner)='postgres' and p.prosecdef and p.provolatile='s'
  and p.proconfig=array['search_path=""']::text[]
  and md5(p.prosrc)='aeca25db212c043c472334026bd98724') then
  raise exception 'primary_password_status_existing_account_guard_changed';
 end if;
 if (select array_agg(pg_get_userbyid(a.grantee)::text order by pg_get_userbyid(a.grantee)::text)
  from pg_proc p cross join lateral aclexplode(p.proacl) a
  where p.oid='private.account_access_allowed()'::regprocedure
  and a.privilege_type='EXECUTE' and a.grantor=(select oid from pg_roles where rolname='postgres')
  and not a.is_grantable) is distinct from array['anon','authenticated','postgres','service_role']::text[]
 or (select count(*) from pg_proc p cross join lateral aclexplode(p.proacl) a
  where p.oid='private.account_access_allowed()'::regprocedure)<>4 then
  raise exception 'primary_password_status_existing_account_guard_acl_changed';
 end if;
 if not has_schema_privilege('authenticated','private','USAGE') then
  raise exception 'primary_password_status_existing_schema_usage_required';
 end if;
 if to_regprocedure('public.primary_password_configured()') is not null
 or to_regprocedure('private.primary_password_configured()') is not null then
  raise exception 'primary_password_status_existing_routine_requires_review';
 end if;
end $$;

create function private.primary_password_configured() returns boolean
language plpgsql stable security definer set search_path='' as $$
declare actor uuid:=auth.uid(); claims jsonb:=auth.jwt(); sid uuid; configured boolean;
begin
 if current_setting('role',true) is distinct from 'authenticated'
 or actor is null or claims->>'role' is distinct from 'authenticated'
 or claims->>'sub' is distinct from actor::text
 or (claims ? 'is_anonymous' and claims->'is_anonymous' not in ('false'::jsonb,'null'::jsonb)) then
  raise sqlstate '42501' using message='primary_password_status_unavailable';
 end if;
 begin sid:=nullif(claims->>'session_id','')::uuid;
 exception when invalid_text_representation then
  raise sqlstate '42501' using message='primary_password_status_unavailable';
 end;
 if sid is null or private.account_access_allowed() is distinct from true then
  raise sqlstate '42501' using message='primary_password_status_unavailable';
 end if;
 if not exists(select 1 from auth.sessions s where s.id=sid and s.user_id=actor
  and (s.not_after is null or s.not_after>clock_timestamp())) then
  raise sqlstate '42501' using message='primary_password_status_unavailable';
 end if;
 select coalesce(u.encrypted_password<>'',false) into configured from auth.users u
 where u.id=actor and not coalesce(u.is_anonymous,false)
 and (u.banned_until is null or u.banned_until<=clock_timestamp());
 if not found then
  raise sqlstate '42501' using message='primary_password_status_unavailable';
 end if;
 return configured;
end $$;
alter function private.primary_password_configured() owner to postgres;
revoke all on function private.primary_password_configured() from public,anon,authenticated,service_role;
grant execute on function private.primary_password_configured() to authenticated;

create function public.primary_password_configured() returns boolean
language sql stable security invoker set search_path='' as $$
 select private.primary_password_configured()
$$;
alter function public.primary_password_configured() owner to postgres;
revoke all on function public.primary_password_configured() from public,anon,authenticated,service_role;
grant execute on function public.primary_password_configured() to authenticated;
commit;
