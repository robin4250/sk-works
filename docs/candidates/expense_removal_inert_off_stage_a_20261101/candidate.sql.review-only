-- INERT STAGE A ONLY. Review fixture, NOT a production installer. deployable:false.
-- No public RPC, activation, notifications, claim mutation, existing reader edit,
-- existing-table trigger, financial reader/calculation, Storage or Auth body edit.
begin;
set local search_path=pg_catalog;
set local statement_timeout='5s';
set local lock_timeout='1s';
do $preflight$
declare role_name text; creator oid;
begin
 if current_database()<>'sko_expense_manager_removal_fixture' then
  raise exception 'Production HOLD: isolated inert stage A only';end if;
 select oid into creator from pg_roles where rolname='postgres';
 if current_user<>'postgres' or creator is null
  or (select nspowner from pg_namespace where nspname='private') is distinct from creator then
  raise exception 'Qualified private schema and creator required';end if;
 foreach role_name in array array['anon','authenticated','service_role'] loop
  if not exists(select 1 from pg_roles where rolname=role_name) then
   raise exception 'Platform role absent';end if;
  if (select rolsuper from pg_roles where rolname=role_name)
   or pg_has_role(role_name,'postgres','MEMBER') then
   raise exception 'Client role can inherit privileged creator';end if;
 end loop;
 if to_regclass('private.expense_manager_removal_state') is not null
  or to_regclass('private.expense_manager_removals') is not null
  or exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace
   where n.nspname='private' and p.proname='expense_manager_removal_immutable') then
  raise exception 'Stage A object/name already exists; inspect, never replace';end if;
end $preflight$;

create table private.expense_manager_removal_state (
 singleton boolean primary key check(singleton), enabled boolean not null default false
);
insert into private.expense_manager_removal_state values(true,false);
alter table private.expense_manager_removal_state enable row level security;
revoke all on private.expense_manager_removal_state from public,anon,authenticated,service_role;

create table private.expense_manager_removals (
 command_id uuid primary key,company_id uuid not null,claim_id uuid not null unique, -- FK deliberately deferred: it would add RI triggers to an existing table.
 actor_id uuid not null,session_id uuid not null,command jsonb not null,
 before_row jsonb not null,before_settlement jsonb,result jsonb not null,
 notification_id uuid not null,created_at timestamptz not null default clock_timestamp(),
 receipt_snapshot jsonb,
 receipt_state text not null check(receipt_state in ('attached_metadata_only','reserved_not_attached','unrecorded')),
 constraint expense_removal_receipt_snapshot_shape check(
  (receipt_state='unrecorded' and receipt_snapshot is null) or
  (receipt_state<>'unrecorded' and receipt_snapshot is not null and jsonb_typeof(receipt_snapshot)='object'))
);
alter table private.expense_manager_removals enable row level security;
revoke all on private.expense_manager_removals from public,anon,authenticated,service_role;

create function private.expense_manager_removal_immutable() returns trigger
language plpgsql security definer set search_path='' as $$
begin raise exception 'Expense removal history is immutable' using errcode='55000';end $$;
create trigger expense_manager_removal_immutable before update or delete on private.expense_manager_removals
 for each row execute function private.expense_manager_removal_immutable();
create trigger expense_manager_removal_truncate_guard before truncate on private.expense_manager_removals
 for each statement execute function private.expense_manager_removal_immutable();
revoke all on function private.expense_manager_removal_immutable() from public,anon,authenticated,service_role;

-- Unknown creator default grants must abort rather than silently survive explicit revokes.
do $acl$
declare creator oid:=(select oid from pg_roles where rolname='postgres');
begin
 if exists(select 1 from pg_class c cross join lateral aclexplode(coalesce(c.relacl,acldefault('r',c.relowner))) a
  where c.oid in ('private.expense_manager_removal_state'::regclass,'private.expense_manager_removals'::regclass)
   and (c.relowner<>creator or a.grantee<>creator))
  or exists(select 1 from pg_proc p cross join lateral aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a
   where p.oid='private.expense_manager_removal_immutable()'::regprocedure
    and (p.proowner<>creator or a.grantee<>creator)) then
  raise exception 'Unexpected inherited creator default ACL; stage A rolled back';end if;
end $acl$;
commit;
