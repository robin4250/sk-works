-- Isolated review candidate, NOT a production installer. Always deployable:false.
-- Payroll/shared document-reader integration and legacy rollout remain unresolved.
begin;
do $scope$ begin
 if current_database() <> 'sko_expense_manager_removal_fixture' then
  raise exception 'Production HOLD: isolated expense-removal fixture only';
 end if;
 if to_regclass('private.expense_manager_removal_state') is not null
  or to_regclass('private.expense_manager_removals') is not null then
  raise exception 'Expense-removal candidate already exists; inspect instead of replacing';
 end if;
end $scope$;

create table private.expense_manager_removal_state (
 singleton boolean primary key check(singleton), enabled boolean not null default false
);
insert into private.expense_manager_removal_state values(true,false);
alter table private.expense_manager_removal_state enable row level security;
revoke all on private.expense_manager_removal_state from public,anon,authenticated,service_role;

create table private.expense_manager_removals (
 command_id uuid primary key,company_id uuid not null,claim_id uuid not null unique references private.expense_claims(id),
 actor_id uuid not null,session_id uuid not null,command jsonb not null,
 before_row jsonb not null,before_settlement jsonb,result jsonb not null,
 notification_id uuid not null,created_at timestamptz not null default clock_timestamp()
);
alter table private.expense_manager_removals enable row level security;
revoke all on private.expense_manager_removals from public,anon,authenticated,service_role;

create function private.expense_manager_removal_immutable() returns trigger
language plpgsql security definer set search_path='' as $$
begin raise exception 'Expense removal history is immutable' using errcode='55000';end $$;
create trigger expense_manager_removal_immutable before update or delete on private.expense_manager_removals
 for each row execute function private.expense_manager_removal_immutable();
revoke all on function private.expense_manager_removal_immutable() from public,anon,authenticated,service_role;

create function private.expense_removal_live_actor() returns uuid
language plpgsql security definer set search_path='' as $$
declare actor uuid:=auth.uid(); jwt jsonb:=auth.jwt(); sid uuid; u auth.users%rowtype; s auth.sessions%rowtype;
begin
 if actor is null or jwt->>'role' is distinct from 'authenticated'
  or coalesce(jwt->>'session_id','') !~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
  or jsonb_typeof(jwt->'exp') is distinct from 'number'
  or coalesce(jwt->>'exp','') !~ '^[0-9]{1,12}$'
  or not coalesce(private.account_access_allowed(),false) then
  raise exception 'Expense removal access unavailable' using errcode='42501';
 end if;
 sid:=(jwt->>'session_id')::uuid;
 -- One explicit lock order: Auth user, live session, then company/role/settings.
 select * into u from auth.users where id=actor for share;
 if not found or u.deleted_at is not null or u.is_anonymous is distinct from false
  or u.banned_until>clock_timestamp() then
  raise exception 'Expense removal access unavailable' using errcode='42501';end if;
 select * into s from auth.sessions where id=sid and user_id=actor for share;
 if not found or (s.not_after is not null and s.not_after<=clock_timestamp())
  or (jwt->>'exp')::bigint<=extract(epoch from clock_timestamp()) then
  raise exception 'Expense removal access unavailable' using errcode='42501';end if;
 return sid;
end $$;
revoke all on function private.expense_removal_live_actor() from public,anon,authenticated,service_role;

create function private.expense_manager_removal_access(p_company uuid,p_require_enabled boolean) returns uuid
language plpgsql security definer set search_path='' as $$
declare sid uuid; role_name text; selected uuid[]; enabled boolean;
begin
 sid:=private.expense_removal_live_actor();
 perform 1 from public.companies where id=p_company for key share;
 if not found then raise exception 'Expense removal access unavailable' using errcode='42501';end if;
 select role::text into role_name from public.company_members
  where company_id=p_company and user_id=auth.uid() for share;
 if not found or role_name not in ('owner','admin','manager') then
  raise exception 'Expense removal access unavailable' using errcode='42501';end if;
 select approver_ids into selected from private.expense_approval_settings where company_id=p_company for share;
 if not found or not coalesce(auth.uid()=any(selected),false)
  or not coalesce((private.expense_review_access(p_company)->>'can_review')::boolean,false) then
  raise exception 'Selected expense manager required' using errcode='42501';end if;
 select s.enabled into enabled from private.expense_manager_removal_state s where singleton for share;
 if not found or (p_require_enabled and enabled is distinct from true) then
  raise exception 'Expense manager deletion is OFF' using errcode='42501';end if;
 return sid;
end $$;
revoke all on function private.expense_manager_removal_access(uuid,boolean) from public,anon,authenticated,service_role;

create function private.expense_manager_remove(p_command uuid,p_company uuid,p_claim uuid,p_revision integer,p_session uuid,p_reason text)
returns jsonb language plpgsql security definer set search_path='' as $$
declare sid uuid; claim private.expense_claims%rowtype; old private.expense_manager_removals%rowtype;
 command jsonb:=jsonb_build_object('company',p_company,'claim',p_claim,'revision',p_revision,'session',p_session,'reason',p_reason);
 original jsonb; original_settlement jsonb; result jsonb; notice uuid; consumed boolean; selected uuid[];
begin
 sid:=private.expense_manager_removal_access(p_company,false);
 if p_command is null or p_claim is null or p_revision is null or p_revision<1
  or p_session is null or p_reason is null or p_reason<>btrim(p_reason) or length(p_reason)>1000 then
  raise exception 'Invalid expense removal command' using errcode='22023';end if;
 select * into old from private.expense_manager_removals where command_id=p_command;
 if found then
  if old.company_id is distinct from p_company or old.actor_id is distinct from auth.uid() or old.command is distinct from command then
   raise exception 'Fixed expense removal differs' using errcode='23505';end if;
  return old.result; -- Result-only replay remains available after OFF or a new authorized SID.
 end if;
 perform private.expense_manager_removal_access(p_company,true);
 if sid is distinct from p_session then raise exception 'New login cannot start an old deletion' using errcode='42501';end if;
 select * into claim from private.expense_claims where id=p_claim and company_id=p_company for update;
 if not found then raise exception 'Expense removal access unavailable' using errcode='42501';end if;
 select * into old from private.expense_manager_removals where command_id=p_command;
 if found then
  if old.actor_id is distinct from auth.uid() or old.command is distinct from command then
   raise exception 'Fixed expense removal differs' using errcode='23505';end if;
  return old.result;
 end if;
 if exists(select 1 from private.expense_manager_removals where claim_id=p_claim)
  or claim.withdrawn then raise exception 'Expense already removed' using errcode='22023';end if;
 if claim.revision is distinct from p_revision then raise exception 'Expense changed; reload' using errcode='40001';end if;
 if exists(select 1 from private.expense_claim_events where command_id=p_command)
  or exists(select 1 from private.expense_personal_changes where command_id=p_command)
  or exists(select 1 from private.expense_review_confirmations where command_id=p_command)
  or exists(select 1 from private.expense_settlement_events where command_id=p_command)
  or exists(select 1 from private.expense_cost_allocation_events where command_id=p_command) then
  raise exception 'New expense removal command required' using errcode='23505';end if;
 select approver_ids into selected from private.expense_approval_settings where company_id=p_company;
 if claim.created_by=auth.uid() and cardinality(selected)>1 then
  raise exception 'Another selected approver must remove own claim' using errcode='42501';end if;
 if not exists(select 1 from public.company_members m join auth.users u on u.id=m.user_id
  where m.company_id=p_company and m.user_id=claim.created_by and u.deleted_at is null) then
  raise exception 'Applicant notification unavailable; expense unchanged' using errcode='42501';end if;
 original:=to_jsonb(claim);
 select to_jsonb(s) into original_settlement from private.expense_settlement_choices s where claim_id=p_claim;
 perform private.expense_cost_scope_lock(claim.company_id,claim.allocation,claim.counterparty_id,claim.incurred_on);
 consumed:=exists(select 1 from private.expense_amount_consumptions where claim_id=p_claim);
 if not consumed then
  -- Existing cost/withdrawal guards and existing draft-refresh triggers are preserved.
  update private.expense_claims set withdrawn=true,approval='rejected',allocation='unallocated',
   counterparty_id=null,counterparty_name=null,revision=revision+1 where id=p_claim;
 end if;
 if private.expense_manager_removal_access(p_company,true) is distinct from sid then
  raise exception 'Expense removal context changed' using errcode='42501';end if;
 notice:=private.enqueue_notification(p_company,claim.created_by,'info','経費が削除されました',
  case when consumed then '管理者が経費を削除しました。確定済み帳票の原本は保持され、金額の訂正は別途必要です。'
   else '管理者が経費を削除しました。経費の履歴から内容を確認してください。' end,
  'expense_manager_deleted',p_command);
 if notice is null then raise exception 'Applicant notification was not stored';end if;
 result:=jsonb_build_object('command_id',p_command,'company_id',p_company,'claim_id',p_claim,
  'requested_revision',p_revision,'manager_deleted',true,'deleted_by',auth.uid(),'deleted_at',clock_timestamp(),
  'financial_state',case when consumed then 'finalized_original_retained' else 'withdrawn_unfinalized' end,
  'correction_required',consumed,'notification_id',notice,'notification_state','stored');
 insert into private.expense_manager_removals(command_id,company_id,claim_id,actor_id,session_id,command,before_row,before_settlement,result,notification_id)
 values(p_command,p_company,p_claim,auth.uid(),sid,command,original,original_settlement,result,notice);
 return result;
end $$;
revoke all on function private.expense_manager_remove(uuid,uuid,uuid,integer,uuid,text) from public,anon,authenticated,service_role;
grant execute on function private.expense_manager_remove(uuid,uuid,uuid,integer,uuid,text) to authenticated;
create function public.expense_manager_remove(p_command uuid,p_company uuid,p_claim uuid,p_revision integer,p_session uuid,p_reason text)
returns jsonb language sql security invoker set search_path='' as $$
 select private.expense_manager_remove(p_command,p_company,p_claim,p_revision,p_session,p_reason) $$;
revoke all on function public.expense_manager_remove(uuid,uuid,uuid,integer,uuid,text) from public,anon,service_role;
grant execute on function public.expense_manager_remove(uuid,uuid,uuid,integer,uuid,text) to authenticated;

create function private.expense_manager_removal_result(p_command uuid,p_company uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
begin
 perform private.expense_manager_removal_access(p_company,false);
 return (select result from private.expense_manager_removals
  where command_id=p_command and company_id=p_company and actor_id=auth.uid());
end $$;
create function public.expense_manager_removal_result(p_command uuid,p_company uuid) returns jsonb
language sql security invoker set search_path='' as $$select private.expense_manager_removal_result(p_command,p_company)$$;
revoke all on function private.expense_manager_removal_result(uuid,uuid),public.expense_manager_removal_result(uuid,uuid) from public,anon,service_role;
grant execute on function private.expense_manager_removal_result(uuid,uuid),public.expense_manager_removal_result(uuid,uuid) to authenticated;

create function private.expense_manager_removal_write_guard() returns trigger
language plpgsql security definer set search_path='' as $$
declare target_claim uuid;
begin
 if tg_table_name='expense_claims' then target_claim:=old.id;else target_claim:=new.claim_id;end if;
 if exists(select 1 from private.expense_manager_removals r where r.claim_id=target_claim) then
  raise exception 'Manager-deleted expense cannot be reused or changed' using errcode='55000';end if;
 return new;
end $$;
revoke all on function private.expense_manager_removal_write_guard() from public,anon,authenticated,service_role;
create trigger expense_manager_removal_claim_guard before update on private.expense_claims
 for each row execute function private.expense_manager_removal_write_guard();
create trigger expense_manager_removal_choice_guard before insert or update on private.expense_settlement_choices
 for each row execute function private.expense_manager_removal_write_guard();
create trigger expense_manager_removal_consumption_guard before insert or update on private.expense_amount_consumptions
 for each row execute function private.expense_manager_removal_write_guard();

create function private.expense_manager_removal_notice(p_notification uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare notice public.app_notifications%rowtype; item private.expense_manager_removals%rowtype;
begin
 perform private.expense_removal_live_actor();
 select * into notice from public.app_notifications where id=p_notification and recipient_user_id=auth.uid()
  and action_key='expense_manager_deleted';
 if not found then raise exception 'Expense deletion notification unavailable' using errcode='42501';end if;
 select * into item from private.expense_manager_removals where command_id=notice.action_id
  and company_id=notice.company_id and notification_id=notice.id and before_row->>'created_by'=auth.uid()::text;
 if not found or not exists(select 1 from public.company_members where company_id=item.company_id and user_id=auth.uid()) then
  raise exception 'Expense deletion notification unavailable' using errcode='42501';end if;
 return jsonb_build_object('notification_id',notice.id,'action_key',notice.action_key,'action_id',notice.action_id,
  'company_id',item.company_id,'claim_id',item.claim_id,'manager_deleted',true,
  'description',item.before_row->'description','amount_yen',item.before_row->'amount_yen',
  'incurred_on',item.before_row->'incurred_on','deleted_at',item.result->'deleted_at',
  'financial_state',item.result->'financial_state','correction_required',item.result->'correction_required');
end $$;
create function public.expense_manager_removal_notice(p_notification uuid) returns jsonb
language sql security invoker set search_path='' as $$select private.expense_manager_removal_notice(p_notification)$$;
revoke all on function private.expense_manager_removal_notice(uuid),public.expense_manager_removal_notice(uuid) from public,anon,service_role;
grant execute on function private.expense_manager_removal_notice(uuid),public.expense_manager_removal_notice(uuid) to authenticated;

-- Same-OID, exact-source reader deltas. No alias bypass or ACL relaxation.
do $readers$
declare signature text; expected text; before_source text; after_source text;
 before_attributes jsonb; old_fragment text; new_fragment text; target oid;
begin
 for signature,expected,old_fragment,new_fragment in select * from (values
  ('private.expense_review_workspace(uuid,date)','03758fc84d89f735a50ba970574f32b3',
   'where e.company_id=p_company and e.incurred_on',
   'where not exists(select 1 from private.expense_manager_removals removed where removed.claim_id=e.id) and e.company_id=p_company and e.incurred_on'),
  ('private.expense_personal_history(uuid,uuid,date)','dcb55b250162077893708eec746aacae',
   'jsonb_agg(to_jsonb(e) order by',
   'jsonb_agg(to_jsonb(e)||jsonb_build_object(''manager_deleted'',exists(select 1 from private.expense_manager_removals removed where removed.claim_id=e.id)) order by')
 ) x(signature,expected,old_fragment,new_fragment) loop
  target:=to_regprocedure(signature);
  if target is null or (select md5(prosrc) from pg_proc where oid=target) is distinct from expected
   or (select proowner from pg_proc where oid=target)<>'postgres'::regrole then
   raise exception 'Expense legacy reader source drift: %',signature;end if;
  select pg_get_functiondef(p.oid),to_jsonb(p)-'prosrc' into before_source,before_attributes from pg_proc p where oid=target;
  if length(before_source)-length(replace(before_source,old_fragment,''))<>length(old_fragment) then
   raise exception 'Expense legacy reader edit must match exactly once';end if;
  after_source:=replace(before_source,old_fragment,new_fragment);
  execute after_source;
  if to_regprocedure(signature)::oid<>target
   or (select to_jsonb(p)-'prosrc' from pg_proc p where oid=target) is distinct from before_attributes
   or (select pg_get_functiondef(p.oid) from pg_proc p where oid=target) is distinct from after_source then
   raise exception 'Expense legacy reader metadata changed unexpectedly';end if;
 end loop;
end $readers$;

create function private.expense_manager_removal_workspace(p_company uuid,p_month date) returns jsonb
language plpgsql security definer set search_path='' as $$
declare result jsonb; removed jsonb; sid uuid; enabled boolean;
begin
 result:=private.expense_review_flow_workspace(p_company,p_month);
 select s.enabled into enabled from private.expense_manager_removal_state s where singleton;
 if coalesce(enabled,false) and coalesce((result->>'can_review')::boolean,false)
  and exists(select 1 from public.company_members where company_id=p_company and user_id=auth.uid()
   and role::text in ('owner','admin','manager')) then
  sid:=private.expense_manager_removal_access(p_company,false);
 end if;
 select coalesce(jsonb_agg(r.before_row||jsonb_build_object('manager_deleted',true,
  'financial_state',r.result->'financial_state','correction_required',r.result->'correction_required')
  order by r.created_at,r.command_id),'[]'::jsonb) into removed from private.expense_manager_removals r
  where company_id=p_company and (r.before_row->>'incurred_on')::date>=date_trunc('month',p_month)::date
   and (r.before_row->>'incurred_on')::date<(date_trunc('month',p_month)+interval '1 month')::date;
 return result||jsonb_build_object('manager_removal_version',1,'manager_removal_enabled',coalesce(enabled,false),
  'manager_removal_session',sid,'can_manager_remove',sid is not null,'claims',(result->'claims')||removed);
end $$;
create function public.expense_manager_removal_workspace(p_company uuid,p_month date) returns jsonb
language sql security invoker set search_path='' as $$select private.expense_manager_removal_workspace(p_company,p_month)$$;
revoke all on function private.expense_manager_removal_workspace(uuid,date),public.expense_manager_removal_workspace(uuid,date) from public,anon,service_role;
grant execute on function private.expense_manager_removal_workspace(uuid,date),public.expense_manager_removal_workspace(uuid,date) to authenticated;

-- The shared expense_document_claims/payroll reader and legacy client rollout
-- are NOT qualified here. This is NOT a complete production deletion workflow.
commit;
