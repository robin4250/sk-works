-- Review-only safety guard, no receipt/amount/history mutation.
begin;set local lock_timeout='3s';set local statement_timeout='30s';
do $lock$ declare r record;begin for r in select c.oid,n.nspname,c.relname from pg_class c join pg_namespace n on n.oid=c.relnamespace where c.oid in(to_regclass('public.daily_reports'),to_regclass('public.daily_report_workers'),to_regclass('public.attendance_entries'),to_regclass('company_checkout_allowance_private.receipts')) order by c.oid loop execute format('lock table %I.%I in ACCESS EXCLUSIVE mode',r.nspname,r.relname);end loop;end $lock$;
do $before$ begin if current_user<>'postgres' or not exists(select 1 from pg_proc where oid=to_regprocedure('company_checkout_allowance_private.guard_receipt_pointer()') and md5(prosrc)='e6c537e5c59eb68dca54cd932c1eef2a' and not prosecdef and proowner='postgres'::regrole and proconfig=array['search_path=""'] and proacl=array['postgres=X/postgres']::aclitem[]) then raise exception 'receipt guard exact source/security differs';end if;end $before$;
create temporary table receipt_guard_before on commit drop as select to_jsonb(p)-'prosrc' attributes from pg_proc p where oid='company_checkout_allowance_private.guard_receipt_pointer()'::regprocedure;
CREATE OR REPLACE FUNCTION company_checkout_allowance_private.guard_receipt_pointer()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
begin
 if current_user<>'postgres' and ((tg_op='INSERT' and new.company_allowance_receipt_id is not null)
 or (tg_op='UPDATE' and new.company_allowance_receipt_id is distinct from old.company_allowance_receipt_id)) then
  raise exception 'server-owned company allowance receipt' using errcode='42501';end if;
 if tg_op='UPDATE' and old.company_allowance_receipt_id is not null
 and new.company_allowance_receipt_id is not distinct from old.company_allowance_receipt_id
 and new.allowance_names is distinct from old.allowance_names then
  -- Direct clients never read the private price store through this invoker.
  if current_user<>'postgres' then
   raise exception '署名済みの会社共通手当は、この勤怠修正では削除できません。日報の修正承認後に手当を変更し、再署名してください。' using errcode='42501';
  end if;
  if exists(select 1 from company_checkout_allowance_private.receipts r
   cross join lateral jsonb_array_elements(r.snapshot->'items') item
   where r.id=old.company_allowance_receipt_id and r.company_id=old.company_id
    and r.worker_id=old.worker_id and r.report_id=old.source_report_id and r.work_date=old.work_date
    and not coalesce(item->>'name'=any(coalesce(new.allowance_names,'{}'::text[])),false)) then
   raise exception '署名済みの会社共通手当は、この勤怠修正では削除できません。日報の修正承認後に手当を変更し、再署名してください。' using errcode='22023';
  end if;
 end if;
 return new;
end $function$;

do $after$ begin if not exists(select 1 from pg_proc p cross join receipt_guard_before b where p.oid='company_checkout_allowance_private.guard_receipt_pointer()'::regprocedure and md5(p.prosrc)='ac08fbea5766d279f8bf764a0744e089' and to_jsonb(p)-'prosrc'=b.attributes) then raise exception 'receipt guard source/attributes mismatch';end if;end $after$;
commit;
