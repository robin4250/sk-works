-- REVIEW ONLY. Not a migration or production deployment.
-- Depends on private.account_access_allowed(), company_members and company_connections.
create table private.partner_company_profile_extensions (
 company_id uuid primary key references public.companies(id),
 representative_name text,
 version bigint not null default 1 check(version > 0),
 updated_by uuid not null,
 updated_at timestamptz not null default clock_timestamp(),
 check(length(representative_name) <= 80)
);
alter table private.partner_company_profile_extensions enable row level security;
revoke all on private.partner_company_profile_extensions from public,anon,authenticated;
create table private.partner_company_profile_audit (
 id bigint generated always as identity primary key,
 company_id uuid not null references public.companies(id),
 before_value jsonb not null, after_value jsonb not null,
 actor uuid not null, created_at timestamptz not null default clock_timestamp()
);
alter table private.partner_company_profile_audit enable row level security;
revoke all on private.partner_company_profile_audit from public,anon,authenticated;

create function private.partner_company_profile_value(p_company_id uuid) returns jsonb
language sql stable security definer set search_path='' as $$
 select jsonb_build_object('name',c.name,'address',c.address,'phone',c.phone,
 'email',c.email,'corporate_number',c.corporate_number,
 'representative_name',e.representative_name)
 from public.companies c left join private.partner_company_profile_extensions e on e.company_id=c.id
 where c.id=p_company_id
$$;
create function private.partner_company_profile_nonempty(v text) returns boolean
language sql immutable set search_path='' as $$
 select nullif(btrim(regexp_replace(coalesce(v,''),'[[:space:]]+',' ','g')),'') is not null
$$;
create function private.partner_company_profile_ready(p_company_id uuid) returns boolean
language sql stable security definer set search_path='' as $$
 select coalesce((select bool_and(private.partner_company_profile_nonempty(v->>k))
 from (select private.partner_company_profile_value(p_company_id) v) s,
 unnest(array['name','address','phone','representative_name']) k),false)
$$;
-- Internal limited label only. Caller MUST validate invite/token/actor/scope.
create function private.partner_company_profile_label(p_company_id uuid) returns jsonb
language sql stable security definer set search_path='' as $$
 select jsonb_build_object('name',v->'name','representative_name',v->'representative_name')
 from (select private.partner_company_profile_value(p_company_id) v) s
$$;
create function private.partner_company_profile_require_admin(p_company_id uuid) returns void
language plpgsql stable security definer set search_path='' as $$
begin
 if auth.uid() is null or private.account_access_allowed() is not true or not exists(
 select 1 from public.company_members m where m.company_id=p_company_id
 and m.user_id=auth.uid() and m.role::text in ('owner','admin')) then
 raise exception using errcode='42501',message='company profile access denied'; end if;
end $$;
create function private.partner_company_profile_visible(p_viewer_company_id uuid,p_target_company_id uuid) returns jsonb
language plpgsql stable security definer set search_path='' as $$
declare mine jsonb; theirs jsonb; result jsonb:='{}'; k text;
begin
 perform private.partner_company_profile_require_admin(p_viewer_company_id);
 if p_viewer_company_id=p_target_company_id or not exists(
 select 1 from private.company_connections c where c.status='accepted' and
 ((c.parent_company_id=p_viewer_company_id and c.child_company_id=p_target_company_id) or
 (c.child_company_id=p_viewer_company_id and c.parent_company_id=p_target_company_id))) then
 raise exception using errcode='42501',message='company profile access denied'; end if;
 mine:=private.partner_company_profile_value(p_viewer_company_id);
 theirs:=private.partner_company_profile_value(p_target_company_id);
 foreach k in array array['name','address','phone','representative_name','email','corporate_number'] loop
 if private.partner_company_profile_nonempty(mine->>k) then
 result:=result||jsonb_build_object(k,theirs->k); end if;
 end loop;
 return result;
end $$;
create function private.read_partner_company_profile(p_company_id uuid) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 perform private.partner_company_profile_require_admin(p_company_id);
 return jsonb_build_object('company_id',p_company_id,'contact_updated_at',(select updated_at from public.companies where id=p_company_id),'profile',private.partner_company_profile_value(p_company_id),
 'version',coalesce((select version from private.partner_company_profile_extensions where company_id=p_company_id),0),
 'ready',private.partner_company_profile_ready(p_company_id));
end $$;
create function private.save_partner_company_representative(p_company_id uuid,p_expected jsonb,p_representative_name text) returns jsonb
language plpgsql security definer set search_path='' as $$
declare beforev jsonb; afterv jsonb; representative text;
begin
 perform private.partner_company_profile_require_admin(p_company_id);
 perform 1 from public.companies where id=p_company_id for update;
 perform private.partner_company_profile_require_admin(p_company_id);
 beforev:=private.read_partner_company_profile(p_company_id);
 if beforev is distinct from p_expected then
 raise exception using errcode='40001',message='company profile changed; reload'; end if;
 representative:=nullif(btrim(regexp_replace(p_representative_name,'[[:space:]]+',' ','g')),'');
 if p_representative_name is null or length(coalesce(representative,''))>80 then
 raise exception using errcode='22023',message='invalid representative'; end if;
 insert into private.partner_company_profile_extensions(company_id,representative_name,updated_by)
 values(p_company_id,representative,auth.uid())
 on conflict(company_id) do update set representative_name=excluded.representative_name,
 version=private.partner_company_profile_extensions.version+1,updated_by=auth.uid(),updated_at=clock_timestamp();
 afterv:=private.read_partner_company_profile(p_company_id);
 insert into private.partner_company_profile_audit(company_id,before_value,after_value,actor)
 values(p_company_id,beforev,afterv,auth.uid());
 return afterv;
end $$;
-- All internal functions fail closed; no private schema usage granted here.
revoke all on function private.partner_company_profile_value(uuid),private.partner_company_profile_nonempty(text),
 private.partner_company_profile_ready(uuid),private.partner_company_profile_label(uuid),
 private.partner_company_profile_require_admin(uuid),private.partner_company_profile_visible(uuid,uuid),
 private.read_partner_company_profile(uuid),private.save_partner_company_representative(uuid,jsonb,text)
 from public,anon,authenticated;
create function public.read_partner_company_profile(p_company_id uuid) returns jsonb
language sql security invoker set search_path='' as $$select private.read_partner_company_profile(p_company_id)$$;
create function public.save_partner_company_representative(p_company_id uuid,p_expected jsonb,p_representative_name text) returns jsonb
language sql security invoker set search_path='' as $$select private.save_partner_company_representative(p_company_id,p_expected,p_representative_name)$$;
revoke all on function public.read_partner_company_profile(uuid),public.save_partner_company_representative(uuid,jsonb,text) from public,anon;
grant execute on function public.read_partner_company_profile(uuid),public.save_partner_company_representative(uuid,jsonb,text),
 private.read_partner_company_profile(uuid),private.save_partner_company_representative(uuid,jsonb,text) to authenticated;
