-- REVIEW ONLY. Management edits do not enter the personal approval queue.
-- Preserve personal photo requests, official history and all photo objects.
begin;
do $$begin
 if to_regprocedure('private.require_reauthentication_session()') is null
 or to_regprocedure('private.account_access_allowed()') is null
 or to_regprocedure('private.has_company_feature(uuid,text)') is null
 or to_regclass('private.worker_qualification_history') is null
 or to_regclass('private.qualification_photo_history') is null
 or to_regprocedure('private.guard_qualification_registered_update()') is not null
 or not exists(select 1 from pg_trigger t join pg_proc p on p.oid=t.tgfoid
  where t.tgrelid='public.worker_qualifications'::regclass and not t.tgisinternal
   and t.tgenabled<>'D' and p.oid='private.capture_official_qualification_history()'::regprocedure
   and md5(p.prosrc)='0881ea7010156e4878c8940b7d373faf')
 or not exists(select 1 from pg_trigger t where t.tgrelid='public.worker_qualifications'::regclass
  and not t.tgisinternal and t.tgenabled<>'D' and t.tgfoid='private.archive_qualification_photos()'::regprocedure) then
  raise exception 'qualification management prerequisite drift; review required' using errcode='55000';end if;
end$$;

create table private.qualification_management_state (
 singleton boolean primary key default true check(singleton),
 enabled boolean not null default false
);
insert into private.qualification_management_state(singleton,enabled) values(true,false);
alter table private.qualification_management_state enable row level security;
revoke all on private.qualification_management_state from public,anon,authenticated,service_role;

-- No FK/cascade: an approved historical record must survive affiliation or
-- company changes. Existing privacy retention procedures need a separate review.
create table private.qualification_management_operations (
 request_id uuid primary key, company_id uuid not null, actor_id uuid not null,
 target_id uuid not null, worker_id uuid not null, qualification_master_id uuid not null,
 operation text not null check(operation in ('create','update','delete')),
 command jsonb not null, before_snapshot jsonb, after_snapshot jsonb,
 recorded_at timestamptz not null default clock_timestamp()
);
alter table private.qualification_management_operations enable row level security;
revoke all on private.qualification_management_operations from public,anon,authenticated,service_role;

create function private.qualification_management_audit_immutable() returns trigger
language plpgsql security definer set search_path='' as $$begin
 raise exception 'qualification management audit is append only' using errcode='42501';
end$$;
revoke all on function private.qualification_management_audit_immutable() from public,anon,authenticated,service_role;
create trigger qualification_management_audit_immutable before update or delete on private.qualification_management_operations
 for each row execute function private.qualification_management_audit_immutable();

create function private.qualification_manager_can_write(c uuid) returns boolean
language plpgsql security definer set search_path='' as $$begin
 perform private.require_reauthentication_session();
 return auth.uid() is not null and private.account_access_allowed() is true
  and private.has_company_feature(c,'can_manage_people') is true
  and exists(select 1 from public.company_members where company_id=c and user_id=auth.uid()
   and role::text in ('owner','admin','manager'));
end$$;
revoke all on function private.qualification_manager_can_write(uuid) from public,anon,service_role;
grant execute on function private.qualification_manager_can_write(uuid) to authenticated;

-- Do not restrict the existing own first-registration INSERT or SELECT policy.
-- SECURITY DEFINER personal-photo approvals retain their existing behavior.
create policy qualification_management_update_role_boundary on public.worker_qualifications
 as restrictive for update to authenticated
 using(private.qualification_manager_can_write(company_id))
 with check(private.qualification_manager_can_write(company_id));
create policy qualification_management_delete_role_boundary on public.worker_qualifications
 as restrictive for delete to authenticated
 using(private.qualification_manager_can_write(company_id));

create function private.qualification_management_result(r private.qualification_management_operations)
returns jsonb language sql stable security invoker set search_path='' as $$
 select jsonb_build_object('version',1,'contract','qualification_direct_management','status','applied',
  'request_id',r.request_id,'company_id',r.company_id,'actor_id',r.actor_id,'target_id',r.target_id,
  'operation',r.operation,'before',r.before_snapshot,'after',r.after_snapshot,'recorded_at',r.recorded_at);
$$;
revoke all on function private.qualification_management_result(private.qualification_management_operations)
 from public,anon,authenticated,service_role;

create function private.qualification_direct_management(p_action text,p_data jsonb)
returns jsonb language plpgsql security definer set search_path='' as $$
declare actor uuid:=auth.uid(); cid uuid; target uuid; request uuid; wid uuid; mid uuid;
 op text; patch jsonb; command jsonb; before_row jsonb; after_row jsonb; key text; enabled boolean;
 saved private.qualification_management_operations%rowtype;
begin
 perform private.require_reauthentication_session();
 if actor is null or private.account_access_allowed() is not true then raise exception 'account unavailable' using errcode='42501';end if;
 cid:=nullif(p_data->>'company_id','')::uuid;
 if cid is null then raise exception 'exact company required' using errcode='22023';end if;
 perform 1 from public.company_members where company_id=cid and user_id=actor for share;
 perform 1 from public.member_feature_permissions where company_id=cid and user_id=actor for share;
 if not private.qualification_manager_can_write(cid) then raise exception 'people manager required' using errcode='42501';end if;
 select s.enabled into enabled from private.qualification_management_state s where singleton for share;
 if p_action='capability' then return jsonb_build_object('version',1,'contract','qualification_direct_management',
  'company_id',cid,'actor_id',actor,'available',enabled is true);end if;
 if p_action='get' then
  select * into saved from private.qualification_management_operations where request_id=(p_data->>'request_id')::uuid;
  if not found or saved.company_id is distinct from cid or saved.actor_id is distinct from actor then
   raise exception 'operation unavailable' using errcode='42501';end if;
  return private.qualification_management_result(saved);
 end if;
 if enabled is not true then raise exception 'qualification management stopped' using errcode='55000';end if;
 target:=(p_data->>'target_id')::uuid;
 if target is null then raise exception 'exact qualification required' using errcode='22023';end if;
 if p_action='inspect' then
  select to_jsonb(q) into before_row from public.worker_qualifications q
   join public.workers w on w.id=q.worker_id and w.company_id=q.company_id
   join public.qualification_master m on m.id=q.qualification_master_id and m.company_id=q.company_id
   where q.id=target and q.company_id=cid;
  if before_row is null then raise exception 'qualification unavailable' using errcode='42501';end if;
  return jsonb_build_object('version',1,'contract','qualification_direct_management','snapshot',before_row);
 end if;
 if p_action<>'apply' then raise exception 'unsupported management action' using errcode='22023';end if;
 request:=(p_data->>'request_id')::uuid;op:=p_data->>'operation';patch:=p_data->'fields';
 if request is null or op is null or op not in ('create','update','delete') then
  raise exception 'exact operation required' using errcode='22023';end if;
 if op in ('create','update') then
  if jsonb_typeof(patch) is distinct from 'object' or (select count(*) from jsonb_object_keys(patch))<>5
   or exists(select 1 from jsonb_object_keys(patch) k where k not in ('certificate_number','issuer','issued_at','expires_at','notes')) then
   raise exception 'qualification fields required' using errcode='22023';end if;
  for key in select jsonb_object_keys(patch) loop
   if jsonb_typeof(patch->key) not in ('string','null') or length(patch->>key)>4000 then
    raise exception 'qualification field invalid' using errcode='22023';end if;
  end loop;
  patch:=patch||jsonb_build_object('issued_at',nullif(patch->>'issued_at','')::date,'expires_at',nullif(patch->>'expires_at','')::date);
 elsif patch is not null and patch<>'null'::jsonb then
  raise exception 'delete has no replacement fields' using errcode='22023';end if;
 if op='create' then
  wid:=(p_data->>'worker_id')::uuid;mid:=(p_data->>'qualification_master_id')::uuid;
  if wid is null or mid is null or (p_data->'expected_snapshot' is not null and p_data->'expected_snapshot'<>'null'::jsonb) then
   raise exception 'new qualification identity required' using errcode='22023';end if;
 else
  if jsonb_typeof(p_data->'expected_snapshot') is distinct from 'object'
   or p_data->'expected_snapshot'->>'id' is distinct from target::text
   or p_data->'expected_snapshot'->>'company_id' is distinct from cid::text then
   raise exception 'reviewed qualification snapshot required' using errcode='22023';end if;
  wid:=(p_data->'expected_snapshot'->>'worker_id')::uuid;mid:=(p_data->'expected_snapshot'->>'qualification_master_id')::uuid;
 end if;
 command:=jsonb_build_object('company_id',cid,'target_id',target,'actor_id',actor,'operation',op,
  'worker_id',wid,'qualification_master_id',mid,'fields',patch,'expected_snapshot',p_data->'expected_snapshot');
 -- Request lock precedes the qualification lock for all retries and mutations.
 perform pg_advisory_xact_lock(hashtextextended('qualification-management:'||request::text,0));
 select * into saved from private.qualification_management_operations where request_id=request;
 if found then
  if saved.command is distinct from command then raise exception 'management request conflict' using errcode='23505';end if;
  return private.qualification_management_result(saved);end if;
 perform pg_advisory_xact_lock(hashtextextended(wid::text||mid::text,0));
 perform 1 from public.workers where id=wid and company_id=cid for share;
 if not found then raise exception 'worker unavailable' using errcode='42501';end if;
 perform 1 from public.qualification_master where id=mid and company_id=cid for share;
 if not found then raise exception 'qualification type unavailable' using errcode='42501';end if;
 select to_jsonb(q) into before_row from public.worker_qualifications q where id=target and company_id=cid for update;
 if op='create' then
  if before_row is not null or exists(select 1 from public.worker_qualifications where id=target) then
   raise exception 'qualification ID already used' using errcode='23505';end if;
 elsif before_row is distinct from p_data->'expected_snapshot' then
  raise exception 'qualification changed; reload before saving' using errcode='40001';end if;
 if op in ('create','update') and patch->>'expires_at' is null and exists(select 1 from public.qualification_master
  where id=mid and company_id=cid and expiry_required) then raise exception 'expiry required' using errcode='22023';end if;
 if op='create' then
  insert into public.worker_qualifications(id,company_id,worker_id,qualification_master_id,certificate_number,issuer,issued_at,expires_at,notes)
   values(target,cid,wid,mid,patch->>'certificate_number',patch->>'issuer',(patch->>'issued_at')::date,(patch->>'expires_at')::date,patch->>'notes');
 elsif op='update' then
  update public.worker_qualifications set certificate_number=patch->>'certificate_number',issuer=patch->>'issuer',
   issued_at=(patch->>'issued_at')::date,expires_at=(patch->>'expires_at')::date,notes=patch->>'notes',updated_at=now()
   where id=target and company_id=cid;
 else delete from public.worker_qualifications where id=target and company_id=cid;end if;
 if op<>'delete' then select to_jsonb(q) into after_row from public.worker_qualifications q where id=target;end if;
 insert into private.qualification_management_operations(request_id,company_id,actor_id,target_id,worker_id,
  qualification_master_id,operation,command,before_snapshot,after_snapshot)
 values(request,cid,actor,target,wid,mid,op,command,before_row,after_row) returning * into saved;
 return private.qualification_management_result(saved);
end$$;
revoke all on function private.qualification_direct_management(text,jsonb) from public,anon,authenticated,service_role;

create function public.qualification_direct_management(p_action text,p_data jsonb default '{}'::jsonb)
returns jsonb language sql security invoker set search_path='' as $$
 select private.qualification_direct_management(p_action,p_data);
$$;
revoke all on function public.qualification_direct_management(text,jsonb) from public,anon,service_role;
-- The wrapper requires a private entry grant. Both enforce the exact live actor.
grant execute on function private.qualification_direct_management(text,jsonb) to authenticated;
grant execute on function public.qualification_direct_management(text,jsonb) to authenticated;
commit;
