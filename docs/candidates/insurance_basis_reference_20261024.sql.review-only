-- Review-only. No automatic premium rebasing, new tables or payroll data conversion.
begin;
do $guard$
declare r record;
begin
 for r in select * from (values
 ('payroll_tax_private.validate_conditions(jsonb)','f74834ae3fc4081e31e646c0fab25ec8'),
 ('payroll_tax_private.read_conditions(uuid,uuid)','a8ceb2b235f66528b3ce1fb4cad59a68'),
 ('payroll_tax_private.save_conditions(uuid,uuid,date,bigint,jsonb,boolean)','d70b90d9e00ced26bc118a6493e957a3')) x(identity,hash)
 loop
  if (select md5(prosrc) from pg_proc where oid=to_regprocedure(r.identity)) is distinct from r.hash then
   raise exception 'insurance reference prerequisite differs: %',r.identity;
  end if;
 end loop;
 if to_regprocedure('public.read_worker_payroll_insurance_income_history(uuid,uuid,date,date)') is not null then
  raise exception 'insurance reference API already exists';
 end if;
end $guard$;

create function payroll_tax_private.validate_basis_reference(v jsonb) returns void
language plpgsql immutable security invoker set search_path='' as $fn$
declare f date; t date; n integer;
begin
 if v is null then return; end if;
 if jsonb_typeof(v) is distinct from 'object' or
  v-array['schema','from','to','average_monthly_income_yen','source','observed_months','history_fingerprint']<>'{}'::jsonb or
  (select count(*) from jsonb_object_keys(v))<>7 or v->'schema' is distinct from '1'::jsonb or
  jsonb_typeof(v->'from') is distinct from 'string' or jsonb_typeof(v->'to') is distinct from 'string' or
  (v->>'from')!~'^[0-9]{4}-[0-9]{2}-01$' or (v->>'to')!~'^[0-9]{4}-[0-9]{2}-01$' or
  jsonb_typeof(v->'average_monthly_income_yen') is distinct from 'number' or
  (v->>'average_monthly_income_yen')!~'^[0-9]{1,10}$' or
  (v->>'average_monthly_income_yen')::numeric>2147483647 or
  jsonb_typeof(v->'observed_months') is distinct from 'number' or
  (v->>'observed_months')!~'^[0-9]{1,3}$' or
  coalesce(v->>'source','') not in ('manual','actual_available','actual_complete') then
  raise exception '保険料参考額の対象期間・平均額を確認してください' using errcode='22023';
 end if;
 f:=(v->>'from')::date; t:=(v->>'to')::date;
 n:=12*(extract(year from t)::int-extract(year from f)::int)+extract(month from t)::int-extract(month from f)::int+1;
 if n not between 1 and 120 or (v->>'observed_months')::int>n then
  raise exception '対象期間は120か月以内で指定してください' using errcode='22023';
 end if;
 if v->>'source'='manual' then
  if v->'history_fingerprint' is distinct from 'null'::jsonb or v->'observed_months' is distinct from '0'::jsonb then
   raise exception '手入力の計算根拠が不正です' using errcode='22023'; end if;
 else
  if jsonb_typeof(v->'history_fingerprint') is distinct from 'string' or
   (v->>'history_fingerprint')!~'^[0-9a-f]{64}$' or (v->>'observed_months')::int<1 or
   (v->>'source'='actual_complete' and (v->>'observed_months')::int<>n) then
   raise exception '給与実績の計算根拠が不正です' using errcode='22023';end if;
 end if;
end $fn$;

create function payroll_tax_private.insurance_income_history(cid uuid,wid uuid,f date,t date) returns jsonb
language plpgsql stable security definer set search_path='' as $fn$
declare items jsonb; fingerprint text; months integer;
begin
 if auth.uid() is null or not coalesce(private.account_access_allowed(),false) or
  not coalesce(private.payroll_settings_allowed(cid,wid,'view'),false) then
  raise exception 'payroll access denied' using errcode='42501';end if;
 if f is null or t is null or f<>date_trunc('month',f)::date or t<>date_trunc('month',t)::date then
  raise exception '対象年月を指定してください' using errcode='22023';end if;
 months:=12*(extract(year from t)::int-extract(year from f)::int)+extract(month from t)::int-extract(month from f)::int+1;
 if months not between 1 and 120 then raise exception '対象期間は120か月以内で指定してください' using errcode='22023';end if;
 -- One complete canonical month per person. Frozen final documents take priority.
 -- Never use an unfinished/missing/finalized-without-snapshot row as a zero month.
 with candidates as (
  select ps.*,d.value frozen,
   count(*) filter(where ps.workflow_state='finalized') over(partition by ps.period_start) finals,
   count(*) filter(where ps.workflow_state='draft') over(partition by ps.period_start) drafts
  from public.payroll_statements ps
  left join payroll_final_private.documents d on d.statement_id=ps.id and d.company_id=ps.company_id and d.worker_id=ps.worker_id
  where ps.company_id=cid and ps.worker_id=wid and ps.period_start between f and t
   and ps.period_end=(ps.period_start+interval '1 month - 1 day')::date
   and ps.period_start=date_trunc('month',ps.period_start)::date
   and ps.workflow_state in ('draft','finalized')
 ), selected as (
  select c.*,
   case when workflow_state='finalized' then frozen#>>'{result,gross_pay}'
    else (gross_pay+coalesce((select sum(a.amount_yen) from public.payroll_adjustments a
     where a.company_id=cid and a.worker_id=wid and a.effective_date between c.period_start and c.period_end
      and a.cancelled_at is null and a.direction='addition'),0))::text end amount,
   case when workflow_state='finalized' then frozen#>>'{document_metadata,payment_date}'
    else private.payroll_document_metadata(id)->>'payment_date' end payment_day
  from candidates c
  where (finals=1 and workflow_state='finalized' and frozen is not null)
   or (finals=0 and drafts=1 and workflow_state='draft'
    and coalesce(detail#>>'{tax_calculation,blocked}','false')='false')
 )
 select coalesce(jsonb_agg(jsonb_build_object('statement_id',id,'month',period_start,
   'gross_pay',amount::bigint,'finalized',workflow_state='finalized','revision',revision,
   'payment_date',payment_day) order by period_start,id),'[]') into items
 from selected where amount~'^[0-9]{1,10}$' and amount::numeric<=2147483647 and revision>=1;
 fingerprint:=encode(sha256(convert_to(jsonb_build_object('company_id',cid,'worker_id',wid,'from',f,'to',t,'items',items)::text,'UTF8')),'hex');
 return jsonb_build_object('contract_version',1,'company_id',cid,'worker_id',wid,'from',f,'to',t,
  'items',items,'history_fingerprint',fingerprint,'period_basis','payroll_period','premium_rebase',false);
end $fn$;

create function public.read_worker_payroll_insurance_income_history(p_company_id uuid,p_worker_id uuid,p_from date,p_to date) returns jsonb
language sql stable security invoker set search_path='' as $fn$
 select payroll_tax_private.insurance_income_history(p_company_id,p_worker_id,p_from,p_to)
$fn$;

create function payroll_tax_private.verify_basis_reference(cid uuid,wid uuid,v jsonb) returns void
language plpgsql stable security invoker set search_path='' as $fn$
declare h jsonb; n integer; a bigint;
begin
 perform payroll_tax_private.validate_basis_reference(v);
 if v is null or v->>'source'='manual' then return;end if;
 h:=payroll_tax_private.insurance_income_history(cid,wid,(v->>'from')::date,(v->>'to')::date);
 select count(*),round(avg((x->>'gross_pay')::numeric))::bigint into n,a from jsonb_array_elements(h->'items') x;
 if v->>'history_fingerprint' is distinct from h->>'history_fingerprint' or
  (v->>'observed_months')::int is distinct from n or
  (v->>'average_monthly_income_yen')::bigint is distinct from a then
  raise exception '給与実績が更新されています。平均額を再取得してください' using errcode='40001';end if;
end $fn$;

-- Keep existing source, ACL, owner and permission decisions; change exact anchors only.
do $patch$
declare s text; old text; new text;
begin
 s:=pg_get_functiondef('payroll_tax_private.validate_conditions(jsonb)'::regprocedure);
 old:=E'begin\n'; new:=E'begin\n if octet_length(v::text)>4096 then raise exception \'税計算条件が不正です\' using errcode=\'22023\';end if;\n perform payroll_tax_private.validate_basis_reference(v->\'insurance_basis_reference\');\n v:=v-\'insurance_basis_reference\';\n';
 if position(old in s)=0 then raise exception 'validator anchor differs';end if;
 s:=replace(s,old,new);execute s;
 s:=pg_get_functiondef('payroll_tax_private.read_conditions(uuid,uuid)'::regprocedure);
 old:='return jsonb_build_object(';new:='return jsonb_build_object(''insurance_basis_reference_contract_version'',1,';
 if (length(s)-length(replace(s,old,'')))/length(old)<>1 then raise exception 'read anchor differs';end if;
 execute replace(s,old,new);
 s:=pg_get_functiondef('payroll_tax_private.save_conditions(uuid,uuid,date,bigint,jsonb,boolean)'::regprocedure);
 old:='if coalesce(old_value.version,0)<>p_expected_version';
 new:=E'if (p_value->\'insurance_basis_reference\') is distinct from (old_value.value->\'insurance_basis_reference\') then\n  perform payroll_tax_private.verify_basis_reference(cid,wid,p_value->\'insurance_basis_reference\');\n end if;\n if coalesce(old_value.version,0)<>p_expected_version';
 if (length(s)-length(replace(s,old,'')))/length(old)<>1 then raise exception 'save anchor differs';end if;
 execute replace(s,old,new);
end $patch$;

revoke all on function payroll_tax_private.validate_basis_reference(jsonb),payroll_tax_private.verify_basis_reference(uuid,uuid,jsonb),payroll_tax_private.insurance_income_history(uuid,uuid,date,date) from public,anon,authenticated;
grant execute on function payroll_tax_private.insurance_income_history(uuid,uuid,date,date) to authenticated;
revoke all on function public.read_worker_payroll_insurance_income_history(uuid,uuid,date,date) from public,anon,authenticated;
grant execute on function public.read_worker_payroll_insurance_income_history(uuid,uuid,date,date) to authenticated;
commit;
