-- REVIEW ONLY. No client grants, shared mutable draft, financial writes or sending.
begin;
create schema trade_document_consent_private;
revoke all on schema trade_document_consent_private from public,anon,authenticated,service_role;
-- This is agreement evidence only. Each company keeps its own draft/financial parent.
create table trade_document_consent_private.documents(
 id uuid primary key,issuer_company_id uuid not null references public.companies(id),
 counterparty_company_id uuid not null references public.companies(id),
 transaction_id uuid not null,document_kind text not null check(document_kind in('order','acceptance')),
 current_revision int not null check(current_revision>0),check(issuer_company_id<>counterparty_company_id),
 unique(issuer_company_id,counterparty_company_id,transaction_id,document_kind));
create table trade_document_consent_private.local_links(
 company_id uuid not null,local_document_id uuid not null,document_id uuid not null references trade_document_consent_private.documents(id),
 primary key(company_id,local_document_id),unique(company_id,document_id));
create table trade_document_consent_private.revisions(
 document_id uuid references trade_document_consent_private.documents(id),revision int,
 body jsonb not null,body_hash text not null,binding jsonb,
 state text not null default 'open' check(state in('open','approved','rejected','returned','cancelled')),
 epoch int not null default 0,created_by uuid not null,created_at timestamptz not null default clock_timestamp(),primary key(document_id,revision));
create table trade_document_consent_private.consents(
 document_id uuid,revision int,company_id uuid,actor_id uuid not null,seal_snapshot jsonb not null,seal_hash text not null,
 seal_version_id uuid,seal_asset_hash text,seal_version_key text not null,renderer_contract text not null,
 primary key(document_id,revision,company_id),foreign key(document_id,revision) references trade_document_consent_private.revisions(document_id,revision));
create table trade_document_consent_private.events(
 id bigint generated always as identity primary key,document_id uuid,revision int,company_id uuid,actor_id uuid not null,
 action text not null,value jsonb not null,recorded_at timestamptz not null default clock_timestamp());
create table trade_document_consent_private.receipts(request_id uuid primary key,actor_id uuid not null,payload jsonb not null,result jsonb not null);
alter table trade_document_consent_private.documents enable row level security;
alter table trade_document_consent_private.local_links enable row level security;
alter table trade_document_consent_private.revisions enable row level security;
alter table trade_document_consent_private.consents enable row level security;
alter table trade_document_consent_private.events enable row level security;
alter table trade_document_consent_private.receipts enable row level security;
revoke all on all tables in schema trade_document_consent_private from public,anon,authenticated,service_role;
create function trade_document_consent_private.immutable() returns trigger language plpgsql set search_path='' as $$begin raise exception 'immutable consent history';end $$;
create trigger immutable_events before update or delete on trade_document_consent_private.events for each row execute function trade_document_consent_private.immutable();
create trigger immutable_receipts before update or delete on trade_document_consent_private.receipts for each row execute function trade_document_consent_private.immutable();
create trigger immutable_local_identity before update or delete on trade_document_consent_private.local_links for each row execute function trade_document_consent_private.immutable();
create function trade_document_consent_private.protect_content() returns trigger language plpgsql set search_path='' as $$begin
 if tg_op='DELETE' or (new.document_id,new.revision,new.body,new.body_hash,new.binding,new.created_by,new.created_at)
 is distinct from(old.document_id,old.revision,old.body,old.body_hash,old.binding,old.created_by,old.created_at) then raise exception 'immutable document content';end if;return new;end $$;
create trigger immutable_content before update or delete on trade_document_consent_private.revisions for each row execute function trade_document_consent_private.protect_content();
create function trade_document_consent_private.require_actor(cid uuid) returns void language plpgsql stable security definer set search_path='' as $$begin
 if auth.uid() is null or private.account_access_allowed() is not true or not exists(select 1 from public.company_members where company_id=cid and user_id=auth.uid() and role::text in('owner','admin')) then
 raise exception 'document consent permission denied' using errcode='42501';end if;end $$;
create function trade_document_consent_private.lock_pair(a uuid,b uuid) returns void language plpgsql security definer set search_path='' as $$begin
 if a is null or b is null or a=b then raise exception 'distinct formal companies required';end if;
 perform 1 from public.companies where id in(a,b) order by id for share;
 perform 1 from private.company_connections where ((parent_company_id=a and child_company_id=b)or(parent_company_id=b and child_company_id=a)) order by parent_company_id,child_company_id for share;
 if(select count(*) from private.company_connections where status='accepted' and ((parent_company_id=a and child_company_id=b)or(parent_company_id=b and child_company_id=a)))<>1 then
 raise exception 'formal unique accepted company connection required' using errcode='42501';end if;end $$;
-- Production formal counterparty/parent ACL resolution is deliberately unavailable.
-- A directory name match is never a substitute for exact link FKs.
create function trade_document_consent_private.parent_binding(kind text,parent_id uuid,own_company uuid,peer_company uuid) returns jsonb
language plpgsql security definer set search_path='' as $$begin raise exception 'parent confirmation and formal counterparty adapter is not connected' using errcode='0A000';end $$;
create function trade_document_consent_private.linked_view_allowed(kind text,parent_id uuid,doc uuid,rev int,cid uuid) returns boolean
language sql stable security definer set search_path='' as $$select false$$;

create function trade_document_consent_private.prepare_document(doc uuid,own_company uuid,peer_company uuid,expected_revision int,body jsonb,
 parent_kind text default null,parent_id uuid default null,expected_parent_revision text default null,expected_attachment_version int default null) returns jsonb
language plpgsql security definer set search_path='' as $$
declare d trade_document_consent_private.documents%rowtype;binding jsonb;rev int;canonical jsonb;tx uuid;
begin
 perform trade_document_consent_private.require_actor(own_company);perform trade_document_consent_private.lock_pair(own_company,peer_company);
 if doc is null or expected_revision is null or expected_revision<0 or jsonb_typeof(body) is distinct from 'object' or octet_length(body::text)>32768
 or coalesce(body->>'kind','') not in('order','acceptance') or body ?| array['company_seal_snapshot','company_seal_enabled','seals','approved_by','actor_id']
 or body->>'issuer_company_id' is distinct from own_company::text or body->>'counterparty_company_id' is distinct from peer_company::text
 or coalesce(body->>'transaction_id','')!~'^[0-9a-fA-F-]{36}$' then raise exception 'exact directional document identity required';end if;
 tx:=(body->>'transaction_id')::uuid;
 if parent_kind is null then
 if parent_id is not null or expected_parent_revision is not null or expected_attachment_version is not null then raise exception 'standalone has no fabricated financial parent';end if;
 if body#>>'{issuer,name}' is distinct from(select name from public.companies where id=own_company)
 or body#>>'{counterparty,name}' is distinct from(select name from public.companies where id=peer_company) then raise exception 'registered company names required';end if;
 else
 if parent_kind not in('invoice','payment_certificate') or parent_id is null then raise exception 'parent kind required';end if;
 binding:=trade_document_consent_private.parent_binding(parent_kind,parent_id,own_company,peer_company);
 if binding->>'parent_revision' is distinct from expected_parent_revision or (binding->>'attachment_version')::int is distinct from expected_attachment_version then raise exception 'parent or attachment revision changed' using errcode='40001';end if;
 canonical:=(binding->'attachment_payload')||jsonb_build_object('issuer_company_id',own_company,'counterparty_company_id',peer_company,'transaction_id',tx);
 if canonical is distinct from body then raise exception 'saved attachment content differs' using errcode='40001';end if;
 binding:=(binding-'attachment_payload')||jsonb_build_object('parent_kind',parent_kind,'parent_id',parent_id);end if;
 perform pg_advisory_xact_lock(hashtextextended('trade-document-consent:'||doc::text,0));
 select * into d from trade_document_consent_private.documents where id=doc for update;
 if found then
 if(d.issuer_company_id,d.counterparty_company_id,d.transaction_id,d.document_kind,d.current_revision) is distinct from(own_company,peer_company,tx,body->>'kind',expected_revision) then raise exception 'document revision or directional identity changed' using errcode='40001';end if;
 rev:=d.current_revision+1;update trade_document_consent_private.documents set current_revision=rev where id=doc;
 else
 if expected_revision<>0 then raise exception 'document revision changed' using errcode='40001';end if;
 rev:=1;insert into trade_document_consent_private.documents values(doc,own_company,peer_company,tx,body->>'kind',rev);end if;
 insert into trade_document_consent_private.revisions(document_id,revision,body,body_hash,binding,created_by)
 values(doc,rev,body,encode(sha256(convert_to(body::text,'UTF8')),'hex'),binding,auth.uid());
 perform trade_document_consent_private.require_actor(own_company);
 return jsonb_build_object('document_id',doc,'revision',rev,'state','open','epoch',0);end $$;

-- Register only the caller company's local page identity. No peer page/draft is created.
create function trade_document_consent_private.bind_local(doc uuid,cid uuid,local_id uuid) returns void language plpgsql security definer set search_path='' as $$
declare d trade_document_consent_private.documents%rowtype;existing uuid;
begin
 perform trade_document_consent_private.require_actor(cid);select * into d from trade_document_consent_private.documents where id=doc;
 if local_id is null or local_id=doc or d.id is null or cid not in(d.issuer_company_id,d.counterparty_company_id) then raise exception 'separate local document identity required';end if;
 select document_id into existing from trade_document_consent_private.local_links where company_id=cid and local_document_id=local_id;
 if found then if existing<>doc then raise exception 'local page belongs to another directional document';end if;return;end if;
 insert into trade_document_consent_private.local_links values(cid,local_id,doc);end $$;
create function trade_document_consent_private.require_local(doc uuid,cid uuid) returns void language plpgsql stable security definer set search_path='' as $$begin
 perform trade_document_consent_private.require_actor(cid);
 if not exists(select 1 from trade_document_consent_private.local_links where document_id=doc and company_id=cid) then raise exception 'company-specific local document required' using errcode='42501';end if;end $$;
create function trade_document_consent_private.own_seal(cid uuid) returns jsonb language plpgsql security definer set search_path='' as $$
declare seal jsonb;h text;renderer text:='company-seal-pdf@2853e2d8d530f3fc65ce74ef307a1c63b21b0496';
begin
 if not exists(select 1 from public.companies where id=cid and company_seal_enabled) then raise exception 'registered company seal disabled';end if;
 seal:=private.document_company_seal_snapshot(null,cid,true)->'company_seal_snapshot';
 if seal is null or seal->>'name' is distinct from(select name from public.companies where id=cid) or seal->>'style' is null then raise exception 'official registered company seal required';end if;
 if seal->>'style'='uploaded_png' and (seal->>'company_id' is distinct from cid::text or seal->>'png_version_id' is null or seal->>'png_sha256' is null) then raise exception 'registered PNG version required';end if;
 h:=encode(sha256(convert_to(jsonb_build_object('snapshot',seal,'renderer_contract',renderer)::text,'UTF8')),'hex');
 return jsonb_build_object('snapshot',seal,'seal_hash',h,'version_id',seal->'png_version_id','asset_hash',seal->'png_sha256',
 'version_key',case when seal->>'style'='uploaded_png' then 'png:'||(seal->>'png_version_id') else 'snapshot-v1:'||h end,'renderer_contract',renderer);end $$;
create function trade_document_consent_private.preview_own(doc uuid,rev int,cid uuid) returns jsonb language plpgsql security definer set search_path='' as $$
declare d trade_document_consent_private.documents%rowtype;r trade_document_consent_private.revisions%rowtype;
begin
 perform trade_document_consent_private.require_local(doc,cid);select * into d from trade_document_consent_private.documents where id=doc;
 if d.id is null or cid not in(d.issuer_company_id,d.counterparty_company_id) then raise exception 'document access denied';end if;
 if cid<>d.issuer_company_id then raise exception 'issuer stamp owner approval required' using errcode='42501';end if;
 perform trade_document_consent_private.lock_pair(d.issuer_company_id,d.counterparty_company_id);
 select * into r from trade_document_consent_private.revisions where document_id=doc and revision=rev;
 if d.current_revision<>rev or r.state<>'open' then raise exception 'latest open revision required' using errcode='40001';end if;
 return jsonb_build_object('document_id',doc,'revision',rev,'company_id',cid,'epoch',r.epoch,'body_hash',r.body_hash,'binding',r.binding,'own_seal',trade_document_consent_private.own_seal(cid));end $$;

-- Internal primitive only; never expose as a second user-facing request workflow.
create function trade_document_consent_private.decide(doc uuid,rev int,cid uuid,expected_epoch int,expected_body_hash text,action text,expected_seal_hash text,confirmed boolean,rid uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare d trade_document_consent_private.documents%rowtype;r trade_document_consent_private.revisions%rowtype;seal jsonb;binding jsonb;payload jsonb;receipt trade_document_consent_private.receipts%rowtype;result jsonb;next_state text;
begin
 perform trade_document_consent_private.require_local(doc,cid);
 if confirmed is distinct from true or rid is null or action is null or action not in('approve','reject','return','cancel') then raise exception 'explicit document and seal consent required';end if;
 select * into d from trade_document_consent_private.documents where id=doc;
 if d.id is null or cid not in(d.issuer_company_id,d.counterparty_company_id) then raise exception 'document access denied';end if;
 if cid<>d.issuer_company_id then raise exception 'issuer stamp owner approval required' using errcode='42501';end if;
 if action='cancel' then perform 1 from public.companies where id in(d.issuer_company_id,d.counterparty_company_id) order by id for share;
 else perform trade_document_consent_private.lock_pair(d.issuer_company_id,d.counterparty_company_id);end if;
 select * into r from trade_document_consent_private.revisions where document_id=doc and revision=rev;
 if r.binding is not null then
 binding:=trade_document_consent_private.parent_binding(r.binding->>'parent_kind',(r.binding->>'parent_id')::uuid,d.issuer_company_id,d.counterparty_company_id);
 binding:=(binding-'attachment_payload')||jsonb_build_object('parent_kind',r.binding->>'parent_kind','parent_id',r.binding->'parent_id');end if;
 select * into d from trade_document_consent_private.documents where id=doc for update;
 select * into r from trade_document_consent_private.revisions where document_id=doc and revision=rev for update;
 payload:=jsonb_build_object('document_id',doc,'revision',rev,'company_id',cid,'epoch',expected_epoch,'body_hash',expected_body_hash,'action',action,'seal_hash',expected_seal_hash);
 select * into receipt from trade_document_consent_private.receipts where request_id=rid;
 if found then if receipt.actor_id is distinct from auth.uid() or receipt.payload is distinct from payload then raise exception 'consent request mismatch';end if;
 return receipt.result||jsonb_build_object('current_state',r.state);end if;
 if d.current_revision is distinct from rev or r.epoch is distinct from expected_epoch or r.body_hash is distinct from expected_body_hash
 or(action<>'cancel' and r.state<>'open')or(action='cancel' and r.state not in('open','approved')) then raise exception 'consent revision or state changed' using errcode='40001';end if;
 if r.binding is not null then
 if (action='cancel' and trade_document_consent_private.binding_matches_approval(doc,rev,r.binding,binding) is not true) or(action<>'cancel' and binding is distinct from r.binding) then raise exception 'parent confirmation binding changed' using errcode='40001';end if;end if;
 if action='approve' then
 seal:=trade_document_consent_private.own_seal(cid);
 if expected_seal_hash is null or expected_seal_hash is distinct from seal->>'seal_hash' then raise exception 'registered seal changed' using errcode='40001';end if;
 insert into trade_document_consent_private.consents values(doc,rev,cid,auth.uid(),seal->'snapshot',seal->>'seal_hash',(seal->>'version_id')::uuid,seal->>'asset_hash',seal->>'version_key',seal->>'renderer_contract')
 on conflict(document_id,revision,company_id) do update set actor_id=excluded.actor_id,seal_snapshot=excluded.seal_snapshot,seal_hash=excluded.seal_hash,seal_version_id=excluded.seal_version_id,seal_asset_hash=excluded.seal_asset_hash,seal_version_key=excluded.seal_version_key,renderer_contract=excluded.renderer_contract;
 next_state:='approved';
 else next_state:=case action when 'reject' then 'rejected' when 'return' then 'returned' else 'cancelled' end;end if;
 update trade_document_consent_private.revisions set state=next_state,epoch=epoch+1 where document_id=doc and revision=rev;
 perform trade_document_consent_private.require_actor(cid);
 insert into trade_document_consent_private.events(document_id,revision,company_id,actor_id,action,value)values(doc,rev,cid,auth.uid(),action,jsonb_build_object('body_hash',r.body_hash,'binding',r.binding,'seal',seal,'state',next_state));
 result:=jsonb_build_object('document_id',doc,'revision',rev,'request_outcome',action,'state_after_request',next_state,'current_state',next_state,'epoch',r.epoch+1);
 insert into trade_document_consent_private.receipts values(rid,auth.uid(),payload,result);return result;end $$;

-- Single future UI command: both financial-review and seal-consent rights/explicit
-- choices must be checked and recorded atomically under one canonical request ID.
-- Never call old internal approve_invoice as a proxy for counterpart confirmation.
create function trade_document_consent_private.confirm_local_document(local_id uuid,cid uuid,rev int,expected jsonb,rid uuid,financial_confirmed boolean,seal_confirmed boolean) returns jsonb
language plpgsql security definer set search_path='' as $$begin
 perform trade_document_consent_private.require_actor(cid);
 if financial_confirmed is not true or seal_confirmed is not true or rid is null then raise exception 'both explicit confirmations required';end if;
 raise exception 'unified financial review and seal consent adapter is not connected' using errcode='0A000';end $$;

create function trade_document_consent_private.binding_matches_approval(doc uuid,rev int,expected jsonb,current_binding jsonb) returns boolean language sql stable security definer set search_path='' as $$select expected is not distinct from current_binding$$;
create function trade_document_consent_private.render_approved(doc uuid,rev int,cid uuid,archive boolean default false) returns jsonb language plpgsql security definer set search_path='' as $$
declare d trade_document_consent_private.documents%rowtype;r trade_document_consent_private.revisions%rowtype;seals jsonb;approvals jsonb;binding jsonb;result jsonb;
begin
 if archive is null then raise exception 'explicit current or archive read required';end if;
 perform trade_document_consent_private.require_local(doc,cid);select * into d from trade_document_consent_private.documents where id=doc;
 if d.id is null or cid not in(d.issuer_company_id,d.counterparty_company_id) then raise exception 'document access denied';end if;
 select * into r from trade_document_consent_private.revisions where document_id=doc and revision=rev;
 if r.document_id is null or r.state<>'approved' or(not archive and d.current_revision<>rev)then raise exception 'explicit approved document revision required';end if;
 if r.binding is not null and trade_document_consent_private.linked_view_allowed(r.binding->>'parent_kind',(r.binding->>'parent_id')::uuid,doc,rev,cid)is not true then raise exception 'linked document view permission denied' using errcode='42501';end if;
 if not archive and r.binding is not null then
 binding:=trade_document_consent_private.parent_binding(r.binding->>'parent_kind',(r.binding->>'parent_id')::uuid,d.issuer_company_id,d.counterparty_company_id);
 binding:=(binding-'attachment_payload')||jsonb_build_object('parent_kind',r.binding->>'parent_kind','parent_id',r.binding->'parent_id');
 end if;
 -- Lock parent/attachment before consent rows, matching the integrated command.
 select * into d from trade_document_consent_private.documents where id=doc for share;
 select * into r from trade_document_consent_private.revisions where document_id=doc and revision=rev for share;
 if r.document_id is null or r.state<>'approved' or(not archive and d.current_revision<>rev)then raise exception 'explicit approved document revision required';end if;
 if not archive and r.binding is not null then
 if trade_document_consent_private.binding_matches_approval(doc,rev,r.binding,binding) is not true then raise exception 'parent changed; new approval required' using errcode='40001';end if;end if;
 select jsonb_agg(jsonb_build_object('company_id',company_id,'actor_id',actor_id,'seal_hash',seal_hash,'version_key',seal_version_key)order by company_id)
 into approvals from trade_document_consent_private.consents where document_id=doc and revision=rev;
 -- Each kind is issued by its own stamp owner. Do not wait for an extra peer stamp.
 select jsonb_agg(jsonb_build_object('company_id',company_id,'seal_snapshot',seal_snapshot,'seal_hash',seal_hash,'seal_version_id',seal_version_id,'asset_hash',seal_asset_hash,'version_key',seal_version_key,'renderer_contract',renderer_contract))
 into seals from trade_document_consent_private.consents where document_id=doc and revision=rev and company_id=d.issuer_company_id;
 if jsonb_array_length(approvals) is distinct from 1 or jsonb_array_length(seals) is distinct from 1 then raise exception 'issuer explicit consent required';end if;
 result:=jsonb_build_object('document_id',doc,'revision',rev,'transaction_id',d.transaction_id,'body',r.body,'body_hash',r.body_hash,'binding',r.binding,'seals',seals,'consents',approvals,'render_seal_company_id',d.issuer_company_id,
 'document_role',case d.document_kind when 'order' then 'ordering_company' else 'accepting_company' end);
 return result||jsonb_build_object('render_hash',encode(sha256(convert_to(result::text,'UTF8')),'hex'));end $$;
revoke all on all functions in schema trade_document_consent_private from public,anon,authenticated,service_role;
commit;
