-- REVIEW ONLY: private invoice notification + existing explicit issuer seal
-- confirmation composition. No public endpoint, grant or rollout. Payment
-- certificates and counterpart financial review are not implemented here.
create table trade_document_consent_private.notice_confirmation_settings (
 singleton boolean primary key default true check(singleton), enabled boolean not null default false);
insert into trade_document_consent_private.notice_confirmation_settings values(true,false);
alter table trade_document_consent_private.notice_confirmation_settings enable row level security;
revoke all on trade_document_consent_private.notice_confirmation_settings from public,anon,authenticated,service_role;

create function trade_document_consent_private.confirm_invoice_from_notice(
 p_ticket uuid,p_local uuid,p_company uuid,p_revision int,p_expected jsonb,p_request uuid,
 p_financial_confirmed boolean,p_seal_confirmed boolean) returns jsonb
language plpgsql security definer set search_path='' as $$
declare actor uuid:=auth.uid();sid uuid;doc uuid;parent uuid;ticket_parent uuid;peer uuid;result jsonb;enabled boolean;
begin
 select s.enabled into enabled from trade_document_consent_private.notice_confirmation_settings s where singleton for share;
 if enabled is distinct from true or invoice_month_close_candidate.notification_rollout_enabled() is distinct from true then
  raise exception 'notice_seal_disabled' using errcode='55000';end if;
 perform trade_document_consent_private.require_actor(p_company);
 sid:=private.require_reauthentication_session();
 if actor is null or sid is null then raise exception 'notice_unavailable' using errcode='42501';end if;
 select d.id,d.counterparty_company_id,(r.binding->>'parent_id')::uuid into doc,peer,parent
 from trade_document_consent_private.local_links l
 join trade_document_consent_private.documents d on d.id=l.document_id
 join trade_document_consent_private.revisions r on r.document_id=d.id and r.revision=p_revision
 where l.company_id=p_company and l.local_document_id=p_local and d.issuer_company_id=p_company
 and d.document_kind='acceptance' and r.binding->>'parent_kind'='invoice';
 if doc is null or parent is null then raise exception 'own invoice acceptance required' using errcode='42501';end if;
 -- Match the existing combined command's ordered company lock contract.
 perform 1 from public.companies where id in(p_company,peer) order by id for update;
 ticket_parent:=invoice_month_close_candidate.consume_notice_ticket(p_ticket);
 if ticket_parent is distinct from parent then raise exception 'notification parent mismatch' using errcode='42501';end if;
 -- Existing month-close gate retains its source comparison and all source locks
 -- until this transaction finishes. Do not replace it with a client boolean.
 if invoice_month_close_candidate.guarded(parent) is distinct from 'ready' then
  raise exception 'invoice_not_ready' using errcode='55000';end if;
 insert into invoice_month_close_candidate.approval_permits(tx,invoice_id,actor_id,session_id)
 values(txid_current(),parent,actor,sid);
 -- Existing adapter validates exact parent/attachment/body/stamp versions and
 -- performs financial approval plus issuer seal consent in this same transaction.
 result:=trade_document_consent_private.confirm_local_document(p_local,p_company,p_revision,p_expected,p_request,p_financial_confirmed,p_seal_confirmed);
 if result->'financial_approved' is distinct from 'true'::jsonb or result->'seal_consent_recorded' is distinct from 'true'::jsonb then
  raise exception 'combined confirmation incomplete';end if;
 delete from invoice_month_close_candidate.approval_permits where tx=txid_current() and invoice_id=parent and actor_id=actor and session_id=sid;
 return result;
end $$;
revoke all on function trade_document_consent_private.confirm_invoice_from_notice(uuid,uuid,uuid,int,jsonb,uuid,boolean,boolean) from public,anon,authenticated,service_role;
