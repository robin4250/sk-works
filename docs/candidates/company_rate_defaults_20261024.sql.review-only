-- REVIEW ONLY. Reuse existing authorization and storage; never update allowances.
begin;
set local lock_timeout='5s';
do $$begin
  if to_regprocedure('company_common_allowance_private.authorize(uuid,boolean)') is null
     or to_regclass('public.company_rate_settings') is null then
    raise exception 'company rate defaults prerequisites unavailable';
  end if;
end $$;

create function company_common_allowance_private.read_rate_defaults(cid uuid)
returns jsonb language plpgsql stable security definer set search_path='' as $$
declare result jsonb;
begin
  perform company_common_allowance_private.authorize(cid,true);
  select jsonb_build_object('contract_version',1,'company_id',c.id,
    'tax_rate',coalesce(c.tax_rate,0),'welfare_rate',coalesce(c.default_welfare_rate,0),
    'overtime_hour_rate_yen',coalesce(r.overtime_hour_rate_yen,0),
    'early_hour_rate_yen',coalesce(r.early_hour_rate_yen,0),
    'night_hour_rate_yen',coalesce(r.night_hour_rate_yen,0),
    'holiday_day_rate_yen',coalesce(r.holiday_day_rate_yen,0)) into result
  from public.companies c left join public.company_rate_settings r on r.company_id=c.id
  where c.id=cid;
  if result is null then raise exception 'company unavailable' using errcode='42501';end if;
  return result;
end $$;

create function company_common_allowance_private.save_rate_defaults(cid uuid,p_expected jsonb,p_values jsonb)
returns jsonb language plpgsql security definer set search_path='' as $$
declare current_values jsonb;before_allowances jsonb;after_allowances jsonb;field text;
  keys text[]:=array['tax_rate','welfare_rate','overtime_hour_rate_yen',
    'early_hour_rate_yen','night_hour_rate_yen','holiday_day_rate_yen'];
begin
  perform company_common_allowance_private.authorize(cid,true);
  if p_expected is null or p_values is null or jsonb_typeof(p_expected)<>'object'
     or jsonb_typeof(p_values)<>'object' then
    raise exception 'rate defaults objects required' using errcode='22023';
  end if;
  if (select count(*) from jsonb_object_keys(p_expected))<>6
     or (select count(*) from jsonb_object_keys(p_values))<>6
     or not (p_expected ?& keys) or not (p_values ?& keys) then
    raise exception 'rate defaults fields differ' using errcode='22023';
  end if;
  foreach field in array keys loop
    if jsonb_typeof(p_values->field)<>'number' or length(p_values->>field)>32
       or (p_values->>field)::numeric<0
       or (field in ('tax_rate','welfare_rate') and (p_values->>field)::numeric>100)
       or (field not in ('tax_rate','welfare_rate') and
          ((p_values->>field)::numeric>2147483647 or p_values->>field !~ '^[0-9]+$')) then
      raise exception 'invalid rate default value' using errcode='22023';
    end if;
  end loop;
  -- Same writer order as common settings. Never copy a client's hidden 3 slots.
  perform 1 from public.companies where id=cid for update;
  if not found then raise exception 'company unavailable' using errcode='42501';end if;
  perform 1 from public.company_rate_settings where company_id=cid for update;
  current_values:=company_common_allowance_private.read_rate_defaults(cid)-'company_id'-'contract_version';
  if current_values=p_values then return company_common_allowance_private.read_rate_defaults(cid);end if;
  if current_values is distinct from p_expected then
    raise exception 'rate defaults changed; reload required' using errcode='40001';
  end if;
  select to_jsonb(r)-'overtime_hour_rate_yen'-'early_hour_rate_yen'-'night_hour_rate_yen'
    -'holiday_day_rate_yen'-'updated_by'-'updated_at' into before_allowances
  from public.company_rate_settings r where company_id=cid;
  update public.companies set tax_rate=(p_values->>'tax_rate')::numeric,
    default_welfare_rate=(p_values->>'welfare_rate')::numeric,updated_at=now() where id=cid;
  insert into public.company_rate_settings(company_id,overtime_hour_rate_yen,early_hour_rate_yen,
    night_hour_rate_yen,holiday_day_rate_yen,updated_by,updated_at)
  values(cid,(p_values->>'overtime_hour_rate_yen')::int,(p_values->>'early_hour_rate_yen')::int,
    (p_values->>'night_hour_rate_yen')::int,(p_values->>'holiday_day_rate_yen')::int,auth.uid(),now())
  on conflict(company_id) do update set overtime_hour_rate_yen=excluded.overtime_hour_rate_yen,
    early_hour_rate_yen=excluded.early_hour_rate_yen,night_hour_rate_yen=excluded.night_hour_rate_yen,
    holiday_day_rate_yen=excluded.holiday_day_rate_yen,updated_by=excluded.updated_by,updated_at=excluded.updated_at;
  select to_jsonb(r)-'overtime_hour_rate_yen'-'early_hour_rate_yen'-'night_hour_rate_yen'
    -'holiday_day_rate_yen'-'updated_by'-'updated_at' into after_allowances
  from public.company_rate_settings r where company_id=cid;
  if before_allowances is not null and before_allowances is distinct from after_allowances then
    raise exception 'allowance originals changed' using errcode='55000';
  end if;
  return company_common_allowance_private.read_rate_defaults(cid);
end $$;
revoke all on function company_common_allowance_private.read_rate_defaults(uuid) from public,anon,authenticated,service_role;
revoke all on function company_common_allowance_private.save_rate_defaults(uuid,jsonb,jsonb) from public,anon,authenticated,service_role;
grant execute on function company_common_allowance_private.read_rate_defaults(uuid) to authenticated;
grant execute on function company_common_allowance_private.save_rate_defaults(uuid,jsonb,jsonb) to authenticated;

create function public.read_company_rate_defaults(p_company_id uuid)
returns jsonb language sql stable security invoker set search_path='' as $$
  select company_common_allowance_private.read_rate_defaults(p_company_id)
$$;
create function public.save_company_rate_defaults(p_company_id uuid,p_expected jsonb,p_values jsonb)
returns jsonb language sql security invoker set search_path='' as $$
  select company_common_allowance_private.save_rate_defaults(p_company_id,p_expected,p_values)
$$;
revoke all on function public.read_company_rate_defaults(uuid) from public,anon,authenticated,service_role;
revoke all on function public.save_company_rate_defaults(uuid,jsonb,jsonb) from public,anon,authenticated,service_role;
grant execute on function public.read_company_rate_defaults(uuid) to authenticated;
grant execute on function public.save_company_rate_defaults(uuid,jsonb,jsonb) to authenticated;
commit;
