-- REVIEW ONLY. Operator must serialize routine DDL and coordinate client rollout.
-- Exact rollback of the PR1377 d48 two-routine installation only; never CASCADE.
begin;
do $$
declare item record; target regprocedure; expected text; seen integer:=0;
begin
 for item in select * from (values
  ('public','0e2b9e20d22317c954e922ad3af6cb78',false),
  ('private','0116df44b0009e9f79596b51f52dde11',true)
 ) x(schema_name,source_md5,definer) loop
  target:=to_regprocedure(format('%I.primary_password_configured()',item.schema_name));
  if target is null or not exists(select 1 from pg_proc p where p.oid=target
   and p.pronargs=0 and p.prorettype='boolean'::regtype and not p.proretset
   and p.prosecdef=item.definer and p.provolatile='s' and not p.proleakproof
   and pg_get_userbyid(p.proowner)='postgres'
   and p.proconfig=array['search_path=""']::text[] and md5(p.prosrc)=item.source_md5) then
   raise exception 'primary_password_status_restore_definition_mismatch';
  end if;
  if (select array_agg(pg_get_userbyid(a.grantee)::text order by pg_get_userbyid(a.grantee)::text)
   from pg_proc p cross join lateral aclexplode(p.proacl) a where p.oid=target
   and a.privilege_type='EXECUTE' and a.grantor=(select oid from pg_roles where rolname='postgres')
   and not a.is_grantable) is distinct from array['authenticated','postgres']::text[]
  or (select count(*) from pg_proc p cross join lateral aclexplode(p.proacl) a where p.oid=target)<>2 then
   raise exception 'primary_password_status_restore_acl_mismatch';
  end if;
  seen:=seen+1;
 end loop;
 if seen<>2 then raise exception 'primary_password_status_restore_inventory_mismatch';end if;
end $$;
drop function public.primary_password_configured();
drop function private.primary_password_configured();
commit;
