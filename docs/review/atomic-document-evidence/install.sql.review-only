declare actual record;
begin
 if current_setting('server_version_num') is distinct from '170006' then raise exception 'Server version changed' using errcode='55000'; end if;
select
md5((select jsonb_agg(to_jsonb(p) order by p.oid) from pg_proc p where p.oid in ('auth.uid()'::regprocedure,'auth.jwt()'::regprocedure,'private.account_access_allowed()'::regprocedure,'private.account_deletion_barrier_key(uuid)'::regprocedure,'private.require_reauthentication_session()'::regprocedure,'public.current_user_required_document_attention()'::regprocedure))::text) as functions_hash,
md5((select jsonb_agg(to_jsonb(n) order by n.oid) from pg_namespace n where n.nspname in ('public','private','auth'))::text) as schemas_hash,
