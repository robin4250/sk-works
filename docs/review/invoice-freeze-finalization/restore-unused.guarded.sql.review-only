begin;
set local timezone='UTC';set local search_path='';set local lock_timeout='5s';set local statement_timeout='45s';
lock table public.daily_reports,public.daily_report_workers,public.attendance_entries,public.attendance_verifications,public.payroll_statements,public.invoices,public.invoice_detail_lines,public.sites,public.workers,explicit_report_finalization_private.events,explicit_report_finalization_private.states,explicit_report_finalization_private.receipts in share row exclusive mode;
create temporary table invoice_guard_rows(relation text primary key,n bigint,h text) on commit drop;
do $capture$ declare t text;n bigint;h text;begin
 foreach t in array array['public.daily_reports','public.daily_report_workers','public.attendance_entries','public.attendance_verifications','public.payroll_statements','public.invoices','public.invoice_detail_lines','public.sites','public.workers','explicit_report_finalization_private.events','explicit_report_finalization_private.states','explicit_report_finalization_private.receipts'] loop
  execute format($q$select count(*)::bigint,md5(coalesce(string_agg(h,'' order by h),'')) from(select md5(to_jsonb(x)::text)h from %s x)a$q$,t) into n,h;
  insert into pg_temp.invoice_guard_rows values(t,n,h);
 end loop;
end $capture$;
do $pre$ begin
 if current_user<>'postgres' then raise exception 'invoice_guard_wrong_operator';end if;
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('explicit_report_finalization_private.assert_invoice(uuid,uuid,uuid,date,date)') and md5(p.prosrc)='61813e28984cf60beefea5f70a5491ec' and md5((to_jsonb(p)-'prosrc')::text)='11111111111111111111111111111111') then raise exception 'invoice_guard_assert_drift';end if;
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('private.refresh_automatic_invoice(uuid,uuid,date)') and md5(p.prosrc)='22222222222222222222222222222222' and md5((to_jsonb(p)-'prosrc')::text)='33333333333333333333333333333333') then raise exception 'invoice_guard_refresh_drift';end if;
  if not exists(select 1 from pg_temp.invoice_guard_rows where relation='explicit_report_finalization_private.events' and n=990001 and h='44444444444444444444444444444444') then raise exception 'invoice_guard_history_changed';end if;
 if not exists(select 1 from pg_temp.invoice_guard_rows where relation='explicit_report_finalization_private.receipts' and n=990002 and h='55555555555555555555555555555555') then raise exception 'invoice_guard_history_changed';end if;
 if not exists(select 1 from pg_temp.invoice_guard_rows where relation='explicit_report_finalization_private.states' and n=990003 and h='66666666666666666666666666666666') then raise exception 'invoice_guard_history_changed';end if;
end $pre$;
CREATE OR REPLACE FUNCTION explicit_report_finalization_private.assert_invoice(rid uuid, cid uuid, customer uuid, first_day date, last_day date)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
declare v public.invoices%rowtype;site uuid;
begin
 if customer is null or not exists(select 1 from public.customers where id=customer and company_id=cid and nullif(btrim(name),'') is not null and notes is distinct from 'sko_system_unassigned_invoice_customer') then raise sqlstate '55000' using message='explicit_report_invoice_customer_required';end if;
 select * into v from public.invoices where company_id=cid and customer_id=customer and billing_period_start=first_day and billing_period_end=last_day and automatic_calculation is true order by created_at,id limit 1;
 if v.id is null then
  if exists(select 1 from public.invoices where company_id=cid and customer_id=customer and billing_period_start=first_day and billing_period_end=last_day and (automatic_calculation is distinct from true or status is distinct from 'draft' or finalized_at is not null)) then raise sqlstate '55000' using message='explicit_report_finalized_invoice_protected';end if;
  raise sqlstate '55000' using message='explicit_report_invoice_projection_missing';end if;
 if v.status is distinct from 'draft' or v.finalized_at is not null then raise sqlstate '55000' using message='explicit_report_finalized_invoice_protected';end if;
 if v.calculation_blocked is distinct from false then raise sqlstate '55000' using message='explicit_report_invoice_projection_blocked';end if;
 select site_id into site from public.daily_reports where id=rid;
 if site is not null and not exists(select 1 from jsonb_array_elements(v.snapshot->'sites') x where x->>'site_id'=site::text) then raise sqlstate '55000' using message='explicit_report_invoice_source_missing';end if;
end $function$
;
do $post$ declare r record;n bigint;h text;begin
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('explicit_report_finalization_private.assert_invoice(uuid,uuid,uuid,date,date)') and md5(p.prosrc)='4a3d95725487ec21604e115129a10ee9' and md5((to_jsonb(p)-'prosrc')::text)='11111111111111111111111111111111') then raise exception 'invoice_guard_post_function';end if;
 for r in select * from pg_temp.invoice_guard_rows loop
  execute format($q$select count(*)::bigint,md5(coalesce(string_agg(h,'' order by h),'')) from(select md5(to_jsonb(x)::text)h from %s x)a$q$,r.relation) into n,h;
  if n<>r.n or h<>r.h then raise exception 'invoice_guard_business_changed';end if;
 end loop;
end $post$;
commit;
