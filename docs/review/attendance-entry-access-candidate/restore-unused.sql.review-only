-- REVIEW ONLY. Unused restoration only; never remove live access/audit records.
begin;
set local lock_timeout='5s';set local statement_timeout='45s';
do $$declare x record;begin
 if current_user<>'postgres' or to_regnamespace('attendance_entry_access_private') is null then raise exception 'attendance_entry_restore_precondition';end if;
 lock table attendance_entry_access_private.rollout,attendance_entry_access_private.grants,attendance_entry_access_private.events in access exclusive mode;
 if exists(select 1 from attendance_entry_access_private.rollout) or exists(select 1 from attendance_entry_access_private.grants) or exists(select 1 from attendance_entry_access_private.events) then raise exception 'attendance_entry_restore_used_or_configured';end if;
 if (select count(*) from attendance_entry_access_private.originals)<>2 then raise exception 'attendance_entry_restore_originals';end if;
 for x in select * from attendance_entry_access_private.originals loop
  if not exists(select 1 from pg_proc p where p.oid=to_regprocedure(x.signature) and to_jsonb(p)=x.installed_metadata) then raise exception 'attendance_entry_restore_original_changed';end if;
 end loop;
 for x in select * from attendance_entry_access_private.installed_functions loop
  if not exists(select 1 from pg_proc p where p.oid=to_regprocedure(x.signature) and to_jsonb(p)=x.metadata) then raise exception 'attendance_entry_restore_installed_function_changed';end if;
 end loop;
end $$;
do $$declare x record;begin
 for x in select definition from attendance_entry_access_private.originals order by signature loop execute x.definition;end loop;
end $$;
drop function public.revoke_company_attendance_access(text,uuid,bigint,text);
drop function public.close_attendance_management_access(text);
drop function public.force_manage_attendance_with_access(text,jsonb,text,uuid);
drop function public.open_attendance_management_access(text,uuid);
drop function public.attendance_management_entry_capabilities();
drop function attendance_entry_access_private.require_access(text,uuid);
drop function attendance_entry_access_private.required();
drop function attendance_entry_access_private.context();
drop trigger attendance_entry_revision_guard on attendance_entry_access_private.rollout;
drop function attendance_entry_access_private.guard_revision();
drop table attendance_entry_access_private.installed_functions;
drop table attendance_entry_access_private.originals;
drop table attendance_entry_access_private.events;
drop table attendance_entry_access_private.grants;
drop table attendance_entry_access_private.rollout;
drop schema attendance_entry_access_private;
commit;
