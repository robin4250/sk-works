if (select jsonb_agg(jsonb_build_object('name',c.relname,'oid',c.oid::text,'owner',pg_get_userbyid(c.relowner),'acl',c.relacl::text,'rls',c.relrowsecurity,'columns',(select jsonb_agg(jsonb_build_array(a.attnum,a.attname,a.atttypid::text,a.attnotnull)order by a.attnum)from pg_attribute a where a.attrelid=c.oid and a.attnum>0 and not a.attisdropped))order by c.relname)from pg_class c where c.oid=any(array['public.daily_report_workers'::regclass,'public.daily_reports'::regclass]))is distinct from '[{"acl":"{postgres=arwdDxtm/postgres,authenticated=rm/postgres,service_role=arwdDxtm/postgres}","oid":"19235","rls":true,"name":"daily_report_workers","owner":"postgres","columns":[[1,"report_id","2950",true],[2,"worker_id","2950",true],[3,"overtime_hours","1700",true],[4,"early_hours","1700",true],[5,"night_hours","1700",true],[6,"allowance_amount","23",true],[7,"allowance_label","25",false],[8,"work_category","25",false],[9,"vehicle_id","2950",false],[10,"route_assignment_id","2950",false],[11,"odometer_km","1700",false],[12,"company_allowance_selections","3802",false],[13,"company_allowance_legacy_labels","25",false]]},{"acl":"{postgres=arwdDxtm/postgres,authenticated=rm/postgres,service_role=arwdDxtm/postgres}","oid":"19201","rls":true,"name":"daily_reports","owner":"postgres","columns":[[1,"id","2950",true],[2,"company_id","2950",true],[3,"site_id","2950",false],[4,"report_date","1082",true],[5,"work_description","25",false],[6,"status","25",true],[7,"signer_name","25",false],[8,"signature_json","3802",false],[9,"signed_at","1184",false],[10,"created_by","2950",false],[11,"updated_by","2950",false],[12,"created_at","1184",true],[13,"updated_at","1184",true],[14,"representative_signature_json","3802",false],[15,"representative_signer_name","25",false],[16,"supervisor_signature_json","3802",false],[17,"supervisor_signer_name","25",false],[18,"route_assignment_id","2950",false]]}]'::jsonb then raise exception 'supervisor_worker_tables_changed';end if;
end $source_guard$;
create temporary table supervisor_worker_protected(relation text primary key,n bigint,h text)on commit drop;
do $before_rows$ declare target text;n bigint;h text;begin foreach target in array array['public.daily_reports','public.daily_report_workers','public.attendance_entries','public.payroll_statements','public.invoices','public.invoice_detail_lines']loop execute format($digest$select count(*)::bigint,md5(coalesce(string_agg(row_hash,''order by row_hash),''))from(select md5(to_jsonb(x)::text)row_hash from %s x)d$digest$,target)into n,h;insert into pg_temp.supervisor_worker_protected values(target,n,h);end loop;end $before_rows$;
-- Candidate body only; guarded production wrapper is prepared separately.
create or replace function private.clear_daily_report_signatures_on_workers()
returns trigger language plpgsql security definer set search_path='' as $function$
declare materialization_allowed boolean:=false;
begin
  if tg_op='UPDATE' and row(new.report_id,new.worker_id)
      is not distinct from row(old.report_id,old.worker_id) then
    if to_jsonb(new) is not distinct from to_jsonb(old) then return new;end if;
    -- The existing BEFORE roster guard accepts only the same actor/transaction,
    -- supervisor context, and exact confirmed facts. Do not erase a saved work
    -- signature while that trusted materialization is still in progress.
    if to_regprocedure('checkout_shared_hours_private.permits_worker_materialization(uuid,uuid,jsonb,jsonb)') is not null then
      execute 'select checkout_shared_hours_private.permits_worker_materialization($1,$2,$3,$4)'
        into materialization_allowed using old.report_id,old.worker_id,to_jsonb(old),to_jsonb(new);
      if materialization_allowed is true then return new;end if;
    end if;
  end if;
  update public.daily_reports set representative_signature_json=null, representative_signer_name=null,
    supervisor_signature_json=null, supervisor_signer_name=null
  where id=coalesce(new.report_id, old.report_id) and status='draft';
  return coalesce(new,old);
end;
$function$;

do $after_rows$ declare original record;n bigint;h text;begin for original in select * from pg_temp.supervisor_worker_protected loop execute format($digest$select count(*)::bigint,md5(coalesce(string_agg(row_hash,''order by row_hash),''))from(select md5(to_jsonb(x)::text)row_hash from %s x)d$digest$,original.relation)into n,h;if n is distinct from original.n or h is distinct from original.h then raise exception 'supervisor_worker_business_rows_changed';end if;end loop;end $after_rows$;
commit;
