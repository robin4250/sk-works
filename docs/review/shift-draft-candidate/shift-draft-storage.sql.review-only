-- Candidate only. No production deployment or feature activation.
begin;
create schema shift_draft_private;
revoke all on schema shift_draft_private from public, anon, authenticated;
create table shift_draft_private.rollout(company_id uuid primary key, enabled boolean not null default false);
create table shift_draft_private.plans(
 company_id uuid not null, worker_id uuid not null, work_date date not null,
 site_id uuid, holiday boolean not null, night boolean not null,
 start_minute integer not null, end_minute integer not null,
 check_late boolean not null, check_early boolean not null,
 revision integer not null check(revision > 0),
 changed_by uuid not null, changed_at timestamptz not null default clock_timestamp(),
 primary key(company_id,worker_id,work_date));
create table shift_draft_private.audit(
 id bigint generated always as identity primary key, company_id uuid not null,
 worker_id uuid not null, work_date date not null, actor uuid not null,
 old_revision integer not null, new_revision integer not null,
 changed_at timestamptz not null default clock_timestamp());
revoke all on all tables in schema shift_draft_private from public, anon, authenticated;
revoke all on all sequences in schema shift_draft_private from public, anon, authenticated;

-- Atomic batch of same-company drafts only. This does not confirm shifts,
-- create attendance entries, or publish plans to employees.
create function public.save_shift_drafts(p_company uuid,p_rows jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare actor uuid:=auth.uid(); r jsonb; wid uuid; d date; sid uuid;
 expected integer; previous integer; next_revision integer; offday boolean;
 st integer; en integer; result jsonb:='[]'::jsonb;
begin
 perform private.require_reauthentication_session();
 if private.account_access_allowed() is not true or p_company is null
  or not exists(select 1 from public.company_members m where m.company_id=p_company
    and m.user_id=actor and m.role::text in ('owner','admin')) then
   raise sqlstate '42501' using message='shift_access_denied';
 end if;
 if not exists(select 1 from shift_draft_private.rollout where company_id=p_company and enabled) then
   raise sqlstate '42501' using message='shift_feature_disabled';
 end if;
 if jsonb_typeof(p_rows) is distinct from 'array' or jsonb_array_length(p_rows) not between 1 and 100 then
   raise exception 'shift_invalid_batch';
 end if;
 if exists(select 1 from jsonb_array_elements(p_rows) x group by (x->>'worker_id')::uuid,(x->>'work_date')::date having count(*)>1) then
   raise exception 'shift_duplicate_worker_date';
 end if;
 for r in select x from jsonb_array_elements(p_rows) x order by (x->>'worker_id')::uuid,(x->>'work_date')::date loop
   if jsonb_typeof(r) is distinct from 'object' or jsonb_typeof(r->'holiday') is distinct from 'boolean'
      or jsonb_typeof(r->'night') is distinct from 'boolean'
      or jsonb_typeof(r->'check_late') is distinct from 'boolean'
      or jsonb_typeof(r->'check_early') is distinct from 'boolean' then raise exception 'shift_invalid_payload'; end if;
   wid:=(r->>'worker_id')::uuid; d:=(r->>'work_date')::date;
   sid:=nullif(r->>'site_id','')::uuid; expected:=(r->>'revision')::integer;
   st:=(r->>'start_minute')::integer; en:=(r->>'end_minute')::integer; offday:=(r->>'holiday')::boolean;
   if wid is null or d is null or expected is null or expected<0 or st is null or en is null
      or st not between 0 and 1439 or en not between 0 and 1439 then raise exception 'shift_invalid_payload'; end if;
   if (sid is not null and not exists(select 1 from public.sites s where s.id=sid and s.company_id=p_company))
      or (not offday and (sid is null or st=en)) then
      raise exception 'shift_invalid_site_or_time'; end if;
   if not exists(select 1 from public.workers w where w.id=wid and w.company_id=p_company) then
      raise exception 'shift_invalid_worker'; end if;
   perform pg_advisory_xact_lock(hashtextextended('sko-shift:'||p_company::text||':'||wid::text||':'||d::text,0));
   select revision into previous from shift_draft_private.plans where company_id=p_company and worker_id=wid and work_date=d for update;
   previous:=coalesce(previous,0);
   if previous<>expected then raise exception 'shift_revision_conflict'; end if;
   next_revision:=previous+1;
   insert into shift_draft_private.plans(company_id,worker_id,work_date,site_id,holiday,night,start_minute,end_minute,check_late,check_early,revision,changed_by)
   values(p_company,wid,d,sid,offday,(r->>'night')::boolean,st,en,(r->>'check_late')::boolean,(r->>'check_early')::boolean,next_revision,actor)
   on conflict(company_id,worker_id,work_date) do update set site_id=excluded.site_id,holiday=excluded.holiday,
   night=excluded.night,start_minute=excluded.start_minute,end_minute=excluded.end_minute,
   check_late=excluded.check_late,check_early=excluded.check_early,revision=excluded.revision,
   changed_by=excluded.changed_by,changed_at=clock_timestamp();
   insert into shift_draft_private.audit(company_id,worker_id,work_date,actor,old_revision,new_revision)
   values(p_company,wid,d,actor,previous,next_revision);
   result:=result||jsonb_build_array(jsonb_build_object('worker_id',wid,'work_date',d,'revision',next_revision));
 end loop;
 return result;
end $$;
revoke all on function public.save_shift_drafts(uuid,jsonb) from public,anon,service_role;
grant execute on function public.save_shift_drafts(uuid,jsonb) to authenticated;

-- Read only the management drafts for a bounded month. Drafts are not an
-- employee-facing published schedule and are never attendance records.
create function public.list_shift_drafts(p_company uuid,p_from date,p_to date) returns jsonb
language plpgsql security definer set search_path='' as $$
declare actor uuid:=auth.uid();
begin
 perform private.require_reauthentication_session();
 if private.account_access_allowed() is not true or p_company is null
  or not exists(select 1 from public.company_members m where m.company_id=p_company
    and m.user_id=actor and m.role::text in ('owner','admin')) then
   raise sqlstate '42501' using message='shift_access_denied'; end if;
 if not exists(select 1 from shift_draft_private.rollout where company_id=p_company and enabled) then
   raise sqlstate '42501' using message='shift_feature_disabled'; end if;
 if p_from is null or p_to is null or p_to<p_from or p_to-p_from>30 then raise exception 'shift_invalid_range'; end if;
 return coalesce((select jsonb_agg(jsonb_build_object('worker_id',p.worker_id,'work_date',p.work_date,
   'site_id',p.site_id,'holiday',p.holiday,'night',p.night,'start_minute',p.start_minute,
   'end_minute',p.end_minute,'check_late',p.check_late,'check_early',p.check_early,
   'revision',p.revision) order by p.work_date,p.worker_id)
   from shift_draft_private.plans p where p.company_id=p_company and p.work_date between p_from and p_to),'[]'::jsonb);
end $$;
revoke all on function public.list_shift_drafts(uuid,date,date) from public,anon,service_role;
grant execute on function public.list_shift_drafts(uuid,date,date) to authenticated;
commit;
