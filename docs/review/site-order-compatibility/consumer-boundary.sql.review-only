 execute $replacement$CREATE OR REPLACE FUNCTION private.save_company_delivery_items(p_item_keys text[])
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
declare
  c uuid;
  k text;
  item_id uuid;
  item_kind text;
begin
  select m.company_id into c
  from public.company_members m
  where m.user_id=auth.uid() and m.role::text in ('owner','admin')
  limit 1;
  if c is null then raise exception '会社の管理者だけが操作できます。'; end if;
  if p_item_keys is null or cardinality(p_item_keys) not between 1 and 500 then
    raise exception '保存対象を確認してください。';
  end if;


  -- Preflight the complete batch before the first saved-item write.
  foreach k in array p_item_keys loop
    if k is null or k !~ '^(file|data):[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' then
      raise exception '保存対象を確認してください。' using errcode='22023';
    end if;
    item_kind:=split_part(k,':',1); item_id:=split_part(k,':',2)::uuid;
    if item_kind='file' then
      if not exists(select 1 from private.document_delivery_items i
        join private.document_deliveries d on d.id=i.delivery_id
        where i.id=item_id and d.recipient_company_id=c) then
        raise exception '保存できない書類が含まれています。' using errcode='22023';
      end if;
    else
      if not exists(select 1 from private.company_data_delivery_items i
        join private.document_deliveries d on d.id=i.delivery_id
        where i.id=item_id and d.recipient_company_id=c
          and i.payload_kind in ('qualification','personnel')) then
        raise exception 'このデータは個別の承認画面で確認してください。' using errcode='22023';
      end if;
    end if;
  end loop;
  foreach k in array p_item_keys loop
    item_kind:=split_part(k,':',1);
    begin
      item_id:=split_part(k,':',2)::uuid;
    exception when others then
      raise exception '保存対象を確認してください。';
    end;

    if item_kind='file' then
      if not exists(
        select 1
        from private.document_delivery_items i
        join private.document_deliveries d on d.id=i.delivery_id
        where i.id=item_id and d.recipient_company_id=c
      ) then
        raise exception '保存できない書類が含まれています。';
      end if;
    elsif item_kind='data' then
      if not exists(
        select 1
        from private.company_data_delivery_items i
        join private.document_deliveries d on d.id=i.delivery_id
        where i.id=item_id and d.recipient_company_id=c and i.payload_kind in ('qualification','personnel')
      ) then
        raise exception '保存できないデータが含まれています。';
      end if;
    else
      raise exception '保存対象の種類を確認してください。';
    end if;

    insert into private.company_delivery_saved_items(
      company_id,item_key,saved_by,saved_at
    )
    values(c,k,auth.uid(),now())
    on conflict(company_id,item_key)
    do update set saved_by=excluded.saved_by,saved_at=excluded.saved_at;
  end loop;
end
