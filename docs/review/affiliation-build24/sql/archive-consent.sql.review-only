-- Depends on request ledger and the reviewed vault24 catalog. No public grants.
begin;
create table affiliation_transition_candidate.archive_consents(
 request_id uuid primary key references affiliation_transition_candidate.requests(request_id) on delete restrict,
 subject_id uuid not null, session_id uuid not null, manifest_id uuid not null,
 snapshot_hash text not null check(snapshot_hash ~ '^[a-f0-9]{64}$'), confirmed_at timestamptz not null default clock_timestamp());
alter table affiliation_transition_candidate.archive_consents enable row level security;
revoke all on affiliation_transition_candidate.archive_consents from public,anon,authenticated,service_role;
create function affiliation_transition_candidate.confirm_archive(rid uuid,mid uuid,sh text) returns uuid
language plpgsql security invoker set search_path='' as $$
declare r affiliation_transition_candidate.requests; old affiliation_transition_candidate.archive_consents; sid uuid;
begin
 sid:=private.require_reauthentication_session();
 perform private.require_lifecycle_features(array['affiliation_switch','sko_id_linking','personal_pdf_vault']);
 select * into r from affiliation_transition_candidate.requests where request_id=rid for update;
 if not found or r.state<>'prepared' or r.expires_at<=clock_timestamp() then raise exception 'request_not_ready';end if;
 if auth.uid() is distinct from r.subject_id then raise sqlstate '42501' using message='subject_consent_required';end if;
 -- This existing reader locks the exact complete manifest and validates owner,
 -- source company/worker, transition request, snapshot and feature gate again.
 perform personal_vault24_candidate.assert_transition_ready(mid,r.subject_id,r.source_company_id,(r.plan->>'source_worker_id')::uuid,rid,sh);
 select * into old from affiliation_transition_candidate.archive_consents where request_id=rid for update;
 if found then
  if (old.subject_id,old.manifest_id,old.snapshot_hash) is distinct from (r.subject_id,mid,sh) then raise exception 'archive_consent_conflict';end if;
  return rid;
 end if;
 insert into affiliation_transition_candidate.archive_consents(request_id,subject_id,session_id,manifest_id,snapshot_hash) values(rid,r.subject_id,sid,mid,sh);
 return rid;
end $$;
revoke all on function affiliation_transition_candidate.confirm_archive(uuid,uuid,text) from public,anon,authenticated,service_role;
commit;
