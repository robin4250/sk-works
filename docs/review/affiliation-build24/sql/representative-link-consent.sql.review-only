-- Isolated continuation, no writes to existing membership or link tables.
begin;
create table affiliation_transition_candidate.authority_consents(
 request_id uuid primary key references affiliation_transition_candidate.requests(request_id) on delete restrict,
 approved_by uuid not null, session_id uuid not null, confirmed_at timestamptz not null default clock_timestamp());
create table affiliation_transition_candidate.link_receipts(
 request_id uuid primary key references affiliation_transition_candidate.requests(request_id) on delete restrict,
 link_request_id uuid not null, observed_by uuid not null, confirmed_at timestamptz not null default clock_timestamp());
alter table affiliation_transition_candidate.authority_consents enable row level security;
alter table affiliation_transition_candidate.link_receipts enable row level security;
revoke all on affiliation_transition_candidate.authority_consents,affiliation_transition_candidate.link_receipts from public,anon,authenticated,service_role;
create function affiliation_transition_candidate.confirm_target_authority(rid uuid) returns uuid
language plpgsql security invoker set search_path='' as $$
declare r affiliation_transition_candidate.requests;sid uuid;a uuid:=auth.uid();
begin
 sid:=private.require_reauthentication_session();
 perform private.require_lifecycle_features(array['affiliation_switch','sko_id_linking']);
 select * into r from affiliation_transition_candidate.requests where request_id=rid for update;
 if not found or r.state<>'prepared' or r.expires_at<=clock_timestamp() then raise exception 'request_not_ready';end if;
 -- Existing legal/identity evidence remains required; a company member cannot
 -- manufacture it. An unowned company requires a separate verified bootstrap.
 perform 1 from affiliation_transition_candidate.evidence where request_id=rid and kind='representative_authority' and plan=r.plan and valid_until>clock_timestamp() for share;
 if not found then raise exception 'verified_authority_required';end if;
 perform 1 from public.company_members where company_id=r.target_company_id and user_id=a and role::text='owner' for share;
 if not found then raise sqlstate '42501' using message='target_owner_required';end if;
 insert into affiliation_transition_candidate.authority_consents(request_id,approved_by,session_id) values(rid,a,sid) on conflict(request_id) do nothing;
 return rid;
end $$;
create function affiliation_transition_candidate.record_accepted_company_link(rid uuid,lid uuid) returns uuid
language plpgsql security invoker set search_path='' as $$
declare r affiliation_transition_candidate.requests;l private.trade_company_link_requests;old affiliation_transition_candidate.link_receipts;a uuid:=auth.uid();
begin
 perform private.require_reauthentication_session();
 perform private.require_lifecycle_features(array['affiliation_switch','sko_id_linking','partner_auto_link']);
 select * into r from affiliation_transition_candidate.requests where request_id=rid for update;
 if not found or r.state<>'prepared' or r.expires_at<=clock_timestamp() then raise exception 'request_not_ready';end if;
 if r.plan->'link_companies' is distinct from 'true'::jsonb then raise exception 'link_not_requested';end if;
 perform 1 from public.company_members where company_id=r.source_company_id and user_id=a and role::text in('owner','admin') for share;
 if not found then raise sqlstate '42501' using message='source_admin_required';end if;
 select * into l from private.trade_company_link_requests where id=lid for share;
 if not found or l.status<>'accepted' or l.responded_by is null or
 not ((l.sender_company_id=r.source_company_id and l.target_company_id=r.target_company_id) or
      (l.sender_company_id=r.target_company_id and l.target_company_id=r.source_company_id)) then raise exception 'accepted_company_link_required';end if;
 select * into old from affiliation_transition_candidate.link_receipts where request_id=rid;
 if found and old.link_request_id is distinct from lid then raise exception 'link_receipt_conflict';end if;
 insert into affiliation_transition_candidate.link_receipts(request_id,link_request_id,observed_by) values(rid,lid,a) on conflict(request_id) do nothing;
 return rid;
end $$;
revoke all on function affiliation_transition_candidate.confirm_target_authority(uuid),affiliation_transition_candidate.record_accepted_company_link(uuid,uuid) from public,anon,authenticated,service_role;
commit;
