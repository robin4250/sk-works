-- REVIEW ONLY. Not a migration or activation command. No production execution.
begin;
set local lock_timeout='5s';
do $prerequisite$ begin
 if not exists(select 1 from pg_proc where oid=to_regprocedure('private.require_reauthentication_session()')
  and md5(prosrc)='b5c8e2f259a99b3c69694ad0640080e5' and prosecdef and provolatile='v'
  and pg_get_userbyid(proowner)='postgres' and proconfig=array['search_path=""']::text[]
  and proacl::text='{postgres=X/postgres}') then raise exception 'Reviewed live-session prerequisite changed' using errcode='55000';end if;
end $prerequisite$;
create table private.partner_company_bank_rollout(singleton boolean primary key default true check(singleton),enabled boolean not null default false);
insert into private.partner_company_bank_rollout values(true,false);
create table private.partner_company_bank_versions(
 company_id uuid not null references public.companies(id) on delete restrict,
 partner_company_id uuid not null references public.partner_companies(id) on delete restrict,
 version integer not null check(version>0),request_id uuid not null,
 bank_fields jsonb not null,created_by uuid not null,session_id uuid not null,created_at timestamptz not null default clock_timestamp(),
 primary key(company_id,partner_company_id,version),unique(company_id,partner_company_id,request_id));
alter table private.partner_company_bank_rollout enable row level security;
alter table private.partner_company_bank_versions enable row level security;
revoke all on private.partner_company_bank_rollout,private.partner_company_bank_versions from public,anon,authenticated,service_role;

create function private.partner_company_bank_immutable() returns trigger language plpgsql set search_path='' as $$
begin raise exception 'Bank versions are immutable' using errcode='55000';end $$;
revoke all on function private.partner_company_bank_immutable() from public,anon,authenticated,service_role;
create trigger partner_company_bank_versions_immutable before update or delete on private.partner_company_bank_versions for each row execute function private.partner_company_bank_immutable();
create trigger partner_company_bank_versions_no_truncate before truncate on private.partner_company_bank_versions for each statement execute function private.partner_company_bank_immutable();

create function private.partner_company_bank_require_scope(p_company uuid,p_partner uuid) returns void
language plpgsql security definer set search_path='' as $$
declare uid uuid:=auth.uid();
begin
 if private.account_access_allowed() is distinct from true then raise exception 'Bank scope denied' using errcode='42501';end if;
 perform private.require_reauthentication_session();
 -- Same management contract as partner_payment_settings RLS/current_company_admin_id,
 -- scoped explicitly to the selected company instead of an arbitrary membership.
 perform 1 from public.company_members m where m.company_id=p_company and m.user_id=uid
  and m.role::text in ('owner','admin','manager') for share;
 if not found then raise exception 'Bank scope denied' using errcode='42501';end if;
 perform 1 from public.partner_companies p where p.id=p_partner and p.company_id=p_company and p.status='active' for share;
 if not found then raise exception 'Bank scope denied' using errcode='42501';end if;
end $$;
revoke all on function private.partner_company_bank_require_scope(uuid,uuid) from public,anon,authenticated,service_role;

create function private.partner_company_bank_snapshot(p_company uuid,p_partner uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare saved private.partner_company_bank_versions;
begin
 perform private.partner_company_bank_require_scope(p_company,p_partner);
 if not coalesce((select enabled from private.partner_company_bank_rollout where singleton),false) then return null;end if;
 select * into saved from private.partner_company_bank_versions where company_id=p_company and partner_company_id=p_partner order by version desc limit 1;
 if not found then return null;end if;
 return saved.bank_fields||jsonb_build_object('schema',1,'company_id',p_company,'partner_company_id',p_partner,'bank_version',saved.version);
end $$;
revoke all on function private.partner_company_bank_snapshot(uuid,uuid) from public,anon,authenticated,service_role;

create function public.partner_company_bank_read(p_company uuid,p_partner uuid) returns jsonb
language plpgsql security definer set search_path='' as $$
declare bank jsonb;
begin
 perform private.partner_company_bank_require_scope(p_company,p_partner);
 if not coalesce((select enabled from private.partner_company_bank_rollout where singleton),false) then
  return jsonb_build_object('available',false,'company_id',p_company,'partner_company_id',p_partner,'version',0,'bank',null);end if;
 bank:=private.partner_company_bank_snapshot(p_company,p_partner);
 return jsonb_build_object('available',true,'company_id',p_company,'partner_company_id',p_partner,'version',coalesce((bank->>'bank_version')::integer,0),'bank',bank);
end $$;
revoke all on function public.partner_company_bank_read(uuid,uuid) from public,anon,service_role;
grant execute on function public.partner_company_bank_read(uuid,uuid) to authenticated;

create function public.save_partner_company_bank(p_company uuid,p_partner uuid,p_expected_version integer,p_request uuid,p_bank jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare latest integer; receipt private.partner_company_bank_versions; key text;
begin
 perform private.partner_company_bank_require_scope(p_company,p_partner);
 if not coalesce((select enabled from private.partner_company_bank_rollout where singleton),false) then raise exception 'Bank registration is not released' using errcode='55000';end if;
 if p_request is null or p_expected_version is null or p_expected_version<0 or p_expected_version>=2147483647 or jsonb_typeof(p_bank) is distinct from 'object'
  or octet_length(p_bank::text)>4096 or (select count(*) from jsonb_object_keys(p_bank))<>5
  or not (p_bank ?& array['bank_name','branch_name','account_type','account_number','account_holder']) then raise exception 'Invalid bank fields' using errcode='22023';end if;
 foreach key in array array['bank_name','branch_name','account_type','account_number','account_holder'] loop
  if jsonb_typeof(p_bank->key) is distinct from 'string' or length(btrim(p_bank->>key))=0 or p_bank->>key<>btrim(p_bank->>key)
   or length(p_bank->>key)>(case when key='account_holder' then 120 else 100 end)
   or p_bank->>key ~ '[[:cntrl:]]' then raise exception 'Invalid bank fields' using errcode='22023';end if;
 end loop;
 if p_bank->>'account_type' not in ('普通','当座','貯蓄') or p_bank->>'account_number' !~ '^[0-9]{7}$' then raise exception 'Invalid bank fields' using errcode='22023';end if;
 perform pg_advisory_xact_lock(hashtextextended('partner-bank:'||p_company::text||':'||p_partner::text,0));
 select * into receipt from private.partner_company_bank_versions where company_id=p_company and partner_company_id=p_partner and request_id=p_request;
 if found then
  if receipt.created_by<>auth.uid() or receipt.session_id<>(auth.jwt()->>'session_id')::uuid or receipt.version<>p_expected_version+1 or receipt.bank_fields<>p_bank then raise exception 'Request is already bound' using errcode='40001';end if;
  return receipt.bank_fields||jsonb_build_object('schema',1,'company_id',p_company,'partner_company_id',p_partner,'bank_version',receipt.version);
 end if;
 select coalesce(max(version),0) into latest from private.partner_company_bank_versions where company_id=p_company and partner_company_id=p_partner;
 if latest<>p_expected_version then raise exception 'Bank version changed' using errcode='40001';end if;
 perform private.partner_company_bank_require_scope(p_company,p_partner);
 insert into private.partner_company_bank_versions(company_id,partner_company_id,version,request_id,bank_fields,created_by,session_id)
 values(p_company,p_partner,latest+1,p_request,p_bank,auth.uid(),(auth.jwt()->>'session_id')::uuid);
 return p_bank||jsonb_build_object('schema',1,'company_id',p_company,'partner_company_id',p_partner,'bank_version',latest+1);
end $$;
revoke all on function public.save_partner_company_bank(uuid,uuid,integer,uuid,jsonb) from public,anon,service_role;
grant execute on function public.save_partner_company_bank(uuid,uuid,integer,uuid,jsonb) to authenticated;
commit;
