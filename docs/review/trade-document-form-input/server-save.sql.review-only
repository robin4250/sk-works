-- REVIEW ONLY: apply only after exact confirmed-terms guard. No production apply.
begin;
set local lock_timeout='5s';
do $pin$ declare src record;delegate record;begin
 select * into src from pg_proc where oid=to_regprocedure('private.trade_document_source(text,uuid,text)');
 select * into delegate from pg_proc where oid=to_regprocedure('private.save_trade_document_before_confirmed_terms(text,uuid,text,integer,jsonb)');
 if not coalesce((md5(src.prosrc)='ebcc70935938482054943560390038b2' and md5(delegate.prosrc)='82fa37936aea1e0199e1b359e1379d65')
  or (md5(src.prosrc)='1f877168bc5767b2efb6946a19c3d198' and md5(delegate.prosrc)='b7711fe5caf45cf8afabc39856a86a0e'),false)
  or not src.prosecdef or not delegate.prosecdef or src.provolatile<>'v' or delegate.provolatile<>'v'
  or pg_get_userbyid(src.proowner)<>'postgres' or pg_get_userbyid(delegate.proowner)<>'postgres'
  or src.proconfig is distinct from array['search_path=""'] or delegate.proconfig is distinct from array['search_path=""']
  or src.proacl::text is distinct from '{postgres=X/postgres}' or delegate.proacl::text is distinct from '{postgres=X/postgres}' then
  raise exception 'Source/delegate predecessor changed' using errcode='55000';end if;
 if not exists(select 1 from pg_proc where oid=to_regprocedure('private.save_trade_document_attachment(text,uuid,text,integer,jsonb)')
  and md5(prosrc)='04501fda2c30a17257142dc02fc87b6d' and prosecdef and provolatile='v'
  and pg_get_userbyid(proowner)='postgres' and proconfig=array['search_path=""']::text[]
  and proacl::text='{postgres=X/postgres,authenticated=X/postgres}')
  or to_regprocedure('private.save_trade_document_before_form_fields(text,uuid,text,integer,jsonb)') is not null
  or to_regprocedure('private.validate_trade_document_form_fields(jsonb)') is not null then
  raise exception 'Exact confirmed-terms predecessor required' using errcode='55000';end if;
end $pin$;
create function private.validate_trade_document_form_fields(v jsonb) returns void
language plpgsql immutable security invoker set search_path='' as $$
declare k text;r jsonb;p jsonb;t text;n numeric;limit_length integer;
begin
 if jsonb_typeof(v) is distinct from 'object' or (select count(*) from jsonb_object_keys(v))<>14
  or v-array['schema','work_content','issuer_phone','issuer_fax','payments','progress_cutoff_day','invoice_cutoff_day','payment_day','payment_month_offset','cash_ratio_percent','bill_ratio_percent','bill_months','supplies','rows']<>'{}'::jsonb
  or v->>'schema' is distinct from '1' or jsonb_typeof(v->'schema') is distinct from 'number' then
  raise exception 'Invalid form schema' using errcode='22023';end if;
 foreach k in array array['work_content','issuer_phone','issuer_fax','supplies'] loop
  limit_length:=case k when 'work_content' then 240 when 'supplies' then 400 else 40 end;
  if jsonb_typeof(v->k) is distinct from 'string' or char_length(v->>k)>limit_length
   or (v->>k)~'[\x01-\x08\x0b\x0c\x0e-\x1f\x7f]' or (k in ('issuer_phone','issuer_fax') and (v->>k)~'[\r\n\t]') then
   raise exception 'Invalid form text' using errcode='22023';end if;
 end loop;
 foreach k in array array['progress_cutoff_day','invoice_cutoff_day','payment_day','payment_month_offset','bill_months'] loop
  if v->k<>'null'::jsonb then
   if jsonb_typeof(v->k) is distinct from 'number' or (v->>k)!~'^(0|[1-9][0-9]{0,9})$' then raise exception 'Invalid form integer' using errcode='22023';end if;
   n:=(v->>k)::numeric;
   if n<(case when k in ('payment_month_offset','bill_months') then 0 else 1 end)
    or n>(case k when 'payment_month_offset' then 2 when 'bill_months' then 120 else 31 end) then raise exception 'Invalid form integer range' using errcode='22023';end if;
  end if;
 end loop;
 foreach k in array array['cash_ratio_percent','bill_ratio_percent'] loop
  if v->k<>'null'::jsonb then
   if jsonb_typeof(v->k) is distinct from 'string' or (v->>k)!~'^[0-9]{1,3}(\.[0-9]{1,2})?$' then raise exception 'Invalid form percentage' using errcode='22023';end if;
   if (v->>k)::numeric>100 then raise exception 'Invalid form percentage range' using errcode='22023';end if;
  end if;
 end loop;
 p:=v->'payments';
 if jsonb_typeof(p) is distinct from 'object' or (select count(*) from jsonb_object_keys(p))<>3 or p-array['advance','partial','completion']<>'{}'::jsonb then raise exception 'Invalid form payments' using errcode='22023';end if;
 foreach k in array array['advance','partial','completion'] loop
  r:=p->k;
  if jsonb_typeof(r) is distinct from 'object' or (select count(*) from jsonb_object_keys(r))<>3 or r-array['choice','date','amount_yen']<>'{}'::jsonb
   or jsonb_typeof(r->'choice') is distinct from 'string' or (r->>'choice') not in ('unspecified','yes','no') then raise exception 'Invalid payment choice' using errcode='22023';end if;
  if r->'date'<>'null'::jsonb then
   t:=r->>'date';
   if jsonb_typeof(r->'date') is distinct from 'string' or t!~'^[0-9]{4}-[0-9]{2}-[0-9]{2}$' then raise exception 'Invalid payment date' using errcode='22023';end if;
   begin if to_char(t::date,'YYYY-MM-DD')<>t then raise exception 'Invalid payment date' using errcode='22023';end if;
   exception when invalid_datetime_format or datetime_field_overflow then raise exception 'Invalid payment date' using errcode='22023';end;
  end if;
  if r->'amount_yen'<>'null'::jsonb then
   if jsonb_typeof(r->'amount_yen') is distinct from 'number' or (r->>'amount_yen')!~'^(0|[1-9][0-9]{0,9})$' then raise exception 'Invalid payment amount' using errcode='22023';end if;
   if (r->>'amount_yen')::numeric>2147483647 then raise exception 'Invalid payment amount range' using errcode='22023';end if;
  end if;
  if r->>'choice'='no' and (r->'date'<>'null'::jsonb or r->'amount_yen'<>'null'::jsonb) then raise exception 'No payment cannot retain date or money' using errcode='22023';end if;
 end loop;
 if jsonb_typeof(v->'rows') is distinct from 'array' or jsonb_array_length(v->'rows')<>9 then raise exception 'Exactly nine rows required' using errcode='22023';end if;
 for r in select value from jsonb_array_elements(v->'rows') loop
  if jsonb_typeof(r) is distinct from 'object' or (select count(*) from jsonb_object_keys(r))<>6 or r-array['item','quantity','unit','unit_price_yen','amount_yen','note']<>'{}'::jsonb then raise exception 'Invalid form row' using errcode='22023';end if;
  foreach k in array array['item','quantity','unit','note'] loop
   limit_length:=case k when 'item' then 120 when 'note' then 80 else 16 end;
   if jsonb_typeof(r->k) is distinct from 'string' or char_length(r->>k)>limit_length or (r->>k)~'[\x01-\x08\x0b\x0c\x0e-\x1f\x7f]'
    or (k in ('quantity','unit') and (r->>k)~'[\r\n\t]') then raise exception 'Invalid row text' using errcode='22023';end if;
  end loop;
  if r->>'quantity'<>'' and (r->>'quantity')!~'^[0-9]+(\.[0-9]{1,3})?$' then raise exception 'Invalid row quantity' using errcode='22023';end if;
  foreach k in array array['unit_price_yen','amount_yen'] loop
   if r->k<>'null'::jsonb then
    if jsonb_typeof(r->k) is distinct from 'number' or (r->>k)!~'^(0|[1-9][0-9]{0,9})$' then raise exception 'Invalid row amount' using errcode='22023';end if;
    if (r->>k)::numeric>2147483647 then raise exception 'Invalid row amount range' using errcode='22023';end if;
   end if;
  end loop;
 end loop;
end $$;
revoke all on function private.validate_trade_document_form_fields(jsonb) from public,anon,authenticated,service_role;
alter function private.save_trade_document_attachment(text,uuid,text,integer,jsonb) rename to save_trade_document_before_form_fields;
revoke all on function private.save_trade_document_before_form_fields(text,uuid,text,integer,jsonb) from authenticated;
create function private.save_trade_document_attachment(p_kind text,p_subject uuid,p_source_revision text,p_expected_version integer,p_payload jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare source jsonb;saved private.trade_document_attachments;partner uuid;
begin
 perform pg_advisory_xact_lock(hashtextextended('trade-appendix:'||p_kind||':'||p_subject::text,0));
 source:=private.trade_document_source(p_kind,p_subject,p_source_revision);
 if source->>'can_manage' is distinct from 'true' then raise exception 'Management permission required' using errcode='42501';end if;
 select * into saved from private.trade_document_attachments where subject_kind=p_kind and subject_id=p_subject and company_id=(source->>'company_id')::uuid for update;
 if saved.subject_id is not null and (saved.source_fingerprint is distinct from source->>'source_fingerprint' or to_char(saved.month,'YYYY-MM') is distinct from source->>'month') then
  if p_kind<>'payment_certificate' or saved.payload->'counterparty_bank' is null or saved.payload->'counterparty_bank'='null'::jsonb then
   raise exception 'Historical counterparty binding cannot be established' using errcode='40001';end if;
 end if;
 if saved.subject_id is not null and p_kind='payment_certificate' and saved.payload->'counterparty_bank' is not null and saved.payload->'counterparty_bank'<>'null'::jsonb then
  select partner_company_id into partner from public.payment_certificates where id=p_subject and company_id=(source->>'company_id')::uuid for share;
  if partner is null or saved.payload#>>'{counterparty_bank,company_id}' is distinct from source->>'company_id'
   or saved.payload#>>'{counterparty_bank,partner_company_id}' is distinct from partner::text then raise exception 'Saved bank counterparty changed' using errcode='40001';end if;
 end if;
 if saved.subject_id is not null and saved.payload ? 'form_fields' and not (p_payload ? 'form_fields') then
  raise exception 'Saved input namespace cannot be removed' using errcode='40001';end if;
 if jsonb_typeof(p_payload) is distinct from 'object' or octet_length(p_payload::text)>16384 then
  raise exception 'Input payload exceeds the existing byte bound' using errcode='22023';end if;
 if p_payload ? 'form_fields' then
  if not (p_payload ? 'contract_terms') then raise exception 'Explicit adopted contract required' using errcode='22023';end if;
  perform private.validate_trade_document_form_fields(p_payload->'form_fields');
 end if;
 return private.save_trade_document_before_form_fields(p_kind,p_subject,p_source_revision,p_expected_version,p_payload);
end $$;
revoke all on function private.save_trade_document_attachment(text,uuid,text,integer,jsonb) from public,anon,service_role;
grant execute on function private.save_trade_document_attachment(text,uuid,text,integer,jsonb) to authenticated;
do $result$ begin
 if not exists(select 1 from pg_proc where oid=to_regprocedure('private.save_trade_document_attachment(text,uuid,text,integer,jsonb)') and md5(prosrc)='7a998158bcc2cc6da7c2f31c21559404' and prosecdef and provolatile='v' and pg_get_userbyid(proowner)='postgres' and proconfig=array['search_path=""']::text[] and proacl::text='{postgres=X/postgres,authenticated=X/postgres}')
  or not exists(select 1 from pg_proc where oid=to_regprocedure('private.validate_trade_document_form_fields(jsonb)') and md5(prosrc)='940f73c7301d47204382bed1aa92ea4e' and not prosecdef and provolatile='i' and pg_get_userbyid(proowner)='postgres' and proconfig=array['search_path=""']::text[] and proacl::text='{postgres=X/postgres}')
  or not exists(select 1 from pg_proc where oid=to_regprocedure('private.save_trade_document_before_form_fields(text,uuid,text,integer,jsonb)') and md5(prosrc)='04501fda2c30a17257142dc02fc87b6d' and prosecdef and provolatile='v' and pg_get_userbyid(proowner)='postgres' and proconfig=array['search_path=""']::text[] and proacl::text='{postgres=X/postgres}') then
  raise exception 'Form guard result definitions/attributes changed' using errcode='55000';end if;
end $result$;
commit;
