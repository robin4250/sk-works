-- REVIEW ONLY. Requires the reviewed v1 form guard installation first.
-- Production currently has no v1 validator; this file does not create it blindly.
begin;
set local lock_timeout='5s';set local statement_timeout='30s';
create temporary table trade_form_upgrade_attributes on commit drop as
 select p.oid,to_jsonb(p)-'prosrc' attributes from pg_proc p where p.oid in (
 'private.validate_trade_document_form_fields(jsonb)'::regprocedure,
 'private.partner_company_profile_value(uuid)'::regprocedure,
 'private.trade_document_source(text,uuid,text)'::regprocedure,
 to_regprocedure('private.trade_document_source_before_partner_bank(text,uuid,text)'),
 'private.save_trade_document_attachment(text,uuid,text,integer,jsonb)'::regprocedure);
do $$begin if exists(select 1 from (values ('private.save_trade_document_attachment(text,uuid,text,integer,jsonb)'::regprocedure,'7a998158bcc2cc6da7c2f31c21559404'),('private.validate_trade_document_form_fields(jsonb)'::regprocedure,'940f73c7301d47204382bed1aa92ea4e'),('private.partner_company_profile_value(uuid)'::regprocedure,'06ce79748602c8ca5aebda226bc7f742')) expected(oid,hash) left join pg_proc p on p.oid=expected.oid where p.oid is null or md5(p.prosrc)<>expected.hash) then raise exception 'Form v1/contact source changed';end if;
if not (exists(select 1 from pg_proc where oid='private.trade_document_source(text,uuid,text)'::regprocedure and md5(prosrc)='ebcc70935938482054943560390038b2') or (exists(select 1 from pg_proc where oid='private.trade_document_source(text,uuid,text)'::regprocedure and md5(prosrc)='1f877168bc5767b2efb6946a19c3d198') and exists(select 1 from pg_proc where oid=to_regprocedure('private.trade_document_source_before_partner_bank(text,uuid,text)') and md5(prosrc)='ebcc70935938482054943560390038b2'))) then raise exception 'Form source predecessor changed';end if;end $$;
do $attributes$
begin
 if exists(select 1 from trade_form_upgrade_attributes a join pg_proc p on p.oid=a.oid
  where pg_get_userbyid(p.proowner)<>'postgres' or p.proconfig is distinct from array['search_path=""']::text[]
   or p.prosecdef is distinct from (p.proname<>'validate_trade_document_form_fields')
   or p.provolatile is distinct from (case p.proname when 'validate_trade_document_form_fields' then 'i' when 'partner_company_profile_value' then 's' else 'v' end)::"char"
   or p.proacl::text is distinct from (case p.proname when 'save_trade_document_attachment' then '{postgres=X/postgres,authenticated=X/postgres}' else '{postgres=X/postgres}' end)) then
  raise exception 'Form/contact owner, permissions or attributes changed' using errcode='55000';
 end if;
end $attributes$;
create or replace function private.validate_trade_document_form_fields(v jsonb) returns void
language plpgsql immutable security invoker set search_path='' as $$
declare k text;r jsonb;p jsonb;t text;n numeric;limit_length integer;
begin
 if jsonb_typeof(v) is distinct from 'object' or jsonb_typeof(v->'schema') is distinct from 'number'
  or v->>'schema' not in ('1','2')
  or (v->>'schema'='1' and ((select count(*) from jsonb_object_keys(v))<>14 or v-array['schema','work_content','issuer_phone','issuer_fax','payments','progress_cutoff_day','invoice_cutoff_day','payment_day','payment_month_offset','cash_ratio_percent','bill_ratio_percent','bill_months','supplies','rows']<>'{}'::jsonb))
  or (v->>'schema'='2' and ((select count(*) from jsonb_object_keys(v))<>16 or v-array['schema','work_content','issuer_phone','issuer_fax','payments','progress_cutoff_day','invoice_cutoff_day','payment_day','payment_month_offset','cash_ratio_percent','bill_ratio_percent','bill_months','supplies','rows','issuer_representative_title','amount_description']<>'{}'::jsonb)) then
  raise exception 'Invalid form schema' using errcode='22023';end if;
 if v->>'schema'='2' then
  foreach k in array array['issuer_representative_title','amount_description'] loop
   if jsonb_typeof(v->k) is distinct from 'string' or char_length(v->>k)>(case k when 'issuer_representative_title' then 32 else 240 end) or (v->>k)~'[\x01-\x1f\x7f]' then raise exception 'Invalid form label' using errcode='22023';end if;
  end loop;
 end if;
 foreach k in array array['work_content','issuer_phone','issuer_fax','supplies'] loop
  limit_length:=case k when 'work_content' then 240 when 'supplies' then 400 else 40 end;
  if jsonb_typeof(v->k) is distinct from 'string' or char_length(v->>k)>limit_length
   or (v->>k)~'[\x01-\x08\x0b\x0c\x0e-\x1f\x7f]' or (k in ('issuer_phone','issuer_fax') and (v->>k)~'[\r\n\t]') then
   raise exception 'Invalid form text' using errcode='22023';end if;
 end loop;
 foreach k in array array['progress_cutoff_day','invoice_cutoff_day','payment_day','payment_month_offset','bill_months'] loop
  if k='progress_cutoff_day' and v->>'schema'='2' and v->k='"month_end"'::jsonb then continue;end if;
  if v->k<>'null'::jsonb then
   if jsonb_typeof(v->k) is distinct from 'number' or (v->>k)!~'^(0|[1-9][0-9]{0,9})$' then raise exception 'Invalid form integer' using errcode='22023';end if;
   n:=(v->>k)::numeric;
   if n<(case when k in ('payment_month_offset','bill_months') then 0 else 1 end)
    or n>(case k when 'payment_month_offset' then 2 when 'bill_months' then 120 else 31 end) then raise exception 'Invalid form integer range' using errcode='22023';end if;
  end if;
 end loop;
 foreach k in array array['cash_ratio_percent','bill_ratio_percent'] loop
  if v->k<>'null'::jsonb then
   if jsonb_typeof(v->k) is distinct from 'string' or (v->>k)!~'^[0-9]{1,3}(\.[0-9]{1,2})?$' then raise exception 'Invalid form percentage' using errcode='22023';end if;
   if (v->>k)::numeric>100 then raise exception 'Invalid form percentage range' using errcode='22023';end if;
  end if;
 end loop;
 p:=v->'payments';
 if jsonb_typeof(p) is distinct from 'object' or (select count(*) from jsonb_object_keys(p))<>3 or p-array['advance','partial','completion']<>'{}'::jsonb then raise exception 'Invalid form payments' using errcode='22023';end if;
 foreach k in array array['advance','partial','completion'] loop
  r:=p->k;
  if jsonb_typeof(r) is distinct from 'object' or (select count(*) from jsonb_object_keys(r))<>3 or r-array['choice','date','amount_yen']<>'{}'::jsonb
   or jsonb_typeof(r->'choice') is distinct from 'string' or (r->>'choice') not in ('unspecified','yes','no') then raise exception 'Invalid payment choice' using errcode='22023';end if;
  if r->'date'<>'null'::jsonb then
   t:=r->>'date';
   if jsonb_typeof(r->'date') is distinct from 'string' or t!~'^[0-9]{4}-[0-9]{2}-[0-9]{2}$' then raise exception 'Invalid payment date' using errcode='22023';end if;
   begin if to_char(t::date,'YYYY-MM-DD')<>t then raise exception 'Invalid payment date' using errcode='22023';end if;
   exception when invalid_datetime_format or datetime_field_overflow then raise exception 'Invalid payment date' using errcode='22023';end;
  end if;
  if r->'amount_yen'<>'null'::jsonb then
   if jsonb_typeof(r->'amount_yen') is distinct from 'number' or (r->>'amount_yen')!~'^(0|[1-9][0-9]{0,9})$' then raise exception 'Invalid payment amount' using errcode='22023';end if;
   if (r->>'amount_yen')::numeric>2147483647 then raise exception 'Invalid payment amount range' using errcode='22023';end if;
  end if;
  if r->>'choice'='no' and (r->'date'<>'null'::jsonb or r->'amount_yen'<>'null'::jsonb) then raise exception 'No payment cannot retain date or money' using errcode='22023';end if;
 end loop;
 if jsonb_typeof(v->'rows') is distinct from 'array' or jsonb_array_length(v->'rows')<>9 then raise exception 'Exactly nine rows required' using errcode='22023';end if;
 for r in select value from jsonb_array_elements(v->'rows') loop
  if jsonb_typeof(r) is distinct from 'object' or (select count(*) from jsonb_object_keys(r))<>6 or r-array['item','quantity','unit','unit_price_yen','amount_yen','note']<>'{}'::jsonb then raise exception 'Invalid form row' using errcode='22023';end if;
  foreach k in array array['item','quantity','unit','note'] loop
   limit_length:=case k when 'item' then 120 when 'note' then 80 else 16 end;
   if jsonb_typeof(r->k) is distinct from 'string' or char_length(r->>k)>limit_length or (r->>k)~'[\x01-\x08\x0b\x0c\x0e-\x1f\x7f]'
    or (k in ('quantity','unit') and (r->>k)~'[\r\n\t]') then raise exception 'Invalid row text' using errcode='22023';end if;
  end loop;
  if r->>'quantity'<>'' and (r->>'quantity')!~'^[0-9]+(\.[0-9]{1,3})?$' then raise exception 'Invalid row quantity' using errcode='22023';end if;
  foreach k in array array['unit_price_yen','amount_yen'] loop
   if r->k<>'null'::jsonb then
    if jsonb_typeof(r->k) is distinct from 'number' or (r->>k)!~'^(0|[1-9][0-9]{0,9})$' then raise exception 'Invalid row amount' using errcode='22023';end if;
    if (r->>k)::numeric>2147483647 then raise exception 'Invalid row amount range' using errcode='22023';end if;
   end if;
  end loop;
 end loop;
end $$;
CREATE OR REPLACE FUNCTION private.partner_company_profile_value(p_company_id uuid)
 RETURNS jsonb
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 select jsonb_build_object('name',c.name,'address',c.address,'phone',c.phone,'fax',coalesce(to_jsonb(c)->>'fax',''),
 'email',c.email,'corporate_number',c.corporate_number,
 'representative_name',e.representative_name)
 from public.companies c left join private.partner_company_profile_extensions e on e.company_id=c.id
 where c.id=p_company_id
$function$;
do $install_source$
declare definition text := $source_definition$
CREATE OR REPLACE FUNCTION private.trade_document_source(p_kind text, p_subject uuid, p_source_revision text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
declare cid uuid; counter_id uuid; start_day date; end_day date; rev text; st text;
 final_at timestamptz; is_blocked boolean; extra_locked boolean:=false; total bigint; tax bigint; source_snapshot jsonb; counter jsonb;
 company public.companies; role_name text; can_read boolean; can_manage boolean; result jsonb; directory_count bigint; directory_role text; directory_address text; directory_corporate text; directory_representative text;
begin
 if auth.uid() is null or not private.account_access_allowed() then
  raise exception 'ログインが必要です。' using errcode='42501'; end if;
 if p_kind='payment_certificate' then
  select company_id,partner_company_id,period_start,period_end,revision::text,status,finalized_at,gross_amount,snapshot,calculation_blocked
  into cid,counter_id,start_day,end_day,rev,st,final_at,total,source_snapshot,is_blocked
  from public.payment_certificates where id=p_subject for share;
 elsif p_kind='invoice' then
  select company_id,customer_id,billing_period_start,billing_period_end,updated_at::text,status,finalized_at,grand_total,invoices.tax,snapshot,calculation_blocked,(approval_finalized_at is not null or invoice_seal_frozen)
  into cid,counter_id,start_day,end_day,rev,st,final_at,total,tax,source_snapshot,is_blocked,extra_locked
  from public.invoices where id=p_subject for share;
 else raise exception '書類の種類を確認してください。' using errcode='22023'; end if;
 select role::text into role_name from public.company_members where company_id=cid and user_id=auth.uid();
 if p_kind='invoice' then
  can_read:=coalesce(private.has_company_feature(cid,'can_view_invoices'),false);
  can_manage:=coalesce(private.has_company_feature(cid,'can_manage_invoices'),false);
 else
  can_read:=coalesce(role_name in ('owner','admin','manager'),false);
  can_manage:=coalesce(role_name in ('owner','admin'),false);
 end if;
 if cid is null or role_name is null or not can_read then
  raise exception '書類の閲覧権限がありません。' using errcode='42501'; end if;
 if (p_kind='invoice' and rev::timestamptz is distinct from p_source_revision::timestamptz)
 or (p_kind='payment_certificate' and rev is distinct from p_source_revision) then
  raise exception '元の帳票が更新されています。開き直してください。' using errcode='40001'; end if;
 if start_day is null or end_day is null or date_trunc('month',start_day)<>date_trunc('month',end_day) then
  raise exception '同じ対象月の帳票が必要です。' using errcode='22023'; end if;
 select * into company from public.companies where id=cid for share;
 if p_kind='payment_certificate' then
  select jsonb_build_object('name',name,'address',coalesce(address,''),'corporate_number','',
    'representative_name',coalesce(president_name,'')) into counter
  from public.partner_companies where id=counter_id and company_id=cid;
  if jsonb_typeof(source_snapshot->'tax')='number' then tax:=(source_snapshot->>'tax')::bigint; end if;
 else
  select jsonb_build_object('name',coalesce(nullif(billing_name,''),name),'address',coalesce(billing_address,''),
    'corporate_number','','representative_name','') into counter
  from public.customers where id=counter_id and company_id=cid;
 end if;
 if counter is null then raise exception '相手先の会社を確認できません。' using errcode='22023'; end if;
 result:=jsonb_build_object('company_id',cid,'source_revision',rev,
  'source_fingerprint',md5(jsonb_build_object('company',cid,'counterparty',counter_id,'start',start_day,'end',end_day,'total',total,'tax',tax,'snapshot',case when p_kind='invoice' then source_snapshot-'company_seal_snapshot' else source_snapshot end)::text),'month',to_char(start_day,'YYYY-MM'),
  'can_manage',can_manage,'template_can_view',case when p_kind='invoice' then can_manage else can_read end,'source_blocked',coalesce(is_blocked,false),'source_locked',st<>'draft' or final_at is not null or coalesce(extra_locked,false),
  'defaults',jsonb_build_object('version',1,'kind',case when p_kind='invoice' then 'acceptance' else 'order' end,
   'month',to_char(start_day,'YYYY-MM'),'period_start',date_trunc('month',start_day)::date,
   'period_end',(date_trunc('month',start_day)+interval '1 month - 1 day')::date,
   'total_amount_yen',total,'tax_amount_yen',tax,
   'issuer',jsonb_build_object('name',company.name,'address',coalesce(company.address,''),
     'corporate_number',coalesce(company.corporate_number,''),'representative_name',''),
   'counterparty',counter,'company_seal_snapshot',private.document_company_seal_snapshot(null,cid,true)->'company_seal_snapshot',
   'company_seal_enabled',company.company_seal_enabled));

 -- Use an explicit saved calculation line only; never infer tax from a rate.
 IF p_kind='payment_certificate' AND tax IS NULL
    AND jsonb_typeof(source_snapshot->'calculation_rows')='array' THEN
   SELECT CASE WHEN count(*)=1 THEN max(
     CASE WHEN jsonb_typeof(item->'amount_yen')='number'
        AND (item->>'amount_yen') ~ '^[0-9]{1,10}$'
     THEN CASE WHEN (item->>'amount_yen')::numeric <= 2147483647
          THEN (item->>'amount_yen')::bigint END END) END INTO tax
   FROM jsonb_array_elements(source_snapshot->'calculation_rows') item
   WHERE regexp_replace(coalesce(item->>'work_content',''),'[（）()[:space:]]','','g')
         ~ '^消費税([0-9]+([.,][0-9]+)?[%％])?$';
   IF tax IS NOT NULL THEN
     result := jsonb_set(result,'{defaults,tax_amount_yen}',to_jsonb(tax));
   END IF;
 END IF;
 -- Same-company registered directory only. Never derive a relationship from a name.
 -- Managers retain the original payment-reader output: directory contact is admin-only.
 -- A saved appendix stays independent of later directory edits or ambiguity.
 if p_kind='payment_certificate' and can_manage and not exists(
   select 1 from private.trade_document_attachments a
   where a.subject_kind=p_kind and a.subject_id=p_subject and a.company_id=cid
 ) then
   select count(*),min(t.trade_role),min(t.address),min(t.corporate_number),min(t.representative_name)
     into directory_count,directory_role,directory_address,directory_corporate,directory_representative
   from public.trade_companies t
   where t.company_id=cid and t.partner_company_id=counter_id;
   -- Missing, ambiguous or wrong-role mapping refuses enrichment, not the document.
   if directory_count=1 and coalesce(directory_role in ('subcontractor','both'),false) then
     result:=jsonb_set(result,'{defaults,counterparty}',
       (result->'defaults'->'counterparty')||jsonb_build_object(
         -- Match existing save_trade_document_attachment normalization limits per field.
         'address',case when length(btrim(directory_address)) between 1 and 240
           then btrim(directory_address) else coalesce(counter->>'address','') end,
         'corporate_number',case when btrim(directory_corporate) ~ '^[0-9]{13}$'
           then btrim(directory_corporate) else coalesce(counter->>'corporate_number','') end,
         'representative_name',case when length(btrim(directory_representative)) between 1 and 80
           then btrim(directory_representative) else coalesce(counter->>'representative_name','') end));
   end if;
 end if;

 -- Own issuer only; directory counterparty enrichment above stays unchanged.
 if p_kind='payment_certificate' and can_manage and not exists(
  select 1 from private.trade_document_attachments a
  where a.subject_kind=p_kind and a.subject_id=p_subject and a.company_id=cid
 ) then
  result:=jsonb_set(result,'{defaults,issuer,representative_name}',coalesce((
   select to_jsonb(e.representative_name)
   from private.partner_company_profile_extensions e
   where e.company_id=cid and length(e.representative_name) between 1 and 80
  ),result#>'{defaults,issuer,representative_name}'));
 end if;

 -- Invoice-only missing party details: never replace a saved child or write the parent invoice.
 if p_kind='invoice' and can_manage
 and not exists(select 1 from private.trade_document_attachments a
   where a.subject_kind=p_kind and a.subject_id=p_subject and a.company_id=cid) then
  result:=jsonb_set(result,'{defaults,issuer,representative_name}',coalesce((
   select to_jsonb(btrim(e.representative_name))
   from private.partner_company_profile_extensions e
   where e.company_id=cid and length(btrim(e.representative_name)) between 1 and 80
  ),result#>'{defaults,issuer,representative_name}'));
  select count(*),min(t.trade_role),min(t.address),min(t.corporate_number),min(t.representative_name)
    into directory_count,directory_role,directory_address,directory_corporate,directory_representative
  from public.trade_companies t where t.company_id=cid and t.customer_id=counter_id;
  if directory_count=1 and coalesce(directory_role in ('customer','both'),false) then
   result:=jsonb_set(result,'{defaults,counterparty}',
    (result->'defaults'->'counterparty')||jsonb_build_object(
     'address',case when length(btrim(directory_address)) between 1 and 240
       then btrim(directory_address) else coalesce(counter->>'address','') end,
     'corporate_number',case when btrim(directory_corporate) ~ '^[0-9]{13}$'
       then btrim(directory_corporate) else coalesce(counter->>'corporate_number','') end,
     'representative_name',case when length(btrim(directory_representative)) between 1 and 80
       then btrim(directory_representative) else coalesce(counter->>'representative_name','') end));
  end if;
 end if;
 -- Capability and registered contacts are authoritative defaults only.
 -- Existing saved attachment payloads, terms, identity and source hash stay unchanged.
 result:=result||jsonb_build_object('form_fields_schema_version',2);
 result:=jsonb_set(result,'{defaults,issuer}',(result#>'{defaults,issuer}')||jsonb_build_object(
  'phone',coalesce(to_jsonb(company)->>'phone',''),'fax',coalesce(to_jsonb(company)->>'fax','')));
 return result;
end $function$;
$source_definition$;
begin
 if exists(select 1 from pg_proc where oid='private.trade_document_source(text,uuid,text)'::regprocedure and md5(prosrc)='1f877168bc5767b2efb6946a19c3d198') then
  definition:=replace(definition,'FUNCTION private.trade_document_source(', 'FUNCTION private.trade_document_source_before_partner_bank(');
 end if;
 execute definition;
end $install_source$;
create or replace function private.save_trade_document_attachment(p_kind text,p_subject uuid,p_source_revision text,p_expected_version integer,p_payload jsonb) returns jsonb
language plpgsql security definer set search_path='' as $$
declare source jsonb;saved private.trade_document_attachments;partner uuid;
begin
 perform pg_advisory_xact_lock(hashtextextended('trade-appendix:'||p_kind||':'||p_subject::text,0));
 source:=private.trade_document_source(p_kind,p_subject,p_source_revision);
 if source->>'can_manage' is distinct from 'true' then raise exception 'Management permission required' using errcode='42501';end if;
 select * into saved from private.trade_document_attachments where subject_kind=p_kind and subject_id=p_subject and company_id=(source->>'company_id')::uuid for update;
 if saved.subject_id is not null and (saved.source_fingerprint is distinct from source->>'source_fingerprint' or to_char(saved.month,'YYYY-MM') is distinct from source->>'month') then
  if p_kind<>'payment_certificate' or saved.payload->'counterparty_bank' is null or saved.payload->'counterparty_bank'='null'::jsonb then
   raise exception 'Historical counterparty binding cannot be established' using errcode='40001';end if;
 end if;
 if saved.subject_id is not null and p_kind='payment_certificate' and saved.payload->'counterparty_bank' is not null and saved.payload->'counterparty_bank'<>'null'::jsonb then
  select partner_company_id into partner from public.payment_certificates where id=p_subject and company_id=(source->>'company_id')::uuid for share;
  if partner is null or saved.payload#>>'{counterparty_bank,company_id}' is distinct from source->>'company_id'
   or saved.payload#>>'{counterparty_bank,partner_company_id}' is distinct from partner::text then raise exception 'Saved bank counterparty changed' using errcode='40001';end if;
 end if;
 if saved.subject_id is not null and saved.payload ? 'form_fields' and not (p_payload ? 'form_fields') then
  raise exception 'Saved input namespace cannot be removed' using errcode='40001';end if;
 if jsonb_typeof(p_payload) is distinct from 'object' or octet_length(p_payload::text)>16384 then
  raise exception 'Input payload exceeds the existing byte bound' using errcode='22023';end if;
 if p_payload ? 'form_fields' then
  if not (p_payload ? 'contract_terms') then raise exception 'Explicit adopted contract required' using errcode='22023';end if;
  perform private.validate_trade_document_form_fields(p_payload->'form_fields');
 end if;
 if saved.subject_id is not null and saved.payload#>>'{form_fields,schema}'='2'
  and p_payload#>>'{form_fields,schema}' is distinct from '2' then
  raise exception 'Extended form cannot be downgraded' using errcode='40001';end if;
 if p_payload#>>'{form_fields,schema}'='2' then
  -- Registered contacts may remain the exact historical snapshot or be explicitly
  -- refreshed from the currently authorized source; arbitrary input is rejected.
  if exists(select 1 from unnest(array['phone','fax','representative_name']) k
   where (p_payload#>array['issuer',k]) is distinct from (source#>array['defaults','issuer',k])
   and (saved.subject_id is null or (p_payload#>array['issuer',k]) is distinct from (saved.payload#>array['issuer',k]))) then
   raise exception 'Registered issuer contacts changed' using errcode='22023';end if;
 end if;
 return private.save_trade_document_before_form_fields(p_kind,p_subject,p_source_revision,p_expected_version,p_payload);
end $$;
do $$begin if exists(select 1 from (values ('private.save_trade_document_attachment(text,uuid,text,integer,jsonb)'::regprocedure,'c84bd0ded9e418c29d4c3fb3d510954e'),('private.validate_trade_document_form_fields(jsonb)'::regprocedure,'6510b8ba2c6eec7a79e3acffb54da93c'),('private.partner_company_profile_value(uuid)'::regprocedure,'59259001274d9af19fa2e0c89f4eedcc')) expected(oid,hash) left join pg_proc p on p.oid=expected.oid where p.oid is null or md5(p.prosrc)<>expected.hash) then raise exception 'Form v2/contact result changed';end if;
if not (exists(select 1 from pg_proc where oid='private.trade_document_source(text,uuid,text)'::regprocedure and md5(prosrc)='f46a4457a520eec9f28bfea30499dd97') or (exists(select 1 from pg_proc where oid='private.trade_document_source(text,uuid,text)'::regprocedure and md5(prosrc)='1f877168bc5767b2efb6946a19c3d198') and exists(select 1 from pg_proc where oid=to_regprocedure('private.trade_document_source_before_partner_bank(text,uuid,text)') and md5(prosrc)='f46a4457a520eec9f28bfea30499dd97'))) then raise exception 'Form source result changed';end if;end $$;
do $$begin if exists(select 1 from trade_form_upgrade_attributes a join pg_proc p on p.oid=a.oid where to_jsonb(p)-'prosrc' is distinct from a.attributes) then raise exception 'Form capability attributes changed';end if;end $$;
commit;
