begin;
set local lock_timeout='5s';
set local statement_timeout='45s';
lock table company_work_category_private.settings,company_work_category_private.history in access exclusive mode;
do $guard$ begin
 if current_user<>'postgres' then raise exception 'postgres installer required'; end if;
 if exists(select 1 from company_work_category_private.settings) or exists(select 1 from company_work_category_private.history) then raise exception 'used policy cannot be restored'; end if;
 if (select md5(prosrc) from pg_proc where oid=to_regprocedure('company_work_category_private.valid_policy(jsonb)')) is distinct from 'f77a42898070a81e21cc405e943661e0' then raise exception 'policy source changed'; end if;
 if (select md5(prosrc) from pg_proc where oid=to_regprocedure('public.read_company_work_category_policy(uuid)')) is distinct from '1ce7de56d9edcf639cd7fa364a1cf293' then raise exception 'policy source changed'; end if;
 if (select md5(prosrc) from pg_proc where oid=to_regprocedure('public.save_company_work_category_policy(uuid,integer,jsonb)')) is distinct from '2a6c280fae9e5419bc24f7c73fda532c' then raise exception 'policy source changed'; end if;
end $guard$;
drop function public.save_company_work_category_policy(uuid,integer,jsonb);
drop function public.read_company_work_category_policy(uuid);
drop function company_work_category_private.valid_policy(jsonb);
drop table company_work_category_private.history;
drop table company_work_category_private.settings;
drop schema company_work_category_private;
commit;
