drop function explicit_route_finalization_private.scope(uuid);
drop function explicit_route_finalization_private.basis(uuid);
drop function explicit_route_finalization_private.lock_actor(uuid);
drop function explicit_route_finalization_private.actor_allowed(uuid);
drop function explicit_route_finalization_private.required(uuid);
drop function explicit_route_finalization_private.enabled(uuid);
drop table explicit_route_finalization_private.permits;
drop table explicit_route_finalization_private.events;
drop table explicit_route_finalization_private.receipts;
drop table explicit_route_finalization_private.states;
drop table explicit_route_finalization_private.reports;
drop table explicit_route_finalization_private.rollout;
drop schema explicit_route_finalization_private;
commit;
