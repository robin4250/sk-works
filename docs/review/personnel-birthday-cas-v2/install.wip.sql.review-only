 for item in select value from jsonb_array_elements($catalog$[{"signature":"private.worker_personnel_payload(uuid)","return_type":"jsonb","volatility":"s","acl":null,"body_md5":"72cabfabfad5dcbb533d21d2a0605dae"},{"signature":"private.apply_worker_personnel_payload(uuid,jsonb,uuid)","return_type":"void","volatility":"v","acl":"{postgres=X/postgres}","body_md5":"9d700b1fe8176a04b19dc63e9305edcf"},{"signature":"private.employee_personnel_view(uuid)","return_type":"jsonb","volatility":"s","acl":"{postgres=X/postgres,authenticated=X/postgres}","body_md5":"643dc0efdc35b6ab365f1ec31d053384"},{"signature":"public.save_worker_personnel_profile(uuid,jsonb)","return_type":"jsonb","volatility":"v","acl":"{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}","body_md5":"ce3ae9c1779b12a093e571b8c030a4c0"},{"signature":"public.decide_worker_personnel_change(uuid,boolean)","return_type":"jsonb","volatility":"v","acl":"{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}","body_md5":"42e5b55ceb81d293873c6e653b56e89f"}]$catalog$::jsonb) loop
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure(item->>'signature')
 and md5(p.prosrc)=item->>'body_md5' and pg_get_userbyid(p.proowner)='postgres'
 and p.proacl::text is not distinct from item->>'acl'
 and p.proconfig=array['search_path=""']::text[] and p.prosecdef
 and p.provolatile::text=item->>'volatility' and not p.proisstrict and not p.proleakproof
 and p.proparallel='u' and p.prokind='f' and not p.proretset
 and format_type(p.prorettype,null)=item->>'return_type') then
 raise sqlstate '55000' using message='personnel_birthday_v2_final_catalog_drift';end if;
 end loop;end $catalog_guard$;

do $column_guard$ begin
 if not exists(select 1 from information_schema.columns where table_schema='public'
 and table_name='worker_personnel_profiles' and column_name='birth_date'
 and data_type='date' and is_nullable='YES' and column_default is null) then
 raise sqlstate '55000' using message='personnel_birthday_v2_column_drift';end if;
end $column_guard$;
