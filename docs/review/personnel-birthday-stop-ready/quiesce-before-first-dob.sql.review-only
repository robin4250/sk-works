 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure(item->>'signature')
 and p.prolang=(select oid from pg_language where lanname=item->>'language')
 and p.prosupport::oid=0 and p.provariadic=0 and p.pronargdefaults=0 and p.proargdefaults is null
 and p.proallargtypes is null and p.proargmodes is null and p.prosqlbody is null and p.probin is null
 and p.pronargs=jsonb_array_length(item->'argument_names')
 and p.proargnames is not distinct from array(select jsonb_array_elements_text(item->'argument_names'))
 and p.procost=100 and p.prorows=0
 and md5(p.prosrc)=item->>'body_md5' and pg_get_userbyid(p.proowner)='postgres'
 and p.proacl::text is not distinct from item->>'acl'
 and p.proconfig=array['search_path=""']::text[] and p.prosecdef
 and p.provolatile::text=item->>'volatility' and not p.proisstrict and not p.proleakproof
 and p.proparallel='u' and p.prokind='f' and not p.proretset
