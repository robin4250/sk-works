  where n.nspname !~ '^pg_' and n.nspname<>'information_schema'
  and (position('save_worker_personnel_profile' in lower(p.prosrc))>0
    or position('decide_worker_personnel_change' in lower(p.prosrc))>0))
 or exists(select 1 from pg_depend d where d.refclassid='pg_proc'::regclass and d.refobjid in (
   to_regprocedure('public.save_worker_personnel_profile(uuid,jsonb)'),to_regprocedure('public.decide_worker_personnel_change(uuid,boolean)')))
 or (select count(*) from pg_proc p join pg_namespace n on n.oid=p.pronamespace
  where n.nspname !~ '^pg_' and n.nspname<>'information_schema' and position('apply_worker_personnel_payload' in lower(p.prosrc))>0)<>2
 or exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace
  where n.nspname !~ '^pg_' and n.nspname<>'information_schema' and position('apply_worker_personnel_payload' in lower(p.prosrc))>0
  and p.oid not in (to_regprocedure('public.save_worker_personnel_profile(uuid,jsonb)'),to_regprocedure('public.decide_worker_personnel_change(uuid,boolean)')))
 or exists(select 1 from pg_depend d where d.refclassid='pg_proc'::regclass
  and d.refobjid=to_regprocedure('private.apply_worker_personnel_payload(uuid,jsonb,uuid)')
  and not(d.classid='pg_proc'::regclass and d.objid in (
    to_regprocedure('public.save_worker_personnel_profile(uuid,jsonb)'),to_regprocedure('public.decide_worker_personnel_change(uuid,boolean)'))))
 then raise sqlstate '55000' using message='personnel_stop_ready_unknown_entry_graph';end if;
end $entry_graph$;
do $no_birthday_column$ begin
 if exists(select 1 from pg_attribute where attrelid='public.worker_personnel_profiles'::regclass
 and attname='birth_date' and not attisdropped) then
 raise sqlstate '55000' using message='personnel_stop_ready_not_first_dob_install';end if;
end $no_birthday_column$;

