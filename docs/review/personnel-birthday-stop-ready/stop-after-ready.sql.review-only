-- Only readers change; ready writers recheck current capability after admission.
create or replace function private.worker_personnel_payload(p_worker_id uuid)
returns jsonb
language sql
stable security definer
set search_path=''
as $$
  select q.value || jsonb_build_object('personnel_cas_digest', md5((q.value - 'birth_date_contract_version')::text)) from (
  select jsonb_build_object(
    'name',coalesce(w.name,''),
    'kind',case when w.affiliation::text='partner_company'
      then 'partnerWorker' else 'employee' end,
    'birth_date',p.birth_date,
    'birth_date_contract_version',1,
    'blood_type',coalesce(p.blood_type,''),
    'role',coalesce(w.role,''),
    'employee_number',coalesce(w.employee_number,''),
    'department',coalesce(w.department,''),
    'hire_date',coalesce(w.hire_date::text,''),
    'phone',coalesce(w.phone,''),
    'address',coalesce(p.address,''),
    'emergency_name',coalesce(p.emergency_name,''),
    'emergency_relation',coalesce(p.emergency_relation,''),
    'emergency_phone',coalesce(p.emergency_phone,''),
    'emergency_address',coalesce(p.emergency_address,''),
    'family_composition',coalesce(p.family_composition,''),
    'family_members',coalesce((
      select jsonb_agg(jsonb_build_object(
        'id',fm.id,'name',fm.name,'relation',fm.relation,
        'birth_date',fm.birth_date,'is_dependent',fm.is_dependent
      ) order by fm.birth_date nulls last,fm.name,fm.id)
      from public.worker_family_members fm
      where fm.worker_id=w.id and fm.company_id=w.company_id
    ),'[]'::jsonb)
  )
  as value from public.workers w
  left join public.worker_personnel_profiles p on p.worker_id=w.id
  where w.id=p_worker_id
  limit 1) q
$$;
create or replace function private.employee_personnel_view(p_company uuid)
returns jsonb language plpgsql stable security definer set search_path='' as $$
begin
 if not private.personnel_view_allowed(p_company) then
 raise exception '社員情報の閲覧権限がありません' using errcode='42501'; end if;
 return jsonb_build_object('birth_date_contract_version',1,'company_id',p_company,'records',coalesce((
 select jsonb_agg(jsonb_build_object(
 'id',w.id,'name',w.name,'kind',case when w.affiliation::text='partner_company' then 'partnerWorker' else 'employee' end,
 'role',coalesce(w.role,''),'phone',coalesce(w.phone,''),'employeeNumber',coalesce(w.employee_number,''),
 'department',coalesce(w.department,''),'hireDate',coalesce(w.hire_date::text,''),'active',w.status::text='active',
 'birthDate',p.birth_date,'birthDateContractVersion',1,
 'personnelCasDigest',private.worker_personnel_payload(w.id)->>'personnel_cas_digest',
 'bloodType',coalesce(p.blood_type,''),'address',coalesce(p.address,''),
 'emergencyName',coalesce(p.emergency_name,''),'emergencyRelation',coalesce(p.emergency_relation,''),
 'emergencyPhone',coalesce(p.emergency_phone,''),'emergencyAddress',coalesce(p.emergency_address,''),
 'familyComposition',coalesce(p.family_composition,''),
 'familyMembers',coalesce((select jsonb_agg(jsonb_build_object('id',f.id,'name',f.name,'relation',f.relation,
 'birth_date',f.birth_date,'is_dependent',f.is_dependent) order by f.birth_date nulls last,f.name,f.id)
 from public.worker_family_members f where f.company_id=w.company_id and f.worker_id=w.id),'[]'::jsonb),
 'createdAt',w.created_at,'updatedAt',greatest(w.updated_at,coalesce(p.updated_at,w.updated_at))
 ) order by w.name) from public.workers w
 left join public.worker_personnel_profiles p on p.company_id=w.company_id and p.worker_id=w.id
 where w.company_id=p_company and w.status::text='active'),'[]'::jsonb));
end $$;
