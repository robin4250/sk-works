 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('shared_report_edit_private.complete_edit()') and md5(p.prosrc)='ebb0cadb1d81814031f27fa8fe580cda' and pg_get_userbyid(p.proowner)='postgres' and p.prosecdef and p.proconfig=array['search_path=""'] and (p.oid=to_regprocedure('private.save_daily_report_signature(uuid,text,text,jsonb)') or p.proacl=array[makeaclitem(p.proowner,p.proowner,'EXECUTE',false)])) then raise exception 'document_candidate_source_mismatch: shared_report_edit_private.complete_edit()';end if;
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('shared_daily_report_private.record_signature()') and md5(p.prosrc)='97d4fd61705058afbaed29c0a1ffaf49' and pg_get_userbyid(p.proowner)='postgres' and p.prosecdef and p.proconfig=array['search_path=""'] and (p.oid=to_regprocedure('private.save_daily_report_signature(uuid,text,text,jsonb)') or p.proacl=array[makeaclitem(p.proowner,p.proowner,'EXECUTE',false)])) then raise exception 'document_candidate_source_mismatch: shared_daily_report_private.record_signature()';end if;
