-- REVIEW ONLY: disabled by default; no public grant, rollout, migration or
-- production trigger installation. Other legacy writers remain unverified.
create table invoice_month_close_candidate.approval_guard_settings(singleton boolean primary key default true check(singleton),enabled boolean not null default false);
insert into invoice_month_close_candidate.approval_guard_settings values(true,false);
create table invoice_month_close_candidate.approval_permits(
 tx bigint not null,invoice_id uuid not null,actor_id uuid not null,session_id uuid not null,
 primary key(tx,invoice_id,actor_id));
alter table invoice_month_close_candidate.approval_guard_settings enable row level security;
alter table invoice_month_close_candidate.approval_permits enable row level security;
revoke all on invoice_month_close_candidate.approval_guard_settings,invoice_month_close_candidate.approval_permits from public,anon,authenticated,service_role;
create function invoice_month_close_candidate.require_approval_permit(p_invoice uuid) returns void
language plpgsql security definer set search_path='' as $$
declare enabled boolean;actor uuid:=auth.uid();sid uuid;
begin
 select s.enabled into enabled from invoice_month_close_candidate.approval_guard_settings s where singleton for share;
 if not coalesce(enabled,false) then return;end if;
 sid:=private.require_reauthentication_session();
 if actor is null or sid is null or not exists(select 1 from invoice_month_close_candidate.approval_permits p where p.tx=txid_current() and p.invoice_id=p_invoice and p.actor_id=actor and p.session_id=sid) then
  raise exception 'notification_approval_required' using errcode='42501';end if;
end $$;
revoke all on function invoice_month_close_candidate.require_approval_permit(uuid) from public,anon,authenticated,service_role;
create function invoice_month_close_candidate.guard_invoice_transition() returns trigger
language plpgsql security definer set search_path='' as $$
begin
 if (tg_op='INSERT' and (new.status is distinct from 'draft' or new.finalized_at is not null or new.approval_finalized_at is not null)) or
    (tg_op='UPDATE' and ((old.status='draft' and new.status is distinct from 'draft') or (old.finalized_at is null and new.finalized_at is not null) or (old.approval_finalized_at is null and new.approval_finalized_at is not null))) then
  perform invoice_month_close_candidate.require_approval_permit(new.id);
 end if;
 return new;
end $$;
create function invoice_month_close_candidate.guard_approval_transition() returns trigger
language plpgsql security definer set search_path='' as $$
begin
 if tg_op='UPDATE' and new.invoice_id is distinct from old.invoice_id then raise exception 'approval_invoice_move_unsupported' using errcode='55000';end if;
 if new.status='approved' and (tg_op='INSERT' or old.status is distinct from 'approved') then
  perform invoice_month_close_candidate.require_approval_permit(new.invoice_id);
 end if;
 return new;
end $$;
revoke all on function invoice_month_close_candidate.guard_invoice_transition(),invoice_month_close_candidate.guard_approval_transition() from public,anon,authenticated,service_role;
-- Triggers are installed only in isolated tests, not in this candidate file.
