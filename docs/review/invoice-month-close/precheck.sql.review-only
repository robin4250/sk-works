-- REVIEW-ONLY: no grants, triggers, rollout, notification or production changes.
-- This is an incomplete, fail-closed diagnostic. It never authorizes approval.
create schema invoice_month_close_candidate;
revoke all on schema invoice_month_close_candidate from public,anon,authenticated,service_role;
create function invoice_month_close_candidate.precheck(p_invoice uuid)
returns text language plpgsql volatile security definer set search_path='' as $$
declare inv public.invoices%rowtype; has_route boolean; requested_route boolean; target_route boolean:=false;
begin
 select * into inv from public.invoices where id=p_invoice;
 if not found or inv.company_id is null or inv.customer_id is null or inv.billing_period_start is null or inv.billing_period_end is null or inv.billing_period_end<inv.billing_period_start then return 'unavailable';end if;
 if inv.billing_period_start<>date_trunc('month',inv.billing_period_start)::date or inv.billing_period_end<>(date_trunc('month',inv.billing_period_start)+interval '1 month - 1 day')::date then return 'period_unverified';end if;
 if (clock_timestamp() at time zone 'Asia/Tokyo')::date<=inv.billing_period_end then return 'period_open';end if;
 -- Route attribution reuses the current billing source/blocked functions.
 select exists(select 1 from private.route_billing_quantity_requests q where q.company_id=inv.company_id and q.customer_id=inv.customer_id and q.work_date between inv.billing_period_start and inv.billing_period_end) into requested_route;
 select requested_route or exists(select 1 from public.attendance_verifications a where a.company_id=inv.company_id and a.work_date between inv.billing_period_start and inv.billing_period_end and a.route_assignment_id is not null) into has_route;
 if has_route then
  if to_regprocedure('private.route_signed_checkout_sources(uuid,date,date)') is null or to_regprocedure('private.route_billing_invoice_blocked(uuid,uuid,date,date)') is null then return 'route_unverified';end if;
  if private.route_billing_invoice_blocked(inv.company_id,inv.customer_id,inv.billing_period_start,inv.billing_period_end) is distinct from false then return 'route_unverified';end if;
  if exists(select 1 from public.attendance_verifications a where a.company_id=inv.company_id and a.work_date between inv.billing_period_start and inv.billing_period_end and a.route_assignment_id is not null and a.event_type='clock_in' and (not exists(select 1 from private.route_journey_visit_events ve join private.route_journey_captures cap on cap.id=ve.capture_id and cap.source_clock_in_id=a.id and ve.route_stop_id=cap.route_stop_id and cap.company_id=a.company_id and cap.route_assignment_id=a.route_assignment_id and cap.worker_id=a.worker_id and cap.work_date=a.work_date join public.route_stops rs on rs.id=cap.route_stop_id and rs.route_assignment_id=cap.route_assignment_id join public.sites st on st.id=rs.site_id and st.company_id=cap.company_id where ve.source_clock_in_id=a.id and ve.kind='start') or exists(select 1 from private.route_journey_visit_events ve join private.route_journey_captures cap on cap.id=ve.capture_id and cap.source_clock_in_id=a.id and ve.route_stop_id=cap.route_stop_id and cap.company_id=a.company_id and cap.route_assignment_id=a.route_assignment_id and cap.worker_id=a.worker_id and cap.work_date=a.work_date join public.route_stops rs on rs.id=cap.route_stop_id and rs.route_assignment_id=cap.route_assignment_id join public.sites st on st.id=rs.site_id and st.company_id=cap.company_id where ve.source_clock_in_id=a.id and ve.kind='start' and st.customer_id=inv.customer_id)) and not exists(select 1 from public.attendance_verifications o join public.daily_reports r on r.id=o.daily_report_id and r.company_id=a.company_id and r.route_assignment_id=a.route_assignment_id and r.report_date=a.work_date join public.daily_report_workers w on w.report_id=r.id and w.worker_id=a.worker_id join private.route_signed_checkout_sources(inv.company_id,inv.billing_period_start,inv.billing_period_end) x on x.source_clock_in_id=a.id and x.report_id=r.id and x.worker_id=a.worker_id and x.source_ready where o.source_clock_in_id=a.id and o.company_id=a.company_id and o.worker_id=a.worker_id and o.work_date=a.work_date and o.route_assignment_id=a.route_assignment_id and o.event_type='clock_out' and o.confirmed_at>=a.confirmed_at and r.status='signed' and r.signed_at is not null and r.representative_signature_json is not null and r.representative_signature_json not in ('[]'::jsonb,'null'::jsonb) and r.supervisor_signature_json is not null and r.supervisor_signature_json not in ('[]'::jsonb,'null'::jsonb))) then return 'route_unverified';end if;
  select exists(select 1 from private.route_signed_checkout_sources(inv.company_id,inv.billing_period_start,inv.billing_period_end) x where x.customer_id=inv.customer_id and x.source_ready) into target_route;
  if requested_route and not target_route then return 'route_unverified';end if;
 end if;
 if not target_route and not exists(select 1 from public.attendance_verifications a join public.sites s on s.id=a.site_id and s.company_id=a.company_id where a.company_id=inv.company_id and s.customer_id=inv.customer_id and a.work_date between inv.billing_period_start and inv.billing_period_end and a.event_type='clock_in' and a.route_assignment_id is null) then return 'work_unverified';end if;
 -- All clock-ins for the customer, not just the last day, need their own checkout.
 if exists(select 1 from public.attendance_verifications a join public.sites s on s.id=a.site_id and s.company_id=a.company_id where a.company_id=inv.company_id and s.customer_id=inv.customer_id and a.work_date between inv.billing_period_start and inv.billing_period_end and a.event_type='clock_in' and a.route_assignment_id is null and not exists(select 1 from public.attendance_verifications o where o.company_id=a.company_id and o.worker_id=a.worker_id and o.event_type='clock_out' and o.source_clock_in_id=a.id and o.confirmed_at>=a.confirmed_at)) then return 'checkout_pending';end if;
 -- A signed report must be linked to each clock-in's checkout and worker.
 if exists(select 1 from public.attendance_verifications a join public.sites s on s.id=a.site_id and s.company_id=a.company_id where a.company_id=inv.company_id and s.customer_id=inv.customer_id and a.work_date between inv.billing_period_start and inv.billing_period_end and a.event_type='clock_in' and a.route_assignment_id is null and not exists(select 1 from public.attendance_verifications o join public.daily_reports r on r.id=o.daily_report_id and r.company_id=a.company_id and r.site_id=a.site_id and r.report_date=a.work_date join public.daily_report_workers w on w.report_id=r.id and w.worker_id=a.worker_id where o.company_id=a.company_id and o.worker_id=a.worker_id and o.event_type='clock_out' and o.source_clock_in_id=a.id and o.confirmed_at>=a.confirmed_at and r.status='signed' and r.signed_at is not null and r.representative_signature_json is not null and r.representative_signature_json not in ('[]'::jsonb,'null'::jsonb) and r.supervisor_signature_json is not null and r.supervisor_signature_json not in ('[]'::jsonb,'null'::jsonb))) then return 'report_pending';end if;
 -- Reject unlinked or extra site attendance; a report alone does not prove
 -- that the actual attendance row used by invoice calculation was generated.
 if exists(select 1 from public.attendance_verifications a join public.sites s on s.id=a.site_id and s.company_id=a.company_id where a.company_id=inv.company_id and s.customer_id=inv.customer_id and a.work_date between inv.billing_period_start and inv.billing_period_end and a.event_type='clock_in' and a.route_assignment_id is null and not exists(select 1 from public.attendance_verifications o join public.attendance_entries e on e.company_id=a.company_id and e.worker_id=a.worker_id and e.work_date=a.work_date and e.site_id=a.site_id and e.source_report_id=o.daily_report_id where o.source_clock_in_id=a.id and o.event_type='clock_out' and o.company_id=a.company_id and o.worker_id=a.worker_id)) then return 'data_changed';end if;
 if exists(select 1 from public.attendance_entries e join public.sites s on s.id=e.site_id and s.company_id=e.company_id where e.company_id=inv.company_id and s.customer_id=inv.customer_id and e.work_date between inv.billing_period_start and inv.billing_period_end and not exists(select 1 from public.attendance_verifications a join public.attendance_verifications o on o.source_clock_in_id=a.id and o.event_type='clock_out' and o.daily_report_id=e.source_report_id where a.company_id=e.company_id and a.worker_id=e.worker_id and a.work_date=e.work_date and a.site_id=e.site_id and a.event_type='clock_in')) then return 'data_changed';end if;
 -- No reliable immutable source fingerprint is currently saved on the existing
 -- invoice. Never claim ready even if the visible times and signatures match.
 return 'source_proof_missing';
end $$;
revoke all on function invoice_month_close_candidate.precheck(uuid) from public,anon,authenticated,service_role;
