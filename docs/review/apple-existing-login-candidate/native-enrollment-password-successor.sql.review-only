-- REVIEW ONLY. No public route, grants, session credential storage or activation.
-- Install after native-enrollment-successor; verified Auth ports alone call this.
begin;
create table apple_native_enrollment_private.password_successor_intents(
 id uuid primary key default gen_random_uuid(),actor_id uuid not null,
 original_session_id uuid not null,subject text not null,token_sha256 text not null unique,
 snapshot jsonb not null,created_at timestamptz not null default clock_timestamp(),
 expires_at timestamptz not null,password_session_id uuid,
 request_id uuid unique references apple_native_enrollment_private.requests(request_id)
);
alter table apple_native_enrollment_private.password_successor_intents enable row level security;
revoke all on apple_native_enrollment_private.password_successor_intents from public,anon,authenticated,service_role;
create function apple_native_enrollment_private.begin_password_successor(p_actor uuid,p_original_sid uuid,p_subject text,p_token_hash text)
returns jsonb language plpgsql volatile security definer set search_path='' set timezone='UTC' as $$
declare c jsonb;r apple_native_enrollment_private.password_successor_intents;allowed boolean;
begin
 if auth.jwt()->>'role' is distinct from 'service_role' then raise sqlstate '42501' using message='server_only';end if;
 select enabled into allowed from apple_native_enrollment_private.successor_rollout where singleton for share;
 if allowed is distinct from true or not apple_native_enrollment_private.ready()
 or p_subject is null or p_subject !~ '^[A-Za-z0-9._-]{1,255}$'
 or p_token_hash is null or p_token_hash !~ '^[a-f0-9]{64}$' then return null;end if;
 perform pg_advisory_xact_lock(hashtextextended('apple-native-subject:'||p_subject,0));
 perform pg_advisory_xact_lock(hashtextextended('apple-native-actor:'||p_actor::text,0));
 perform 1 from auth.users where id=p_actor for share;
 perform 1 from auth.sessions where id=p_original_sid and user_id=p_actor for share;
 perform 1 from public.company_members where user_id=p_actor for share;
 perform 1 from auth.identities where user_id=p_actor or (provider='apple' and provider_id=p_subject) for share;
 c:=apple_native_enrollment_private.context(p_actor,p_original_sid);
 if c is null or c->'apple_subjects'<>'[]'::jsonb
 or exists(select 1 from apple_native_enrollment_private.password_successor_intents where token_sha256=p_token_hash
   or (expires_at>clock_timestamp() and (actor_id=p_actor or subject=p_subject)))
 or exists(select 1 from apple_native_enrollment_private.requests where token_sha256=p_token_hash
   or (status in('reserved','held') and (actor_id=p_actor or subject=p_subject)))
 or exists(select 1 from auth.identities where provider='apple' and provider_id=p_subject)
 or exists(select 1 from apple_owner_policy.subject_permits where apple_subject=p_subject)
 then return null;end if;
 insert into apple_native_enrollment_private.password_successor_intents(actor_id,original_session_id,subject,token_sha256,snapshot,expires_at)
 values(p_actor,p_original_sid,p_subject,p_token_hash,c-array['account_allowed','primary_password_configured'],clock_timestamp()+interval '120 seconds') returning * into r;
 return jsonb_build_object('intent_id',r.id,'actor_id',r.actor_id,'original_session_id',r.original_session_id,
  'subject',r.subject,'token_sha256',r.token_sha256);
end $$;
revoke all on function apple_native_enrollment_private.begin_password_successor(uuid,uuid,text,text) from public,anon,authenticated,service_role;
create function apple_native_enrollment_private.reserve_password_successor(p_intent uuid,p_actor uuid,p_original_sid uuid,p_password_sid uuid)
returns jsonb language plpgsql volatile security definer set search_path='' set timezone='UTC' as $$
declare i apple_native_enrollment_private.password_successor_intents;c jsonb;raw text;r jsonb;allowed boolean;
 session_created timestamptz;password_at timestamptz;
begin
 if auth.jwt()->>'role' is distinct from 'service_role' then raise sqlstate '42501' using message='server_only';end if;
 select enabled into allowed from apple_native_enrollment_private.successor_rollout where singleton for share;
 if allowed is distinct from true or not apple_native_enrollment_private.ready() then return null;end if;
 select * into i from apple_native_enrollment_private.password_successor_intents where id=p_intent;
 if not found then return null;end if;
 perform pg_advisory_xact_lock(hashtextextended('apple-native-subject:'||i.subject,0));
 perform pg_advisory_xact_lock(hashtextextended('apple-native-actor:'||i.actor_id::text,0));
 select * into i from apple_native_enrollment_private.password_successor_intents where id=p_intent for update;
 if i.actor_id is distinct from p_actor or i.original_session_id is distinct from p_original_sid
 or i.expires_at<=clock_timestamp() or i.request_id is not null or p_password_sid is null or p_password_sid=p_original_sid then return null;end if;
 perform 1 from auth.users where id=p_actor for share;
 select created_at into session_created from auth.sessions where id=p_password_sid and user_id=p_actor for share;
 if not found or session_created<i.created_at or session_created>clock_timestamp() then return null;end if;
 -- Official GoTrue v2.197.0 records password authentication here. Missing or
 -- incompatible managed Auth schema must fail installation/execution, not skip it.
 select created_at into password_at from auth.mfa_amr_claims
  where session_id=p_password_sid and authentication_method='password' for share;
 if not found or password_at<i.created_at or password_at>clock_timestamp() then return null;end if;
 perform 1 from public.company_members where user_id=p_actor for share;
 perform 1 from auth.identities where user_id=p_actor for share;
 c:=apple_native_enrollment_private.context(p_actor,p_password_sid);
 if c is null or (c-array['account_allowed','primary_password_configured','session_id'])
  is distinct from (i.snapshot-'session_id') then return null;end if;
 raw:=(c-array['account_allowed','primary_password_configured'])::text;
 r:=public.reserve_apple_native_subject(p_actor,p_password_sid,i.subject,i.token_sha256,
  encode(sha256(convert_to(raw,'UTF8')),'hex'),raw,floor(extract(epoch from password_at))::bigint);
 if r is null then return null;end if;
 update apple_native_enrollment_private.password_successor_intents set password_session_id=p_password_sid,
  request_id=(r->>'request_id')::uuid where id=p_intent;
 return r||jsonb_build_object('intent_id',p_intent,'original_session_id',p_original_sid);
end $$;
revoke all on function apple_native_enrollment_private.reserve_password_successor(uuid,uuid,uuid,uuid) from public,anon,authenticated,service_role;
commit;
