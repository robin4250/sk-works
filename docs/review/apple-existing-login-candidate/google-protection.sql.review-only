-- REVIEW ONLY. Default OFF; depends on unchanged owner-policy.sql.review-only.
-- This guards the identity WRITE transaction, including the earlier PKCE commit
-- boundary that the later access-token hook cannot roll back.
begin;
create schema apple_google_protection;
revoke all on schema apple_google_protection from public,anon,authenticated,service_role;
create table apple_google_protection.rollout(
 singleton boolean primary key check(singleton),enabled boolean not null default false,
 activated_at timestamptz
);
-- No Auth FK/cascade: deletion must not silently transfer a known Google subject
-- to a new UID, nor free a registered Apple subject's old owner.
create table apple_google_protection.google_subject_owners(
 provider_id text primary key check(provider_id ~ '^[A-Za-z0-9._-]{1,255}$'),
 user_id uuid not null,first_seen_at timestamptz not null default clock_timestamp()
);
alter table apple_google_protection.rollout enable row level security;
alter table apple_google_protection.google_subject_owners enable row level security;
revoke all on all tables in schema apple_google_protection from public,anon,authenticated,service_role;

create function apple_google_protection.ready()
returns boolean language plpgsql volatile security definer set search_path='' as $$
declare v boolean;
begin
 select enabled into v from apple_google_protection.rollout where singleton for share;
 return v is true;
end $$;
revoke all on function apple_google_protection.ready() from public,anon,authenticated,service_role;

create function apple_google_protection.remember_google(p_subject text,p_user uuid)
returns void language plpgsql volatile security definer set search_path='' as $$
declare previous_uid uuid;
begin
 if p_subject is null or p_subject !~ '^[A-Za-z0-9._-]{1,255}$' or p_user is null then
  raise sqlstate '42501' using message='Account identity verification unavailable';end if;
 insert into apple_google_protection.google_subject_owners(provider_id,user_id)
  values(p_subject,p_user) on conflict do nothing;
 select user_id into previous_uid from apple_google_protection.google_subject_owners
  where provider_id=p_subject for share;
 if previous_uid is distinct from p_user then
  raise sqlstate '42501' using message='Account identity verification unavailable';end if;
 insert into apple_owner_policy.protected_users(user_id) values(p_user) on conflict do nothing;
end $$;
revoke all on function apple_google_protection.remember_google(text,uuid) from public,anon,authenticated,service_role;

create function apple_google_protection.identity_write_guard()
returns trigger language plpgsql security definer set search_path='' as $$
declare protected_uid boolean;permitted_uid uuid;lock_uid uuid;
begin
 if not apple_google_protection.ready() then
  if tg_op='DELETE' then return old;else return new;end if;
 end if;
 if (tg_op='INSERT' and new.provider not in('google','apple')) or
  (tg_op='DELETE' and old.provider not in('google','apple')) or
  (tg_op='UPDATE' and old.provider not in('google','apple') and new.provider not in('google','apple')) then
  if tg_op='DELETE' then return old;else return new;end if;
 end if;
 -- All Google/Apple writes to a UID use the same transaction lock. Reassignment
 -- locks both old/new UIDs in UUID order, avoiding opposite-order deadlocks.
 for lock_uid in select distinct uid from (
  select case when tg_op<>'INSERT' then old.user_id else null end uid
  union all select case when tg_op<>'DELETE' then new.user_id else null end
 )x where uid is not null order by uid loop
  perform pg_advisory_xact_lock(hashtextextended('sko-google-apple-user:'||lock_uid::text,0));
 end loop;
 if tg_op<>'INSERT' and old.provider='google' then
  if old.identity_data->>'sub'=old.provider_id then
   perform apple_google_protection.remember_google(old.provider_id,old.user_id);
  elsif not exists(select 1 from auth.users u where u.id=old.user_id and to_jsonb(u)->>'deleted_at' is not null) then
   raise sqlstate '42501' using message='Account identity verification unavailable';
  end if;
 end if;
 if tg_op='DELETE' then return old;end if;
 -- Official GoTrue SoftDeleteUser sets the real deleted_at column before
 -- SoftDeleteUserIdentities clears metadata and obfuscates provider_id. Permit
 -- only that exact same-UID/provider/row cleanup, never a user_metadata claim.
 if tg_op='UPDATE' and new.id=old.id and new.user_id=old.user_id and new.provider=old.provider
  and new.identity_data='{}'::jsonb
  and exists(select 1 from auth.users u where u.id=old.user_id and to_jsonb(u)->>'deleted_at' is not null)
  and (new.provider_id=old.provider_id or new.provider_id=translate(rtrim(encode(
   sha256(convert_to(old.user_id::text||old.provider||':'||old.provider_id,'UTF8')),'base64'),'='),'+/','-_')) then
  return new;
 end if;
 if new.provider='google' then
  -- A Google login must not silently merge into an unrelated Apple-first UID.
  -- The target's already-registered Apple identities must have same-UID permits.
  if new.identity_data->>'sub' is distinct from new.provider_id or exists(
   select 1 from auth.identities i left join apple_owner_policy.subject_permits p
    on p.apple_subject=i.provider_id
   where i.user_id=new.user_id and i.provider='apple' and
    (p.expected_user_id is distinct from new.user_id or i.identity_data->>'sub' is distinct from i.provider_id)
  ) then raise sqlstate '42501' using message='Account identity verification unavailable';end if;
  perform apple_google_protection.remember_google(new.provider_id,new.user_id);
 elsif new.provider='apple' then
  select exists(select 1 from apple_owner_policy.protected_users where user_id=new.user_id)
   or exists(select 1 from auth.identities where user_id=new.user_id and provider='google')
   or exists(select 1 from apple_google_protection.google_subject_owners where user_id=new.user_id) into protected_uid;
  select expected_user_id into permitted_uid from apple_owner_policy.subject_permits
   where apple_subject=new.provider_id for share;
  if (protected_uid or permitted_uid is not null) and
   (permitted_uid is distinct from new.user_id or new.identity_data->>'sub' is distinct from new.provider_id) then
   raise sqlstate '42501' using message='Account identity verification unavailable';end if;
 end if;
 return new;
end $$;
revoke all on function apple_google_protection.identity_write_guard() from public,anon,authenticated,service_role;
create trigger sko_google_apple_identity_guard
before insert or update or delete on auth.identities
for each row execute function apple_google_protection.identity_write_guard();

-- Owner-only activation primitive. No grant to clients or service_role and no
-- invocation during installation. Provider/hook/capability/catalog review is a
-- separate prerequisite; this does not configure hosted GoTrue.
create function apple_google_protection.enable_reviewed()
returns jsonb language plpgsql volatile security definer set search_path='' as $$
declare n bigint;
begin
 lock table auth.identities in share row exclusive mode;
 lock table apple_google_protection.rollout in share row exclusive mode;
 lock table apple_owner_policy.rollout in share row exclusive mode;
 if exists(select 1 from apple_google_protection.rollout where singleton and (enabled or activated_at is not null))
  or exists(select 1 from apple_owner_policy.rollout where singleton and enabled) then
  raise sqlstate '42501' using message='Policy activation requires reviewed inactive state';end if;
 if exists(select 1 from auth.identities g join auth.users u on u.id=g.user_id
  where g.provider='google' and to_jsonb(u)->>'deleted_at' is null and
  (g.provider_id is null or g.provider_id !~ '^[A-Za-z0-9._-]{1,255}$' or g.identity_data->>'sub' is distinct from g.provider_id))
  or exists(select 1 from auth.identities i join auth.users u on u.id=i.user_id
   left join apple_owner_policy.subject_permits p on p.apple_subject=i.provider_id
   where i.provider='apple' and to_jsonb(u)->>'deleted_at' is null and
    (exists(select 1 from auth.identities g where g.user_id=i.user_id and g.provider='google')
     or exists(select 1 from apple_owner_policy.protected_users where user_id=i.user_id)
     or p.apple_subject is not null)
    and (p.expected_user_id is distinct from i.user_id or i.identity_data->>'sub' is distinct from i.provider_id)) then
  raise sqlstate '42501' using message='Existing identities need reviewed same-UID enrollment';end if;
 perform apple_google_protection.remember_google(g.provider_id,g.user_id)
  from auth.identities g join auth.users u on u.id=g.user_id
  where g.provider='google' and to_jsonb(u)->>'deleted_at' is null order by g.provider_id;
 get diagnostics n=row_count;
 insert into apple_owner_policy.rollout(singleton,enabled) values(true,true)
  on conflict(singleton) do update set enabled=true;
 insert into apple_google_protection.rollout(singleton,enabled,activated_at) values(true,true,clock_timestamp());
 return jsonb_build_object('enabled',true,'google_identities_protected',n);
end $$;
revoke all on function apple_google_protection.enable_reviewed() from public,anon,authenticated,service_role;
-- Nothing is seeded or enabled here. Existing Auth tables/identities are not edited.
commit;
