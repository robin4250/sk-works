-- REVIEW ONLY, default OFF. No Auth settings, identity or company data changes.
begin;
create schema apple_existing_login_private;
revoke all on schema apple_existing_login_private from public,anon,authenticated,service_role;
create table apple_existing_login_private.rollout(
 singleton boolean primary key default true check(singleton),
 enabled boolean not null default false
);
create table apple_existing_login_private.used_tokens(
 token_sha256 text primary key check(token_sha256 ~ '^[0-9a-f]{64}$'),
 user_id uuid not null,used_at timestamptz not null default clock_timestamp()
);
alter table apple_existing_login_private.rollout enable row level security;
alter table apple_existing_login_private.used_tokens enable row level security;
revoke all on all tables in schema apple_existing_login_private from public,anon,authenticated,service_role;

create function apple_existing_login_private.resolve_subject(subject_value text)
returns jsonb language sql stable security definer set search_path='' as $$
 select jsonb_build_object('user_id',u.id,
 'memberships',(select jsonb_agg(jsonb_build_object('company_id',m.company_id,'role',m.role::text)
   order by m.company_id,m.role::text) from public.company_members m where m.user_id=u.id),
 'google_identities',coalesce((select jsonb_agg(jsonb_build_object('id',g.id,'provider_id',g.provider_id)
   order by g.id) from auth.identities g where g.user_id=u.id and g.provider='google'),'[]'::jsonb))
 from auth.identities i join auth.users u on u.id=i.user_id
 where exists(select 1 from apple_existing_login_private.rollout where singleton and enabled)
 and subject_value ~ '^[A-Za-z0-9._-]{1,255}$' and i.provider='apple'
 and i.provider_id=subject_value and i.identity_data->>'sub'=subject_value
 and coalesce((to_jsonb(u)->>'is_anonymous')::boolean,false)=false
 and to_jsonb(u)->>'deleted_at' is null
 and (to_jsonb(u)->>'banned_until' is null or (to_jsonb(u)->>'banned_until')::timestamptz<=now())
 and not exists(select 1 from private.account_deletion_access_restrictions b where b.user_id=u.id)
 and exists(select 1 from public.company_members m where m.user_id=u.id)
$$;
revoke all on function apple_existing_login_private.resolve_subject(text) from public,anon,authenticated,service_role;

create function public.resolve_existing_apple_login(p_apple_subject text)
returns jsonb language plpgsql stable security definer set search_path='' as $$
begin
 if auth.jwt()->>'role' is distinct from 'service_role' then raise sqlstate '42501' using message='server_only';end if;
 return apple_existing_login_private.resolve_subject(p_apple_subject);
end $$;
revoke all on function public.resolve_existing_apple_login(text) from public,anon,authenticated,service_role;
grant execute on function public.resolve_existing_apple_login(text) to service_role;

create function public.consume_existing_apple_login(p_apple_subject text,p_token_sha256 text)
returns jsonb language plpgsql volatile security definer set search_path='' as $$
declare identity_snapshot jsonb;uid uuid;
begin
 if auth.jwt()->>'role' is distinct from 'service_role' then raise sqlstate '42501' using message='server_only';end if;
 if p_token_sha256 is null or p_token_sha256 !~ '^[0-9a-f]{64}$' then return null;end if;
 identity_snapshot:=apple_existing_login_private.resolve_subject(p_apple_subject);
 if identity_snapshot is null then return null;end if;
 uid:=(identity_snapshot->>'user_id')::uuid;
 perform pg_advisory_xact_lock(hashtextextended('apple-existing-login:'||uid::text,0));
 if (select count(*) from apple_existing_login_private.used_tokens where user_id=uid and used_at>now()-interval '10 minutes')>=5 then return null;end if;
 insert into apple_existing_login_private.used_tokens(token_sha256,user_id) values(p_token_sha256,uid) on conflict do nothing;
 if not found then return null;end if;
 return identity_snapshot;
end $$;
revoke all on function public.consume_existing_apple_login(text,text) from public,anon,authenticated,service_role;
grant execute on function public.consume_existing_apple_login(text,text) to service_role;
commit;
