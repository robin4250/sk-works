 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('private.account_access_allowed()') and pg_get_functiondef(p.oid)='CREATE OR REPLACE FUNCTION private.account_access_allowed()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''''
AS $function$
 select auth.uid() is not null and not exists(
  select 1 from private.account_deletion_access_restrictions where user_id=auth.uid())
$function$
' and pg_get_userbyid(p.proowner)='postgres' and p.proacl::text is not distinct from '{postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}' and to_jsonb(p.proconfig) is not distinct from '["search_path=\"\""]'::jsonb and p.prosecdef=true and p.provolatile='s') then raise exception 'storage_review_helper_drift';end if;
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('private.document_submission_access(text,boolean)') and pg_get_functiondef(p.oid)='CREATE OR REPLACE FUNCTION private.document_submission_access(p_path text, p_upload boolean)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''''
AS $function$
 select auth.uid() is not null and exists(select 1 from private.document_submissions r where ((p_upload and r.upload_path=p_path) or (not p_upload and (r.attachment_path=p_path or r.previous->>''attachment_path''=p_path))) and ((p_upload and r.status=''draft'' and r.requested_by=auth.uid() and exists(select 1 from public.workers w where w.id=r.worker_id and w.company_id=r.company_id and w.user_id=auth.uid())) or (not p_upload and (r.requested_by=auth.uid() or exists(select 1 from public.company_members m where m.company_id=r.company_id and m.user_id=auth.uid() and m.role::text in (''owner'',''admin'')) or exists(select 1 from public.company_approval_assignees a where a.company_id=r.company_id and a.user_id=auth.uid())))))
$function$
' and pg_get_userbyid(p.proowner)='postgres' and p.proacl::text is not distinct from '{postgres=X/postgres,authenticated=X/postgres}' and to_jsonb(p.proconfig) is not distinct from '["search_path=\"\""]'::jsonb and p.prosecdef=true and p.provolatile='s') then raise exception 'storage_review_helper_drift';end if;
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('private.has_company_feature(uuid,text)') and pg_get_functiondef(p.oid)='CREATE OR REPLACE FUNCTION private.has_company_feature(p_company_id uuid, p_feature text)
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''public'', ''private'', ''pg_temp''
AS $function$
declare
  v_user_id uuid := auth.uid();
  v_role text;
  v_perm public.member_feature_permissions%rowtype;
begin
  if v_user_id is null or p_company_id is null then
    return false;
  end if;

  select cm.role::text
  into v_role
  from public.company_members cm
  where cm.company_id = p_company_id
    and cm.user_id = v_user_id
  limit 1;

  if v_role is null then
    return false;
  end if;

  if v_role in (''owner'', ''admin'') then
    return true;
  end if;

  select *
  into v_perm
  from public.member_feature_permissions
  where company_id = p_company_id
    and user_id = v_user_id;

  if not found then
    return case
      when v_role = ''manager''
       and p_feature in (
         ''can_manage_attendance'',
         ''can_approve_daily_report_edits''
       )
      then true
      else false
    end;
  end if;

  return case p_feature
    when ''can_view_invoices'' then
      v_perm.can_view_invoices or v_perm.can_manage_invoices
    when ''can_manage_invoices'' then
      v_perm.can_manage_invoices
    when ''can_view_admin_site_data'' then
      false
    when ''can_manage_admin_site_data'' then
      false
    when ''can_manage_payroll'' then
      v_perm.can_manage_payroll
    when ''can_manage_people'' then
      v_perm.can_manage_people
    when ''can_manage_attendance'' then
      v_perm.can_manage_attendance
    when ''can_approve_daily_report_edits'' then
      v_perm.can_approve_daily_report_edits
    when ''can_manage_partner_chat'' then
      v_perm.can_manage_partner_chat
    else false
  end;
end;
$function$
' and pg_get_userbyid(p.proowner)='postgres' and p.proacl::text is not distinct from null and to_jsonb(p.proconfig) is not distinct from '["search_path=public, private, pg_temp"]'::jsonb and p.prosecdef=true and p.provolatile='s') then raise exception 'storage_review_helper_drift';end if;
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('private.personnel_portrait_path(uuid,uuid)') and pg_get_functiondef(p.oid)='CREATE OR REPLACE FUNCTION private.personnel_portrait_path(p_company uuid, p_worker uuid)
 RETURNS text
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''''
AS $function$
begin
 if not private.personnel_view_allowed(p_company) then return null; end if;
 return (select s.attachment_path from public.worker_document_statuses s
 join public.document_requirements r on r.id=s.requirement_id and r.company_id=s.company_id
 join public.workers w on w.id=s.worker_id and w.company_id=s.company_id
 where s.company_id=p_company and s.worker_id=p_worker and r.is_active
 and regexp_replace(r.name,''[[:space:]　]+'','''',''g'') in (''顔写真'',''証明写真'',''身分証明写真'')
 and s.status in (''submitted'',''verified'')
 and s.attachment_path ~ ''[.](jpg|jpeg|png|heic|heif)$''
 order by case when r.scope in (''internal'',''both'') then 0 else 1 end,r.sort_order,r.id
 limit 1);
end $function$
' and pg_get_userbyid(p.proowner)='postgres' and p.proacl::text is not distinct from '{postgres=X/postgres,authenticated=X/postgres}' and to_jsonb(p.proconfig) is not distinct from '["search_path=\"\""]'::jsonb and p.prosecdef=true and p.provolatile='s') then raise exception 'storage_review_helper_drift';end if;
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('private.personnel_view_allowed(uuid)') and pg_get_functiondef(p.oid)='CREATE OR REPLACE FUNCTION private.personnel_view_allowed(p_company uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE
 SET search_path TO ''''
AS $function$
 select auth.uid() is not null and private.account_access_allowed()
 and exists(select 1 from public.company_members m
 where m.company_id=p_company and m.user_id=auth.uid()
 and (m.role::text in (''owner'',''admin'',''viewer'')
 or (m.role::text=''manager'' and private.has_company_feature(p_company,''can_manage_people''))));
$function$
' and pg_get_userbyid(p.proowner)='postgres' and p.proacl::text is not distinct from '{postgres=X/postgres,authenticated=X/postgres}' and to_jsonb(p.proconfig) is not distinct from '["search_path=\"\""]'::jsonb and p.prosecdef=false and p.provolatile='s') then raise exception 'storage_review_helper_drift';end if;
 if not exists(select 1 from pg_proc p where p.oid=to_regprocedure('private.try_uuid(text)') and pg_get_functiondef(p.oid)='CREATE OR REPLACE FUNCTION private.try_uuid(p_value text)
 RETURNS uuid
 LANGUAGE plpgsql
 IMMUTABLE
 SET search_path TO ''pg_catalog'', ''pg_temp''
AS $function$
begin
  return p_value::uuid;
exception
  when invalid_text_representation then
    return null;
end;
$function$
' and pg_get_userbyid(p.proowner)='postgres' and p.proacl::text is not distinct from '{=X/postgres,postgres=X/postgres}' and to_jsonb(p.proconfig) is not distinct from '["search_path=pg_catalog, pg_temp"]'::jsonb and p.prosecdef=false and p.provolatile='i') then raise exception 'storage_review_helper_drift';end if;
end $storage_source_guard$;
do $absence$ begin if to_regclass('private.storage_session_guard_rollout') is not null or to_regclass('private.storage_session_guard_installation') is not null or to_regprocedure('private.worker_storage_session_allowed()') is not null or exists(select 1 from pg_policies where schemaname='storage' and tablename='objects' and policyname='worker_document_live_session_guard') then raise exception 'storage_live_guard_already_present';end if;end $absence$;
set local lock_timeout='5s';
create table private.storage_session_guard_rollout (
 singleton boolean primary key default true check(singleton),
 enabled boolean not null default false
);
alter table private.storage_session_guard_rollout enable row level security;
revoke all on private.storage_session_guard_rollout from public,anon,authenticated,service_role;
insert into private.storage_session_guard_rollout(singleton,enabled) values(true,false);
create function private.worker_storage_session_allowed()
returns boolean language plpgsql stable security definer set search_path='' as $$
declare session_text text; session_uuid uuid; gate boolean;
begin
 -- The disabled gate preserves existing behavior. Enabling is an independent
 -- operator action, never performed by application clients or this candidate.
 select enabled into gate from private.storage_session_guard_rollout where singleton;
 if gate is null then return false;end if;
 if not gate then return true;end if;
 if auth.uid() is null or private.account_access_allowed() is not true
 or auth.jwt()->>'role' is distinct from 'authenticated' then return false;end if;
 session_text:=auth.jwt()->>'session_id';
 if session_text is null or session_text !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then return false;end if;
 session_uuid:=session_text::uuid;
 return exists(select 1 from auth.sessions s where s.id=session_uuid
 and s.user_id=auth.uid() and (s.not_after is null or s.not_after>statement_timestamp()));
end $$;
revoke all on function private.worker_storage_session_allowed() from public,anon,authenticated,service_role;
grant execute on function private.worker_storage_session_allowed() to authenticated;
create policy worker_document_live_session_guard on storage.objects
as restrictive for select to authenticated
using (bucket_id<>'worker-documents' or private.worker_storage_session_allowed());
create table private.storage_session_guard_installation(singleton boolean primary key check(singleton),initial_rollout_xmin text not null);
alter table private.storage_session_guard_installation enable row level security;
revoke all on private.storage_session_guard_installation from public,anon,authenticated,service_role;
insert into private.storage_session_guard_installation select true,xmin::text from private.storage_session_guard_rollout where singleton;
do $off$ begin if (select count(*) from private.storage_session_guard_rollout)<>1 or exists(select 1 from private.storage_session_guard_rollout where enabled) then raise exception 'storage_live_not_unused_off';end if;end $off$;

commit;
