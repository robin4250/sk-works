 if (select jsonb_build_object('owner',pg_get_userbyid(c.relowner),'acl',c.relacl::text,'rls',c.relrowsecurity,'force_rls',c.relforcerowsecurity) from pg_class c where c.oid='storage.objects'::regclass) is distinct from '{"owner":"supabase_storage_admin","acl":"{supabase_storage_admin=a*r*w*d*D*x*t*m*/supabase_storage_admin,service_role=arwdDxtm/supabase_storage_admin,authenticated=arwd/supabase_storage_admin,anon=arwd/supabase_storage_admin,postgres=a*r*w*d*D*x*t*m*/supabase_storage_admin}","rls":true,"force_rls":false}'::jsonb then raise exception 'storage_review_relation_drift';end if;
