-- Candidate only. Existing restrictive account guard remains in force.
begin;
create policy "managers can update qualification master"
on public.qualification_master for update to authenticated
using (exists (select 1 from public.company_members cm where cm.company_id=qualification_master.company_id and cm.user_id=(select auth.uid()) and cm.role::text='manager'))
with check (exists (select 1 from public.company_members cm where cm.company_id=qualification_master.company_id and cm.user_id=(select auth.uid()) and cm.role::text='manager'));
create policy "managers can delete qualification master"
on public.qualification_master for delete to authenticated
using (exists (select 1 from public.company_members cm where cm.company_id=qualification_master.company_id and cm.user_id=(select auth.uid()) and cm.role::text='manager'));
-- A manager must never move a master to another company, including when
-- membership exists in both companies. PostgreSQL triggers compare OLD/NEW.
create function private.guard_qualification_master_manager_company_move()
returns trigger language plpgsql set search_path='' as $$
begin
  if new.company_id is distinct from old.company_id
     and exists (select 1 from public.company_members cm where cm.company_id=old.company_id and cm.user_id=(select auth.uid()) and cm.role::text='manager')
     and not exists (select 1 from public.company_members cm where cm.company_id=old.company_id and cm.user_id=(select auth.uid()) and cm.role::text in ('owner','admin')) then
    raise exception '資格マスターの会社は変更できません' using errcode='42501';
  end if;
  return new;
end $$;
create trigger qualification_master_manager_company_immutable
before update of company_id on public.qualification_master
for each row execute function private.guard_qualification_master_manager_company_move();
commit;
