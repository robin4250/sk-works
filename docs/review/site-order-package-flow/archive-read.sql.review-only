-- REVIEW ONLY. Feature OFF blocks writes but never revokes existing management
-- archive/status reads. Current account/session/exact membership remain required.
begin;
do $$ declare p pg_proc;begin
 select * into p from pg_proc where oid=to_regprocedure('private.require_standalone_trade_document_access()');
 if p.oid is null or md5(p.prosrc)<>'63c57e18a04499e8d6bcfad4ead7837f' or not p.prosecdef
 or pg_get_userbyid(p.proowner)<>'postgres' or p.proconfig is distinct from array['search_path=""']::text[]
 then raise exception 'site_order_actor_contract_changed';end if;
end $$;
create function site_order_package_private.read_actor() returns jsonb language plpgsql security definer set search_path='' as $$
declare sid uuid;companies uuid[];roles text[];
begin
 sid:=private.require_reauthentication_session();
 select array_agg(m.company_id),array_agg(m.role::text) into companies,roles
 from(select company_id,role from public.company_members where user_id=auth.uid() for share)m;
 if coalesce(cardinality(companies),0)<>1 or companies[1] is null or roles[1] is null
 or roles[1] not in('owner','admin','manager') then
 raise exception 'site_order_archive_management_required' using errcode='42501';end if;
 return jsonb_build_object('company_id',companies[1],'actor_id',auth.uid(),'session_id',sid,'role',roles[1],'can_read_archive',true);
end $$;
create function site_order_package_private.package_status(p_package uuid) returns jsonb language plpgsql security definer set search_path='' as $$
declare a jsonb;cid uuid;p site_order_package_private.packages%rowtype;approval site_order_package_private.approvals%rowtype;
 ready site_order_package_private.ready_reply_jobs%rowtype;r uuid;
begin
 a:=site_order_package_private.read_actor();cid:=(a->>'company_id')::uuid;
 select * into p from site_order_package_private.packages where id=p_package and cid in(sender_company_id,recipient_company_id) for share;
 if p.id is null then raise exception 'site_order_archive_not_found' using errcode='42501';end if;
 select * into approval from site_order_package_private.approvals where package_id=p.id for share;
 select * into ready from site_order_package_private.ready_reply_jobs where package_id=p.id for share;
 select receipt_id into r from site_order_artifact_private.pdf_records where job_id=ready.job_id;
 return jsonb_build_object('package_id',p.id,'original_receipt_id',p.original_receipt_id,'approved',approval.package_id is not null,
 'reply_queued',ready.job_id is not null,'reply_original_registered',r is not null,'reply_job_id',ready.job_id,
 'reply_original_receipt_id',r,'reply_delivered',false);
end $$;
create function site_order_package_private.archive_original(p_package uuid,p_kind text) returns bytea language plpgsql security definer set search_path='' as $$
declare a jsonb;cid uuid;p site_order_package_private.packages%rowtype;bytes bytea;
begin
 a:=site_order_package_private.read_actor();cid:=(a->>'company_id')::uuid;
 select * into p from site_order_package_private.packages where id=p_package and cid in(sender_company_id,recipient_company_id) for share;
 if p.id is null or p_kind is null or p_kind not in('order','acceptance') then
 raise exception 'site_order_archive_not_found' using errcode='42501';end if;
 if p_kind='order' then
 select pdf_bytes into bytes from site_order_artifact_private.pdf_records where receipt_id=p.original_receipt_id and job_id=p.source_job_id;
 else
 select r.pdf_bytes into bytes from site_order_package_private.ready_reply_jobs j
 join site_order_artifact_private.pdf_records r on r.job_id=j.job_id where j.package_id=p.id;
 end if;
 if bytes is null then raise exception 'site_order_original_not_registered' using errcode='42501';end if;
 return bytes;
end $$;
revoke all on all functions in schema site_order_package_private from public,anon,authenticated,service_role;
commit;
