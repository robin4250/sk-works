CREATE OR REPLACE FUNCTION public.create_line_historical_invoices(p_command_id uuid, p_quote_id uuid, p_quote_fingerprint text, p_site_terms jsonb, p_tax_rate_bps integer, p_terms_confirmed boolean, p_preview_fingerprint text, p_preview_confirmed boolean)
 RETURNS jsonb
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
begin
 if not private.line_client_access_allowed() then raise exception 'LINE is unavailable for this account' using errcode='42501'; end if;
 return private.create_line_historical_invoices(p_command_id,p_quote_id,p_quote_fingerprint,p_site_terms,p_tax_rate_bps,p_terms_confirmed,p_preview_fingerprint,p_preview_confirmed);
end
$function$;
