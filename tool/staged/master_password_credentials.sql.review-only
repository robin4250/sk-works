-- REVIEW ONLY. Outside migrations; do not apply to production.
-- New Master-only credential state. Existing role/company/Auth/secondary data is not rewritten.
begin;
create table if not exists private.master_password_settings (
 singleton boolean primary key default true check (singleton), enabled boolean not null default false
);
insert into private.master_password_settings(singleton,enabled) values(true,false) on conflict do nothing;
create table if not exists private.master_password_credentials (
 master_user_id uuid primary key references private.master_admins(user_id) on delete cascade,
 password_hash text not null, version bigint not null check(version>0),
 created_at timestamptz not null default clock_timestamp(), updated_at timestamptz not null default clock_timestamp()
);
create table if not exists private.master_password_attempts (
 actor uuid primary key references private.master_admins(user_id) on delete cascade,
 failed_attempts integer not null default 0 check(failed_attempts>=0), locked_until timestamptz
);
create table if not exists private.master_password_challenges (
 id uuid primary key, actor uuid not null references private.master_admins(user_id) on delete cascade,
 session_id uuid not null, device_id uuid not null, operation text not null check(operation in('setup','change','unlock')),
 expected_version bigint not null check(expected_version>=0), request_id uuid not null unique,
 nonce_hash text not null, issued_at timestamptz not null, expires_at timestamptz not null,
 consumed_at timestamptz, check(expires_at=issued_at+interval '120 seconds')
);
create index if not exists master_password_challenges_actor_idx on private.master_password_challenges(actor,expires_at);
create table if not exists private.master_password_requests (
 request_id uuid primary key, actor uuid not null references private.master_admins(user_id) on delete cascade,
 session_id uuid not null, device_id uuid not null, operation text not null,
 expected_version bigint not null, challenge_id uuid not null, result jsonb not null,
 created_at timestamptz not null default clock_timestamp()
);
alter table private.master_password_settings enable row level security;
alter table private.master_password_credentials enable row level security;
alter table private.master_password_attempts enable row level security;
alter table private.master_password_challenges enable row level security;
alter table private.master_password_requests enable row level security;
revoke all on private.master_password_settings,private.master_password_credentials,private.master_password_attempts,
 private.master_password_challenges,private.master_password_requests from public,anon,authenticated;

create or replace function private.master_password_reply(p_status text) returns jsonb
language sql immutable set search_path=pg_catalog as $$
 select jsonb_build_object('protocol','sko-master-password-v1','status',p_status)
$$;

-- Same lock order for every new operation: account barrier, auth user/session,
-- Master actor, trusted device, then this actor's new credential/challenge state.
create or replace function private.master_password_context(p_device_key text) returns jsonb
language plpgsql security definer set search_path=pg_catalog,private,public,extensions,pg_temp as $$
declare a uuid:=auth.uid(); sid uuid; did uuid; claims jsonb:=auth.jwt();
begin
 if a is null or claims->>'role' is distinct from 'authenticated'
  or coalesce(claims->>'is_anonymous','false')<>'false'
  or p_device_key is null or length(p_device_key) not between 32 and 256 then return null;end if;
 begin sid:=(claims->>'session_id')::uuid; exception when invalid_text_representation then return null;end;
 if sid is null or not pg_try_advisory_xact_lock_shared(private.account_deletion_barrier_key(a))
  or private.account_access_allowed() is distinct from true then return null;end if;
 perform 1 from auth.users u where u.id=a and u.deleted_at is null
  and (u.banned_until is null or u.banned_until<=clock_timestamp()) and not coalesce(u.is_anonymous,false) for share;
 if not found then return null;end if;
 perform 1 from auth.sessions s where s.id=sid and s.user_id=a
  and (s.not_after is null or s.not_after>clock_timestamp()) for share;
 if not found then return null;end if;
 perform 1 from private.master_admins m where m.user_id=a and m.enabled for update;
 if not found then return null;end if;
 select d.id into did from private.master_devices d where d.master_user_id=a
  and d.device_key=p_device_key and d.revoked_at is null and not d.is_locked for share;
 if did is null or private.account_access_allowed() is distinct from true then return null;end if;
 -- Recheck time-based expiry after any authorization lock wait.
 perform 1 from auth.sessions s where s.id=sid and s.user_id=a
  and (s.not_after is null or s.not_after>clock_timestamp());
 if not found then return null;end if;
 return jsonb_build_object('actor',a,'session_id',sid,'device_id',did);
end $$;

create or replace function public.master_password_capability() returns jsonb
language plpgsql security definer set search_path=pg_catalog,private,public,pg_temp as $$
begin
 if auth.uid() is null or public.is_current_user_master_admin() is distinct from true
  or private.account_access_allowed() is distinct from true then return private.master_password_reply('denied');end if;
 return jsonb_build_object('protocol','sko-master-password-v1','enabled',
  coalesce((select enabled from private.master_password_settings where singleton),false));
end $$;

create or replace function public.current_master_password_status(p_device_key text) returns jsonb
language plpgsql security definer set search_path=pg_catalog,private,public,pg_temp as $$
declare ctx jsonb; v bigint;
begin
 ctx:=private.master_password_context(p_device_key);
 if ctx is null then return private.master_password_reply('denied');end if;
 if not coalesce((select enabled from private.master_password_settings where singleton),false) then return private.master_password_reply('disabled');end if;
 select version into v from private.master_password_credentials where master_user_id=(ctx->>'actor')::uuid;
 return private.master_password_reply('ready')||jsonb_build_object('configured',v is not null,'credential_version',coalesce(v,0));
end $$;

create or replace function public.begin_master_password_operation(
 p_device_key text,p_operation text,p_expected_version bigint,p_request_id uuid
) returns jsonb language plpgsql security definer set search_path=pg_catalog,private,public,extensions,pg_temp as $$
declare ctx jsonb; a uuid; v bigint; n text; cid uuid; issued timestamptz; until_at timestamptz;
begin
 ctx:=private.master_password_context(p_device_key);
 if ctx is null then return private.master_password_reply('denied');end if;
 if not coalesce((select enabled from private.master_password_settings where singleton),false) then return private.master_password_reply('disabled');end if;
 if p_operation is null or p_operation not in('setup','change','unlock') or p_request_id is null
  or p_expected_version is null or p_expected_version<0 then return private.master_password_reply('invalid');end if;
 a:=(ctx->>'actor')::uuid;
 select version into v from private.master_password_credentials where master_user_id=a for update;
 if coalesce(v,0)<>p_expected_version or (p_operation='setup' and v is not null)
  or (p_operation<>'setup' and v is null) then return private.master_password_reply('conflict');end if;
 select locked_until into until_at from private.master_password_attempts where actor=a;
 if until_at>clock_timestamp() then return private.master_password_reply('locked');end if;
 if exists(select 1 from private.master_password_challenges where request_id=p_request_id) then return private.master_password_reply('conflict');end if;
 -- Limit unconsumed challenge creation; no password-derived payload is stored.
 if (select count(*) from private.master_password_challenges where actor=a and consumed_at is null and expires_at>clock_timestamp())>=5 then return private.master_password_reply('locked');end if;
 n:=encode(gen_random_bytes(32),'hex'); cid:=gen_random_uuid(); issued:=clock_timestamp();
 insert into private.master_password_challenges(id,actor,session_id,device_id,operation,expected_version,request_id,nonce_hash,issued_at,expires_at)
 values(cid,a,(ctx->>'session_id')::uuid,(ctx->>'device_id')::uuid,p_operation,p_expected_version,p_request_id,encode(digest(n,'sha256'),'hex'),issued,issued+interval '120 seconds');
 return private.master_password_reply('challenge')||jsonb_build_object('operation',p_operation,'expected_version',p_expected_version,
  'request_id',p_request_id,'challenge_id',cid,'nonce',n,'expires_at',issued+interval '120 seconds');
end $$;

-- Internal shared completion. Never returns a transferable proof. Public callers
-- cannot choose actor/session/device/version: these come from the locked context/challenge.
create or replace function private.complete_master_password_operation(
 p_device_key text,p_challenge_id uuid,p_nonce text,p_existing_password text,p_new_password text,p_request_id uuid,p_unlock boolean
) returns jsonb language plpgsql security definer set search_path=pg_catalog,private,public,extensions,pg_temp as $$
declare ctx jsonb; a uuid; c private.master_password_challenges%rowtype;
 cred private.master_password_credentials%rowtype; v bigint; ok boolean:=false; result jsonb; failures integer; until_at timestamptz;
begin
 ctx:=private.master_password_context(p_device_key);
 if ctx is null then return private.master_password_reply('denied');end if;
 if not coalesce((select enabled from private.master_password_settings where singleton),false) then return private.master_password_reply('disabled');end if;
 if p_challenge_id is null or p_request_id is null or p_nonce is null or p_nonce!~'^[0-9a-f]{64}$' then return private.master_password_reply('invalid');end if;
 a:=(ctx->>'actor')::uuid;
 select * into cred from private.master_password_credentials where master_user_id=a for update;
 v:=coalesce(cred.version,0);
 select * into c from private.master_password_challenges where id=p_challenge_id for update;
 if not found or c.actor<>a or c.session_id<>(ctx->>'session_id')::uuid or c.device_id<>(ctx->>'device_id')::uuid
  or c.request_id<>p_request_id or c.nonce_hash<>encode(digest(p_nonce,'sha256'),'hex') then return private.master_password_reply('denied');end if;
 if c.consumed_at is not null then return private.master_password_reply('conflict');end if;
 -- Consume even failed credential submissions. Return, do not raise: counters commit.
 update private.master_password_challenges set consumed_at=clock_timestamp() where id=c.id;
 if c.expires_at<=clock_timestamp() then return private.master_password_reply('expired');end if;
 if (p_unlock and c.operation<>'unlock') or (not p_unlock and c.operation='unlock') then return private.master_password_reply('conflict');end if;
 if c.expected_version<>v or (c.operation='setup' and v<>0) or (c.operation<>'setup' and v=0) then return private.master_password_reply('conflict');end if;
 select locked_until into until_at from private.master_password_attempts where actor=a;
 if until_at>clock_timestamp() then return private.master_password_reply('locked');end if;
 if p_existing_password is null or octet_length(p_existing_password)>72 or length(p_existing_password)<1
  or (not p_unlock and (p_new_password is null or length(p_new_password)<8 or octet_length(p_new_password)>72)) then return private.master_password_reply('invalid');end if;
 if c.operation='setup' then
  -- Reuse the existing server verifier, not a client verification boolean.
  -- Existing success/failure counter/timestamp semantics are intentional.
  begin ok:=public.verify_secondary_password(p_existing_password);
  exception when others then ok:=false;end;
 else
  ok:=cred.password_hash=crypt(p_existing_password,cred.password_hash);
 end if;
 if ok is distinct from true then
  insert into private.master_password_attempts(actor,failed_attempts,locked_until) values(a,1,null)
  on conflict(actor) do update set failed_attempts=private.master_password_attempts.failed_attempts+1,
   locked_until=case when private.master_password_attempts.failed_attempts+1>=5 then clock_timestamp()+interval '5 minutes' else null end
  returning failed_attempts into failures;
  return private.master_password_reply(case when failures>=5 then 'locked' else 'not_verified' end);
 end if;
 if c.operation='setup' then
  insert into private.master_password_credentials(master_user_id,password_hash,version)
  values(a,crypt(p_new_password,gen_salt('bf',12)),1);
  v:=1;
 elsif c.operation='change' then
  update private.master_password_credentials set password_hash=crypt(p_new_password,gen_salt('bf',12)),version=version+1,updated_at=clock_timestamp()
  where master_user_id=a and version=c.expected_version returning version into v;
  if not found then return private.master_password_reply('conflict');end if;
 end if;
 update private.master_password_attempts set failed_attempts=0,locked_until=null where actor=a;
 if c.operation in('setup','change') then
  update private.master_password_challenges set consumed_at=clock_timestamp() where actor=a and consumed_at is null;
 end if;
 result:=private.master_password_reply(case when p_unlock then 'verified' else 'applied' end)||jsonb_build_object(
  'operation',c.operation,'request_id',p_request_id,'credential_version',v,'configured',true);
 insert into private.master_password_requests(request_id,actor,session_id,device_id,operation,expected_version,challenge_id,result)
 values(p_request_id,a,c.session_id,c.device_id,c.operation,c.expected_version,c.id,result);
 return result;
end $$;

create or replace function public.complete_master_password_operation(
 p_device_key text,p_challenge_id uuid,p_nonce text,p_existing_password text,p_new_password text,p_request_id uuid
) returns jsonb language sql security definer set search_path=pg_catalog,private as $$
 select private.complete_master_password_operation(p_device_key,p_challenge_id,p_nonce,p_existing_password,p_new_password,p_request_id,false)
$$;
create or replace function public.verify_master_password_operation(
 p_device_key text,p_challenge_id uuid,p_nonce text,p_password text,p_request_id uuid
) returns jsonb language sql security definer set search_path=pg_catalog,private as $$
 select private.complete_master_password_operation(p_device_key,p_challenge_id,p_nonce,p_password,null,p_request_id,true)
$$;
create or replace function public.read_master_password_request(p_device_key text,p_request_id uuid) returns jsonb
language plpgsql security definer set search_path=pg_catalog,private,public,pg_temp as $$
declare ctx jsonb; r jsonb;
begin
 ctx:=private.master_password_context(p_device_key);
 if ctx is null then return private.master_password_reply('denied');end if;
 if not coalesce((select enabled from private.master_password_settings where singleton),false) then return private.master_password_reply('disabled');end if;
 select result into r from private.master_password_requests where request_id=p_request_id and actor=(ctx->>'actor')::uuid
  and session_id=(ctx->>'session_id')::uuid and device_id=(ctx->>'device_id')::uuid;
 if r is null then return private.master_password_reply('not_found')||jsonb_build_object('request_id',p_request_id);end if;
 return private.master_password_reply('found')||jsonb_build_object('request_id',p_request_id,'result',r);
end $$;

revoke all on function private.master_password_reply(text),private.master_password_context(text),
 private.complete_master_password_operation(text,uuid,text,text,text,uuid,boolean) from public,anon,authenticated;
revoke all on function public.master_password_capability(),public.current_master_password_status(text),
 public.begin_master_password_operation(text,text,bigint,uuid),public.complete_master_password_operation(text,uuid,text,text,text,uuid),
 public.verify_master_password_operation(text,uuid,text,text,uuid),public.read_master_password_request(text,uuid) from public,anon;
grant execute on function public.master_password_capability(),public.current_master_password_status(text),
 public.begin_master_password_operation(text,text,bigint,uuid),public.complete_master_password_operation(text,uuid,text,text,text,uuid),
 public.verify_master_password_operation(text,uuid,text,text,uuid),public.read_master_password_request(text,uuid) to authenticated;
do $$ begin
 if exists(select 1 from pg_roles where rolname='service_role') then
  execute 'revoke all on private.master_password_settings,private.master_password_credentials,private.master_password_attempts,private.master_password_challenges,private.master_password_requests from service_role';
  execute 'revoke all on function private.master_password_reply(text),private.master_password_context(text),private.complete_master_password_operation(text,uuid,text,text,text,uuid,boolean) from service_role';
 end if;
end $$;

commit;
