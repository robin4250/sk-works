SELECT jsonb_build_object(
 'functions',(select jsonb_agg(jsonb_build_object('schema',n.nspname,'name',p.proname,'identity',pg_get_function_identity_arguments(p.oid),'oid',p.oid,'metadata',to_jsonb(p)-'prosrc'-'probin'-'prosqlbody','body_md5',md5(p.prosrc)) order by p.oid) from pg_proc p join pg_namespace n on n.oid=p.pronamespace where (n.nspname='private' and p.proname in ('app_referral_dispatch','account_access_allowed')) or (n.nspname='public' and p.proname in ('app_referral_snapshot','app_referral_master_snapshot','app_referral_prepare','app_referral_composer_opened','app_referral_save_settings','is_current_user_master_admin')) or (n.nspname='auth' and p.proname='uid')),
 'relations',(select jsonb_agg(to_jsonb(c)-'relpages'-'reltuples'-'relallvisible'-'relfrozenxid'-'relminmxid' order by c.oid) from pg_class c where c.oid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass,'private.account_deletion_access_restrictions'::regclass,'private.master_admins'::regclass,'public.companies'::regclass,'public.company_members'::regclass,'public.user_profiles'::regclass,'auth.users'::regclass])),
 'columns',(select jsonb_agg(to_jsonb(a) order by a.attrelid,a.attnum) from pg_attribute a where a.attrelid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass,'private.account_deletion_access_restrictions'::regclass,'private.master_admins'::regclass,'public.companies'::regclass,'public.company_members'::regclass,'public.user_profiles'::regclass,'auth.users'::regclass]) and a.attnum>0),
 'constraints',(select jsonb_agg(to_jsonb(c) order by c.oid) from pg_constraint c where c.conrelid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass,'private.account_deletion_access_restrictions'::regclass,'private.master_admins'::regclass,'public.companies'::regclass,'public.company_members'::regclass,'public.user_profiles'::regclass,'auth.users'::regclass]) or c.confrelid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass])),
 'indexes',(select jsonb_agg(to_jsonb(i) order by i.indexrelid) from pg_index i where i.indrelid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass,'private.account_deletion_access_restrictions'::regclass,'private.master_admins'::regclass,'public.companies'::regclass,'public.company_members'::regclass,'public.user_profiles'::regclass,'auth.users'::regclass])),
 'policies',(select coalesce(jsonb_agg(to_jsonb(p) order by p.oid),'[]'::jsonb) from pg_policy p where p.polrelid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass,'private.account_deletion_access_restrictions'::regclass,'private.master_admins'::regclass,'public.companies'::regclass,'public.company_members'::regclass,'public.user_profiles'::regclass,'auth.users'::regclass])),
 'triggers',(select coalesce(jsonb_agg(to_jsonb(t) order by t.oid),'[]'::jsonb) from pg_trigger t where t.tgrelid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass,'private.account_deletion_access_restrictions'::regclass,'private.master_admins'::regclass,'public.companies'::regclass,'public.company_members'::regclass,'public.user_profiles'::regclass,'auth.users'::regclass])),
 'default_acls',(select coalesce(jsonb_agg(to_jsonb(d) order by d.oid),'[]'::jsonb) from pg_default_acl d where d.defaclnamespace=0 or d.defaclnamespace in ('public'::regnamespace,'private'::regnamespace)),
 'schema_acl',(select jsonb_agg(jsonb_build_object('name',n.nspname,'oid',n.oid,'owner',n.nspowner,'acl',n.nspacl) order by n.oid) from pg_namespace n where n.nspname in ('public','private','auth')),
'dependencies',(select coalesce(jsonb_agg(to_jsonb(d) order by d.classid,d.objid,d.objsubid,d.refclassid,d.refobjid,d.refobjsubid,d.deptype),'[]'::jsonb) from pg_depend d where (d.classid='pg_proc'::regclass and d.objid in (select p.oid from pg_proc p join pg_namespace n on n.oid=p.pronamespace where (n.nspname='private' and p.proname in ('app_referral_dispatch','account_access_allowed')) or (n.nspname='public' and p.proname in ('app_referral_snapshot','app_referral_master_snapshot','app_referral_prepare','app_referral_composer_opened','app_referral_save_settings','is_current_user_master_admin')) or (n.nspname='auth' and p.proname='uid'))) or (d.refclassid='pg_proc'::regclass and d.refobjid in (select p.oid from pg_proc p join pg_namespace n on n.oid=p.pronamespace where (n.nspname='private' and p.proname in ('app_referral_dispatch','account_access_allowed')) or (n.nspname='public' and p.proname in ('app_referral_snapshot','app_referral_master_snapshot','app_referral_prepare','app_referral_composer_opened','app_referral_save_settings','is_current_user_master_admin')) or (n.nspname='auth' and p.proname='uid'))) or (d.classid='pg_class'::regclass and d.objid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass,'private.account_deletion_access_restrictions'::regclass,'private.master_admins'::regclass,'public.companies'::regclass,'public.company_members'::regclass,'public.user_profiles'::regclass,'auth.users'::regclass])) or (d.refclassid='pg_class'::regclass and d.refobjid=any(array['private.app_referral_settings'::regclass,'private.app_referral_invitations'::regclass]))),
 'effective_privileges',(select jsonb_agg(jsonb_build_object('role',r.rolname,'schema',n.nspname,'schema_usage',has_schema_privilege(r.oid,n.oid,'USAGE'),'schema_create',has_schema_privilege(r.oid,n.oid,'CREATE')) order by r.oid,n.oid) from pg_roles r cross join pg_namespace n where r.rolname in ('anon','authenticated','service_role','postgres') and n.nspname in ('public','private','auth')),
 'settings',(select jsonb_agg(to_jsonb(s) order by s.id) from private.app_referral_settings s),
 'history',(select jsonb_build_object('count',count(*),'rows_md5',md5(coalesce(jsonb_agg(to_jsonb(i) order by i.id)::text,'[]'))) from private.app_referral_invitations i),
 'new_objects',(select jsonb_build_object(
  'functions',coalesce((select jsonb_agg(jsonb_build_object('schema',n.nspname,'name',p.proname,'identity',pg_get_function_identity_arguments(p.oid))) from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname in ('public','private') and (p.proname like 'app_distribution%' or p.proname='app_referral_save_flags')),'[]'::jsonb),
  'relations',coalesce((select jsonb_agg(jsonb_build_object('schema',n.nspname,'name',c.relname)) from pg_class c join pg_namespace n on n.oid=c.relnamespace where n.nspname in ('public','private') and c.relname like 'app_distribution%'),'[]'::jsonb)))
) AS snapshot;

