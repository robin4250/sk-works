-- REVIEW ONLY. No production apply, UI change or new migration.
-- Preserve existing image references while the initial-beta photo pause remains.
begin;
set local lock_timeout='5s';
do $guard$
declare f record;
begin
 select p.* into f from pg_proc p where p.oid=to_regprocedure('public.save_employee_onboarding_profile(text,text,text,text,text,text,text,text,text,text)');
 if not found or md5(f.prosrc)<>'3e0b34238e7d84abebdbd95593b64949'
 or not f.prosecdef or f.provolatile<>'v' or f.prorettype<>'void'::regtype
 or f.proconfig is distinct from array['search_path=public, private, pg_temp']
 or f.proacl is distinct from '{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}'::aclitem[]
 or pg_get_userbyid(f.proowner)<>'postgres'
 or not has_schema_privilege('authenticated','private','usage') then
  raise exception 'Onboarding profile contract drift; independent review required' using errcode='55000';
 end if;
end $guard$;

CREATE OR REPLACE FUNCTION public.save_employee_onboarding_profile(p_address text, p_blood_type text, p_family_composition text, p_emergency_relation text, p_emergency_name text, p_emergency_phone text, p_emergency_address text, p_portrait_path text, p_my_number_front_path text, p_my_number_back_path text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'private', 'pg_temp'
AS $function$
declare
  v_user_id uuid := auth.uid();
  v_company_id uuid;
  v_invite_id uuid;
  v_reviewer record;
begin
  if v_user_id is null then
    raise exception 'authentication required';
  end if;

  if nullif(trim(coalesce(p_address, '')), '') is null
     or nullif(trim(coalesce(p_blood_type, '')), '') is null
     or nullif(trim(coalesce(p_family_composition, '')), '') is null
     or nullif(trim(coalesce(p_emergency_relation, '')), '') is null
     or nullif(trim(coalesce(p_emergency_name, '')), '') is null
     or nullif(trim(coalesce(p_emergency_phone, '')), '') is null
     or nullif(trim(coalesce(p_emergency_address, '')), '') is null
 then
    raise exception 'required onboarding field missing';
  end if;

  if nullif(trim(coalesce(p_portrait_path,'')),'') is not null
     or nullif(trim(coalesce(p_my_number_front_path,'')),'') is not null
     or nullif(trim(coalesce(p_my_number_back_path,'')),'') is not null then
    raise exception 'official_document_uploads_paused_for_initial_beta';
  end if;

  update public.employee_registration_invites eri
  set address = trim(p_address),
      blood_type = trim(p_blood_type),
      family_composition = trim(p_family_composition),
      emergency_relation = trim(p_emergency_relation),
      emergency_name = trim(p_emergency_name),
      emergency_phone = trim(p_emergency_phone),
      emergency_address = trim(p_emergency_address),
      status = 'approval_pending',
      submitted_at = now()
  where eri.auth_user_id = v_user_id
    and (eri.password_changed_at is not null or eri.identity_verified_at is not null)
    and eri.status in ('profile_pending','approval_pending')
  returning eri.id, eri.company_id into v_invite_id, v_company_id;

  if v_invite_id is null then
    raise exception 'employee onboarding is not ready for profile submission';
  end if;

  for v_reviewer in
    select distinct cm.user_id
    from public.company_members cm
    left join public.company_approval_assignees caa
      on caa.company_id = cm.company_id
     and caa.user_id = cm.user_id
    where cm.company_id = v_company_id
      and (
        cm.role::text in ('owner','admin')
        or caa.user_id is not null
      )
  loop
    perform private.enqueue_notification(
      v_company_id,
      v_reviewer.user_id,
      'approval',
      '従業員の本登録申請',
      '本人情報の登録が完了しました。本登録を確認してください。',
      'employee_onboarding_approval',
      v_invite_id
    );
  end loop;
end;
$function$;

-- CREATE OR REPLACE retains the existing profile RPC OID, signature and ACL.
create function private.read_employee_onboarding_photo_capability()
returns jsonb language plpgsql stable security definer set search_path='' as $cap$
declare subject uuid:=auth.uid(); current_invite record;
begin
 if subject is null or private.account_access_allowed() is not true then
  raise exception 'onboarding capability unavailable' using errcode='42501';
 end if;
 select i.status,
  (i.password_changed_at is not null or i.identity_verified_at is not null) ready,
  (nullif(btrim(i.portrait_path),'') is not null
   or nullif(btrim(i.my_number_front_path),'') is not null
   or nullif(btrim(i.my_number_back_path),'') is not null) has_images
 into current_invite from public.employee_registration_invites i
 where i.auth_user_id=subject order by i.created_at desc nulls last,i.id desc limit 1;
 if not found or current_invite.status is null or current_invite.status not in ('profile_pending','approval_pending')
 or current_invite.ready is not true then
  raise exception 'onboarding capability unavailable' using errcode='42501';
 end if;
 return jsonb_build_object(
  'has_existing_images',current_invite.has_images,
  'photo_upload_allowed',false);
end $cap$;
create function public.employee_onboarding_photo_capability()
returns jsonb language sql stable security invoker set search_path=''
as $$select private.read_employee_onboarding_photo_capability()$$;
revoke all on function private.read_employee_onboarding_photo_capability(),public.employee_onboarding_photo_capability()
 from public,anon,authenticated,service_role;
grant execute on function private.read_employee_onboarding_photo_capability(),public.employee_onboarding_photo_capability()
 to authenticated;
commit;

