-- Review-only approval REQUEST inventory. This never approves or activates a key.
-- Prerequisites: pending registry and possession challenge candidates.
-- No public route/grants; independent owner verification and recovery are absent.
begin;
create table master_device_enrollment_candidate.owner_approval_requests (
 id uuid primary key,
 challenge_id uuid not null unique references master_device_enrollment_candidate.key_possession_challenges(id) on delete restrict,
 pending_id uuid not null references master_device_enrollment_candidate.pending_key_migrations(id) on delete restrict,
 actor uuid not null,
 requester_session uuid not null,
 device_id uuid not null references private.master_devices(id) on delete restrict,
 key_sha256 text not null check(key_sha256 ~ '^[a-f0-9]{64}$'),
 review_nonce text not null unique check(review_nonce ~ '^[a-f0-9]{64}$'),
 status text not null default 'awaiting_independent_owner' check(status='awaiting_independent_owner'),
 created_at timestamptz not null default clock_timestamp(),
 expires_ms double precision not null check(expires_ms>=0 and expires_ms<=9007199254740991 and expires_ms=floor(expires_ms))
);
alter table master_device_enrollment_candidate.owner_approval_requests enable row level security;
revoke all on master_device_enrollment_candidate.owner_approval_requests from public,anon,authenticated;
-- A cancellation is terminal evidence, not an owner approval or key revocation.
-- Keep the original request/nonce/deadline intact for later independent review.
create table master_device_enrollment_candidate.owner_approval_request_cancellations (
 request_id uuid primary key references master_device_enrollment_candidate.owner_approval_requests(id) on delete restrict,
 actor uuid not null,
 requester_session uuid not null,
 cancelled_at timestamptz not null default clock_timestamp()
);
alter table master_device_enrollment_candidate.owner_approval_request_cancellations enable row level security;
revoke all on master_device_enrollment_candidate.owner_approval_request_cancellations from public,anon,authenticated;
-- Evidence receipt only; this does not approve a key or consume the owner request.
create table master_device_enrollment_candidate.owner_decision_evidence (
 request_id uuid primary key references master_device_enrollment_candidate.owner_approval_requests(id) on delete restrict,
 issuer_key_id text not null check(issuer_key_id ~ '^[A-Za-z0-9_-]{1,80}$'),
 decision text not null check(decision in ('approved','denied')),
 attestation_sha256 text not null unique check(attestation_sha256 ~ '^[a-f0-9]{64}$'),
 -- Preserve the actual signed bytes: a digest alone cannot reverify a signature.
 -- These are canonical protocol bytes, not a caller-selected JSON document.
 attestation_payload bytea not null check(octet_length(attestation_payload) between 1 and 2048),
 attestation_signature bytea not null check(octet_length(attestation_signature)=64),
 issued_ms double precision not null,
 expires_ms double precision not null,
 recorded_at timestamptz not null default clock_timestamp(),
 check(issued_ms>=0 and issued_ms=floor(issued_ms) and expires_ms=floor(expires_ms)
  and expires_ms>issued_ms and expires_ms-issued_ms<=120000 and expires_ms<=9007199254740991)
);
alter table master_device_enrollment_candidate.owner_decision_evidence enable row level security;
revoke all on master_device_enrollment_candidate.owner_decision_evidence from public,anon,authenticated;
-- Application-level append-only protection; a privileged operator can still
-- disable triggers. This is not independent immutable custody or a retention API.
create function master_device_enrollment_candidate.reject_owner_evidence_rewrite()
returns trigger language plpgsql set search_path=pg_catalog as $$
begin
 raise exception 'owner decision evidence is append-only' using errcode='55000';
end $$;
revoke all on function master_device_enrollment_candidate.reject_owner_evidence_rewrite() from public,anon,authenticated;
create trigger owner_evidence_append_only before update or delete or truncate
on master_device_enrollment_candidate.owner_decision_evidence
for each statement execute function master_device_enrollment_candidate.reject_owner_evidence_rewrite();
commit;
