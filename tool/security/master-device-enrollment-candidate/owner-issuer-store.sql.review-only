-- Review-only private persistence; no bootstrap API, grants, deployment or device activation.
-- Existing trusted genesis must be reviewed/installed independently; this SQL seeds nothing.
begin;
create table master_device_enrollment_candidate.owner_issuer_heads (
 authority_id uuid primary key,
 epoch integer not null check(epoch between 1 and 65),
 pin jsonb not null check(jsonb_typeof(pin)='object' and octet_length(pin::text)<=65536),
 updated_at timestamptz not null default clock_timestamp()
);
create table master_device_enrollment_candidate.owner_issuer_transitions (
 authority_id uuid not null references master_device_enrollment_candidate.owner_issuer_heads(authority_id) on delete restrict,
 from_epoch integer not null check(from_epoch between 1 and 64),
 to_epoch integer not null check(to_epoch=from_epoch+1),
 previous_sha256 text not null check(previous_sha256 ~ '^[0-9a-f]{64}$'),
 head_sha256 text not null check(head_sha256 ~ '^[0-9a-f]{64}$'),
 authority_checkpoint jsonb not null check(jsonb_typeof(authority_checkpoint)='object' and octet_length(authority_checkpoint::text)<=2048),
 old_pin jsonb not null check(jsonb_typeof(old_pin)='object' and octet_length(old_pin::text)<=65536),
 new_pin jsonb not null check(jsonb_typeof(new_pin)='object' and octet_length(new_pin::text)<=65536),
 signed_payload bytea not null check(octet_length(signed_payload) between 1 and 2048),
 old_signature bytea not null check(octet_length(old_signature)=64),
 new_signature bytea not null check(octet_length(new_signature)=64),
 committed_at timestamptz not null default clock_timestamp(),
 primary key(authority_id,from_epoch),
 unique(authority_id,to_epoch),unique(authority_id,head_sha256)
);
alter table master_device_enrollment_candidate.owner_issuer_heads enable row level security;
alter table master_device_enrollment_candidate.owner_issuer_transitions enable row level security;
revoke all on master_device_enrollment_candidate.owner_issuer_heads from public,anon,authenticated,service_role;
revoke all on master_device_enrollment_candidate.owner_issuer_transitions from public,anon,authenticated,service_role;
-- Ordinary append-only guard only; privileged operators can disable it.
create function master_device_enrollment_candidate.reject_issuer_transition_rewrite()
returns trigger language plpgsql security invoker set search_path=pg_catalog as $$
begin raise exception 'issuer transition evidence is append-only' using errcode='55000';end $$;
revoke all on function master_device_enrollment_candidate.reject_issuer_transition_rewrite() from public,anon,authenticated,service_role;
create trigger issuer_transition_append_only before update or delete or truncate
on master_device_enrollment_candidate.owner_issuer_transitions for each statement
execute function master_device_enrollment_candidate.reject_issuer_transition_rewrite();
commit;
