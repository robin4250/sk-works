-- REVIEW-ONLY isolated candidate. Never execute against production without a
-- reviewed backup, catalog guard, independent policy review and rollout plan.
begin;
create schema security_observation_notice_private;
revoke all on schema security_observation_notice_private from public,anon,authenticated,service_role;
create table security_observation_notice_private.config (
 singleton boolean primary key default true check(singleton),
 enabled boolean not null default false,
 collector_id uuid, company_id uuid, master_id uuid,
 revision bigint not null default 1 check(revision>0),
 check(not enabled or (collector_id is not null and company_id is not null and master_id is not null))
);
insert into security_observation_notice_private.config(singleton) values(true);
create table security_observation_notice_private.outbox (
 event_id uuid primary key, collector_id uuid not null,
 company_id uuid not null, recipient_id uuid not null, config_revision bigint not null,
 state text not null default 'pending' check(state in ('pending','available','held_binding','held_evidence')),
 created_at timestamptz not null default clock_timestamp(), updated_at timestamptz not null default clock_timestamp()
);
create table security_observation_notice_private.inbox (
 event_id uuid primary key, company_id uuid not null, recipient_id uuid not null,
 event_kind text not null check(event_kind in ('current_lure_touched','retired_lure_touched')),
 generation integer not null, occurred_at timestamptz not null,
 available_at timestamptz not null default clock_timestamp(), read_at timestamptz
);
create table security_observation_notice_private.audit (
 audit_id bigint generated always as identity primary key,
 event_id uuid not null, action text not null check(action in ('queued','available','held_binding','held_evidence','read')),
 actor_id uuid, occurred_at timestamptz not null default clock_timestamp()
);
alter table security_observation_notice_private.config enable row level security;
alter table security_observation_notice_private.outbox enable row level security;
alter table security_observation_notice_private.inbox enable row level security;
alter table security_observation_notice_private.audit enable row level security;
revoke all on all tables in schema security_observation_notice_private from public,anon,authenticated,service_role;
revoke all on all sequences in schema security_observation_notice_private from public,anon,authenticated,service_role;
-- This executes only on insertion of already MAC-authenticated evidence inside
-- the original collector transaction. A rejected evidence row rolls this back.
create function security_observation_notice_private.queue_evidence() returns trigger language plpgsql security definer set search_path='' as $$
declare cfg security_observation_notice_private.config%rowtype;
begin
 select * into cfg from security_observation_notice_private.config where singleton for share;
 if not found or not cfg.enabled then return new; end if;
 if new.collector_id is distinct from cfg.collector_id or private.verify_collector_event_evidence(new.event_id) is not true then
  raise exception 'observation_notice_untrusted' using errcode='42501';
 end if;
 insert into security_observation_notice_private.outbox(event_id,collector_id,company_id,recipient_id,config_revision)
 values(new.event_id,cfg.collector_id,cfg.company_id,cfg.master_id,cfg.revision) on conflict(event_id) do nothing;
 if found then insert into security_observation_notice_private.audit(event_id,action) values(new.event_id,'queued'); end if;
 return new;
end $$;
revoke all on function security_observation_notice_private.queue_evidence() from public,anon,authenticated,service_role;
create trigger observation_notice_evidence_insert after insert on private.security_collector_evidence
 for each row execute function security_observation_notice_private.queue_evidence();
-- In-DB publication is atomic and idempotent. This does not send push/email.
create function security_observation_notice_private.publish(p_event_id uuid) returns text language plpgsql security definer set search_path='' as $$
declare o security_observation_notice_private.outbox%rowtype; e private.security_collector_events%rowtype; cfg security_observation_notice_private.config%rowtype; outcome text; master_valid boolean; membership_valid boolean;
begin
 if auth.role() is distinct from 'service_role' then raise exception 'notice_denied' using errcode='42501'; end if;
 select * into o from security_observation_notice_private.outbox where event_id=p_event_id for update;
 if not found then raise exception 'notice_not_found' using errcode='42501';end if;
 if o.state<>'pending' then return o.state; end if;
 select * into cfg from security_observation_notice_private.config where singleton for share;
 perform 1 from private.master_admins where user_id=o.recipient_id and enabled for share; master_valid:=found;
 perform 1 from public.company_members where company_id=o.company_id and user_id=o.recipient_id and role::text in ('owner','admin') for share; membership_valid:=found;
 if cfg.singleton is null or not cfg.enabled or cfg.revision<>o.config_revision or cfg.collector_id<>o.collector_id or cfg.company_id<>o.company_id or cfg.master_id<>o.recipient_id or
    not master_valid or not membership_valid then
  outcome:='held_binding';
 elsif private.verify_collector_event_evidence(o.event_id) is not true then outcome:='held_evidence';
 else
  select * into strict e from private.security_collector_events where event_id=o.event_id;
  insert into security_observation_notice_private.inbox(event_id,company_id,recipient_id,event_kind,generation,occurred_at)
  values(o.event_id,o.company_id,o.recipient_id,e.event_kind,e.generation,e.occurred_at) on conflict(event_id) do nothing;
  outcome:='available';
 end if;
 update security_observation_notice_private.outbox set state=outcome,updated_at=clock_timestamp() where event_id=o.event_id;
 insert into security_observation_notice_private.audit(event_id,action) values(o.event_id,outcome);
 return outcome;
end $$;
revoke all on function security_observation_notice_private.publish(uuid) from public,anon,authenticated,service_role;
-- Only caller's own currently enabled Master and company membership may read.
-- The existing collector-specific one-use proof is consumed in this transaction.
create function public.read_security_observation_notices(p_proof text) returns jsonb language plpgsql security definer set search_path='' as $$
declare actor uuid:=auth.uid(); sid uuid; cfg security_observation_notice_private.config%rowtype; result jsonb;
begin
 if current_setting('request.method',true) is distinct from 'POST' then raise sqlstate 'PT405' using message='post_required';end if;
 sid:=private.require_reauthentication_session();
 if actor is null or sid is null or private.account_access_allowed() is not true or public.is_current_user_master_admin() is not true then
  raise exception 'notice_denied' using errcode='42501';end if;
 select * into cfg from security_observation_notice_private.config where singleton for share;
 if not found or not cfg.enabled or cfg.master_id is distinct from actor then raise exception 'notice_denied' using errcode='42501';end if;
 perform 1 from private.master_admins where user_id=actor and enabled for share;
 if not found then raise exception 'notice_denied' using errcode='42501';end if;
 perform 1 from public.company_members where company_id=cfg.company_id and user_id=actor and role::text in ('owner','admin') for share;
 if not found then raise exception 'notice_denied' using errcode='42501';end if;
 perform private.consume_reauthentication_proof('master.security_collector.read','{"scope":"decoy_collector"}'::jsonb,p_proof);
 if exists(select 1 from security_observation_notice_private.inbox i
  left join private.security_collector_events e on e.event_id=i.event_id
  where i.company_id=cfg.company_id and i.recipient_id=actor and
   (e.event_id is null or e.collector_id is distinct from cfg.collector_id or
    e.event_kind is distinct from i.event_kind or e.generation is distinct from i.generation or
    e.occurred_at is distinct from i.occurred_at or private.verify_collector_event_evidence(i.event_id) is not true)) then
  raise exception 'notice_evidence_invalid' using errcode='55000';end if;
 select coalesce(jsonb_agg(x order by x.occurred_at desc,x.event_id),'[]'::jsonb) into result from (
  select event_id,event_kind,generation,occurred_at,available_at,read_at,
   'decoy_generation_only'::text as scope,'observed'::text as state
  from security_observation_notice_private.inbox
  where company_id=cfg.company_id and recipient_id=actor
  order by occurred_at desc,event_id limit 100
 ) x;
 return jsonb_build_object('version',1,'coverage','collector_observations_only','attack_confirmed',false,'events',result);
end $$;
revoke all on function public.read_security_observation_notices(text) from public,anon,service_role;
grant execute on function public.read_security_observation_notices(text) to authenticated;
-- Publication is intentionally not exposed until the fixed service endpoint,
-- authorization, deadlines and hosted delivery are independently reviewed.
commit;
