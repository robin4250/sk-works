-- REVIEW ONLY. R19 dependency; no automatic migration or production execution.
begin;
set local lock_timeout='5s';
set local statement_timeout='30s';
create policy r21_boundary on public.invoices as restrictive for all to authenticated
using(private.r19_invoice_allowed(id)) with check(private.r19_invoice_allowed(id));
create policy r21_boundary on public.communication_groups as restrictive for all to authenticated
using(private.r19_group_allowed(id)) with check(private.r19_group_allowed(id));
create policy r21_boundary on public.communication_notes as restrictive for all to authenticated
using(private.r19_group_allowed(group_id)) with check(private.r19_group_allowed(group_id));
create policy r21_boundary on public.communication_albums as restrictive for all to authenticated
using(private.r19_group_allowed(group_id)) with check(private.r19_group_allowed(group_id));
create policy r21_boundary on public.communication_album_items as restrictive for all to authenticated
using(private.r19_group_allowed(group_id)) with check(private.r19_group_allowed(group_id));
do $patch$
declare target record; f record; body text; anchor integer;
begin
 for target in select * from(values
 ('public.approve_invoice(uuid)','5bc1e283ca727de24f5cf12fac15884c'),
 ('public.cancel_invoice_approval(uuid)','230e478080979e8efc2719a5f639b6b5'),
 ('public.set_invoice_stamp_display_date(uuid,uuid,date)','1602e388c83dce224ac7ca5ebce4f6a6')
 )t(signature,expected_hash)loop
  select p.oid,p.prosrc,p.proowner,p.proacl,p.proconfig,p.prosecdef,
  pg_get_functiondef(p.oid) definition into f from pg_proc p where p.oid=to_regprocedure(target.signature);
  if not found or md5(f.prosrc)<>target.expected_hash or not f.prosecdef
    or pg_get_userbyid(f.proowner)<>'postgres' then
    raise exception 'Target definition/owner drift; review required' using errcode='55000';end if;
  anchor:=strpos(f.prosrc,E'\nbegin\n');
  if anchor=0 or strpos(f.definition,f.prosrc)=0 then raise exception 'Body layout drift' using errcode='55000';end if;
  body:=substr(f.prosrc,1,anchor+6)||E'\n if not private.r19_invoice_allowed(p_invoice_id) then raise exception ''protected artifact unavailable'' using errcode=''42501''; end if;'||substr(f.prosrc,anchor+7);
  execute replace(f.definition,f.prosrc,body);
  if not exists(select 1 from pg_proc p where p.oid=f.oid and p.proowner=f.proowner
    and p.proacl is not distinct from f.proacl and p.proconfig is not distinct from f.proconfig and p.prosecdef=f.prosecdef)then
    raise exception 'Target metadata changed' using errcode='55000';end if;
 end loop;
end $patch$;
commit;
