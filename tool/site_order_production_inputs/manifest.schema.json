{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline site order production inputs \u2014 never deployment authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "sources",
    "captures",
    "operational_evidence"
  ],
  "properties": {
    "contract": {
      "const": "sko.site_order.production_inputs.v1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "source_path",
          "mode",
          "artifact"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_path": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "exact_source",
              "actor_only"
            ]
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "captures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relations",
        "functions",
        "namespaces_default_acl",
        "callers_and_edge_sql"
      ],
      "properties": {
        "relations": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "functions": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "namespaces_default_acl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "callers_and_edge_sql": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "operational_evidence": {
      "type": "null",
      "description": "No independently registered real held-closure/drain receipt exists in this candidate. Boolean or caller-authored claims are forbidden."
    }
  }
}
