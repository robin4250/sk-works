-- Review-only private challenge ledger. Does not enable registration, issue the
-- qr.scanner.register reauthentication proof, publish a route, or write attendance.
begin;
create table qr_attendance_private.scanner_key_challenges(
 id uuid primary key default gen_random_uuid(), company_id uuid not null,
 actor_id uuid not null, session_id uuid not null, device_id uuid not null,
 public_key_hex text not null check(public_key_hex ~ '^302a300506032b6570032100[0-9a-f]{64}$'),
 nonce uuid not null default gen_random_uuid(), created_ms bigint not null,
 expires_ms bigint not null, consumed_at timestamptz,
 check(expires_ms>created_ms and expires_ms-created_ms<=90000)
);
alter table qr_attendance_private.scanner_key_challenges enable row level security;
revoke all on qr_attendance_private.scanner_key_challenges from public,anon,authenticated,service_role;
create function qr_attendance_private.require_registration_actor(p_company uuid)
returns jsonb language plpgsql security definer set search_path='' as $$
declare actor uuid:=auth.uid();sid uuid;
begin
 perform qr_attendance_private.require_enabled();
 sid:=private.require_reauthentication_session();
 if actor is null or sid is null or p_company is null then raise sqlstate '42501';end if;
 perform 1 from auth.users where id=actor and deleted_at is null and not coalesce(is_anonymous,false)
  and (banned_until is null or banned_until<=clock_timestamp()) for share;
 if not found then raise sqlstate '42501';end if;
 perform 1 from auth.sessions where id=sid and user_id=actor for share;
 if not found then raise sqlstate '42501';end if;
 perform 1 from public.company_members where company_id=p_company and user_id=actor for share;
 if not found or private.has_company_feature(p_company,'can_manage_attendance') is distinct from true then raise sqlstate '42501';end if;
 return jsonb_build_object('actor',actor,'session',sid);
end$$;
create function qr_attendance_private.issue_scanner_key_challenge(p_company uuid,p_device uuid,p_key text)
returns uuid language plpgsql security definer set search_path='' as $$
declare principal jsonb;stamp bigint;result uuid;old qr_attendance_private.scanner_key_challenges%rowtype;
begin
 principal:=qr_attendance_private.require_registration_actor(p_company);
 if p_device is null or p_key is null or p_key !~ '^302a300506032b6570032100[0-9a-f]{64}$' then raise sqlstate '42501';end if;
 if not pg_try_advisory_xact_lock(hashtextextended('sko-qr-scanner-registration:'||p_device::text,0)) then raise sqlstate '55P03';end if;
 if exists(select 1 from qr_attendance_private.registered_scanners where device_id=p_device and
  (company_id<>p_company or actor_id<>(principal->>'actor')::uuid or public_key_der<>decode(p_key,'hex') or revoked_at is not null)) then raise sqlstate '42501';end if;
 stamp:=floor(extract(epoch from clock_timestamp())*1000)::bigint;
 select * into old from qr_attendance_private.scanner_key_challenges where device_id=p_device and actor_id=(principal->>'actor')::uuid
  and session_id=(principal->>'session')::uuid and consumed_at is null and expires_ms>stamp order by created_ms desc limit 1 for update;
 if found then
  if old.company_id<>p_company or old.public_key_hex<>p_key then raise sqlstate '42501';end if;
  return old.id;
 end if;
 insert into qr_attendance_private.scanner_key_challenges(company_id,actor_id,session_id,device_id,public_key_hex,created_ms,expires_ms)
  values(p_company,(principal->>'actor')::uuid,(principal->>'session')::uuid,p_device,p_key,stamp,stamp+90000) returning id into result;
 return result;
end$$;
create function qr_attendance_private.load_scanner_key_challenge(p_id uuid)
returns jsonb language plpgsql security definer set search_path='' as $$
declare row qr_attendance_private.scanner_key_challenges%rowtype;principal jsonb;stamp bigint;
begin
 select * into row from qr_attendance_private.scanner_key_challenges where id=p_id for update;
 if not found then raise sqlstate '42501';end if;
 principal:=qr_attendance_private.require_registration_actor(row.company_id);
 stamp:=floor(extract(epoch from clock_timestamp())*1000)::bigint;
 if row.actor_id is distinct from (principal->>'actor')::uuid or row.session_id is distinct from (principal->>'session')::uuid
  or row.consumed_at is not null or stamp<row.created_ms or stamp>=row.expires_ms then raise sqlstate '42501';end if;
 return jsonb_build_object('id',row.id,'company',row.company_id,'actor',row.actor_id,'session',row.session_id,'device',row.device_id,
  'keyHex',row.public_key_hex,'nonce',row.nonce,'createdMs',row.created_ms,'expiresMs',row.expires_ms,'databaseNowMs',stamp);
end$$;
create function qr_attendance_private.consume_scanner_key_challenge(p_id uuid)
returns void language plpgsql security definer set search_path='' as $$
declare value jsonb;n integer;
begin
 value:=qr_attendance_private.load_scanner_key_challenge(p_id);
 update qr_attendance_private.scanner_key_challenges set consumed_at=clock_timestamp() where id=p_id and consumed_at is null;
 get diagnostics n=row_count;if n<>1 then raise sqlstate '42501';end if;
end$$;
revoke all on function qr_attendance_private.require_registration_actor(uuid),
 qr_attendance_private.issue_scanner_key_challenge(uuid,uuid,text),
 qr_attendance_private.load_scanner_key_challenge(uuid),qr_attendance_private.consume_scanner_key_challenge(uuid)
 from public,anon,authenticated,service_role;
commit;
