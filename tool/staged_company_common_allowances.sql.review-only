-- REVIEW ONLY, outside migrations. No production application or payroll caller.
-- Old three slots remain canonical in company_rate_settings and keep the existing
-- random-UUID lifecycle. Extras use one new catalog; no payroll/daily writes.
begin;
set local lock_timeout = '5s';
-- Fail closed on baseline source drift. Install/review the existing staged legacy
-- lifecycle separately; this candidate does not replace it or its privileges.
do $guard$ begin
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='slots' and md5(p.prosrc)='08dd77edfe0b00d0eb19dbe66d8ac00e' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is false and has_function_privilege('authenticated',p.oid,'EXECUTE') is false and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='authorize' and md5(p.prosrc)='5ea0f7018e87c041776be016c713587f' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is false and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='advance' and md5(p.prosrc)='88bd7ea35e6b37d86569571995f655fd' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is false and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='current_value' and md5(p.prosrc)='3e2c6cd120c22e297e6cbc7656a8faa9' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is false and has_function_privilege('authenticated',p.oid,'EXECUTE') is false and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='track_settings' and md5(p.prosrc)='a518232a914a4b498a3a7a04a6e92bbd' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is false and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='prevent_settings_delete' and md5(p.prosrc)='ccc2d457a0ad85c4b4d02bcb14bec031' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is false and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='prevent_reinsert' and md5(p.prosrc)='13ce1c6eff6617e855f10e299716efb9' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is false and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='admin_state' and md5(p.prosrc)='07c8fdc8fe3602ac962596c7caa98206' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is true and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='history_page' and md5(p.prosrc)='1714d3e87f40c0c8de37715097f15de4' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is true and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='adopt' and md5(p.prosrc)='282c9d6682afce8ec7c355a90cb77d8c' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is true and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='labels' and md5(p.prosrc)='835f268de21abf694c10ccf764477543' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is true and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
 if not exists(select 1 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='company_allowance_identity_private' and p.proname='edit_slot' and md5(p.prosrc)='7be66e2c3a683e522b44ede1d8205647' and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=""'] and p.prosecdef is true and has_function_privilege('authenticated',p.oid,'EXECUTE') is true and not has_function_privilege('anon',p.oid,'EXECUTE') and not has_function_privilege('service_role',p.oid,'EXECUTE')) then raise exception 'legacy allowance source baseline drift' using errcode='55000';end if;
end $guard$;
do $guard$ begin
 if not exists(select 1 from pg_proc p where p.oid='public.my_attendance_allowance_units()'::regprocedure
 and md5(p.prosrc)='17310735021c3a953a093ed196261468' and p.prosecdef
 and pg_get_userbyid(p.proowner)=current_user and p.proconfig=array['search_path=public, pg_temp']
 and has_function_privilege('authenticated',p.oid,'EXECUTE') and not has_function_privilege('anon',p.oid,'EXECUTE')) then
 raise exception 'attendance allowance unit source baseline drift' using errcode='55000';end if;
end $guard$;
create schema company_common_allowance_private;
revoke all on schema company_common_allowance_private from public,anon,authenticated,service_role;
create table company_common_allowance_private.state (
 company_id uuid primary key, version bigint not null check(version between 0 and 9007199254740991),
 created_by uuid not null, created_at timestamptz not null default clock_timestamp()
);
create table company_common_allowance_private.items (
 id uuid primary key default gen_random_uuid(),company_id uuid not null,
 payroll_type text not null check(payroll_type in ('daily','hourly','monthly')),
 section text not null check(section in ('earning','deduction')),
 unit text not null check(unit in ('hour','day','month')),
 name text not null check(length(name) between 1 and 80 and name=btrim(name)),
 amount_yen integer not null check(amount_yen>=0),position integer not null check(position>=0),
 created_by uuid not null,created_at timestamptz not null default clock_timestamp(),
 updated_by uuid not null,updated_at timestamptz not null default clock_timestamp(),
 retired_by uuid,retired_at timestamptz,
 unique(company_id,id),check((retired_by is null)=(retired_at is null))
);
create index company_common_allowance_active on company_common_allowance_private.items(company_id,payroll_type,position,id) where retired_at is null;
create table company_common_allowance_private.history (
 company_id uuid not null,version bigint not null,actor_id uuid not null,
 changed_at timestamptz not null default clock_timestamp(),payroll_type text,
 request_id uuid not null,operation text not null,before_value jsonb not null,after_value jsonb not null,
 primary key(company_id,version)
);
-- Price-free compatibility baseline, created only by an explicit allowance save.
create table company_common_allowance_private.unit_aliases (
 company_id uuid primary key,units jsonb not null check(jsonb_typeof(units)='object'),
 observations jsonb not null default '{}'::jsonb check(jsonb_typeof(observations)='object'),
 adopted_by uuid not null,adopted_at timestamptz not null default clock_timestamp()
);
alter table company_common_allowance_private.unit_aliases enable row level security;
create table company_common_allowance_private.requests (
 company_id uuid not null,request_id uuid not null,actor_id uuid not null,
 payroll_type text,operation text not null,expected_version bigint not null,
 request_payload jsonb not null,committed_version bigint not null,result jsonb not null,
 primary key(company_id,request_id)
);
alter table company_common_allowance_private.state enable row level security;
alter table company_common_allowance_private.items enable row level security;
alter table company_common_allowance_private.history enable row level security;
alter table company_common_allowance_private.requests enable row level security;
revoke all on all tables in schema company_common_allowance_private from public,anon,authenticated,service_role;

-- Exactly the old RPC's trim/default/duplicate-key-winner projection, not price.
create function company_common_allowance_private.current_units(cid uuid) returns jsonb
language sql stable set search_path='' as $$
 select jsonb_strip_nulls(jsonb_build_object(
 coalesce(nullif(trim(r.allowance_1_name),''),'__none1'),coalesce(nullif(trim(r.allowance_1_unit),''),'回'),
 coalesce(nullif(trim(r.allowance_2_name),''),'__none2'),coalesce(nullif(trim(r.allowance_2_unit),''),'回'),
 coalesce(nullif(trim(r.allowance_3_name),''),'__none3'),coalesce(nullif(trim(r.allowance_3_unit),''),'回')))-'__none1'-'__none2'-'__none3'
 from public.company_rate_settings r where r.company_id=cid
$$;
create function company_common_allowance_private.protect_unit_aliases() returns trigger
language plpgsql volatile security definer set search_path='' as $$
declare baseline jsonb;current_map jsonb;observed jsonb;xid text:=pg_postmaster_start_time()::text||':'||pg_current_xact_id()::text;
begin
 select units,observations into baseline,observed from company_common_allowance_private.unit_aliases where company_id=new.company_id for update;
 if not found then return new;end if;
 current_map:=company_common_allowance_private.current_units(new.company_id);
 if exists(select 1 from jsonb_each(current_map) x where baseline ? x.key and baseline->x.key is distinct from x.value and observed->>x.key is distinct from xid) then
  raise exception 'past allowance display unit requires dated compatibility' using errcode='22023';end if;
 select observed||coalesce(jsonb_object_agg(x.key,to_jsonb(xid)) filter(where not(baseline ? x.key)),'{}'::jsonb) into observed from jsonb_each(current_map) x;
 update company_common_allowance_private.unit_aliases set units=baseline||current_map,observations=observed where company_id=new.company_id;
 return new;
end $$;
create trigger company_common_allowance_unit_compat after update on public.company_rate_settings
for each row execute function company_common_allowance_private.protect_unit_aliases();
create function company_common_allowance_private.merge_unit_aliases(cid uuid,current_map jsonb) returns jsonb
language plpgsql stable security definer set search_path='' as $$
begin
 -- Keep original ordinary-member visibility, not the new admin price scope.
 if auth.uid() is null or not exists(select 1 from public.company_members where company_id=cid and user_id=auth.uid()) then
  raise exception 'attendance allowance access denied' using errcode='42501';end if;
 if not exists(select 1 from public.companies where id=cid) then return coalesce(current_map,'{}'::jsonb);end if;
 return coalesce((select a.units from company_common_allowance_private.unit_aliases a where a.company_id=cid),'{}'::jsonb)||coalesce(current_map,'{}'::jsonb);
end $$;
create function company_common_allowance_private.session_id() returns uuid
language plpgsql stable security definer set search_path='' as $$
declare claims jsonb:=auth.jwt();sid text:=claims->>'session_id';
begin
 if auth.uid() is null or private.account_access_allowed() is not true
 or claims->>'role' is distinct from 'authenticated' or claims->>'is_anonymous'='true'
 or sid is null or sid !~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
 or not exists(select 1 from auth.sessions where id=sid::uuid and user_id=auth.uid() and (not_after is null or not_after>clock_timestamp())) then
  raise exception 'company common allowance session unavailable' using errcode='42501';end if;
 return sid::uuid;
end $$;
create function company_common_allowance_private.authorize(cid uuid,editing boolean) returns boolean
language plpgsql stable security definer set search_path='' as $$
declare actor_role text;
begin
 perform company_common_allowance_private.session_id();
 if not exists(select 1 from public.companies where id=cid) then
  raise exception 'company common allowance access denied' using errcode='42501';end if;
 select role::text into actor_role from public.company_members where company_id=cid and user_id=auth.uid();
 if actor_role is null or actor_role not in ('owner','admin','viewer')
 or (editing and actor_role not in ('owner','admin')) then
  raise exception 'company common allowance access denied' using errcode='42501';end if;
 return actor_role in ('owner','admin');
end $$;
-- Writer order company -> settings -> legacy identity -> new state. Session and
-- membership are revalidated/locked after all earlier waits, not only at entry.
create function company_common_allowance_private.lock_writer(cid uuid) returns void
language plpgsql volatile security definer set search_path='' as $$
declare sid uuid;
begin
 perform company_common_allowance_private.authorize(cid,true);
 perform 1 from public.companies where id=cid for update;
 if not found then raise exception 'company common allowance access denied' using errcode='42501';end if;
 perform 1 from public.company_rate_settings where company_id=cid for update;
 if not found then raise exception 'legacy allowance settings unavailable' using errcode='55000';end if;
 perform 1 from company_allowance_identity_private.state where company_id=cid for update;
 perform 1 from public.company_members where company_id=cid and user_id=auth.uid() and role::text in ('owner','admin') for share;
 if not found then raise exception 'company common allowance access denied' using errcode='42501';end if;
 sid:=company_common_allowance_private.session_id();
 perform 1 from auth.sessions where id=sid and user_id=auth.uid() and (not_after is null or not_after>clock_timestamp()) for share;
 if not found then raise exception 'company common allowance session unavailable' using errcode='42501';end if;
 perform company_common_allowance_private.authorize(cid,true);
end $$;
create function company_common_allowance_private.source(cid uuid) returns jsonb
language sql stable set search_path='' as $$
 select jsonb_build_object('legacy_adopted',s.company_id is not null,'legacy_version',coalesce(s.version,0),
 'legacy_slots',company_allowance_identity_private.slots(r),'tax_rate',c.tax_rate,'welfare_rate',c.default_welfare_rate)
 from public.companies c join public.company_rate_settings r on r.company_id=c.id
 left join company_allowance_identity_private.state s on s.company_id=c.id where c.id=cid
$$;
create function company_common_allowance_private.active_items(cid uuid,typ text default null) returns jsonb
language sql stable set search_path='' as $$
 select coalesce(jsonb_agg(jsonb_build_object('id',i.id,'payroll_type',i.payroll_type,
 'section',i.section,'unit',i.unit,'name',i.name,'amount_yen',i.amount_yen)
 order by i.payroll_type,i.position,i.id),'[]'::jsonb)
 from company_common_allowance_private.items i
 where i.company_id=cid and i.retired_at is null and (typ is null or i.payroll_type=typ)
$$;
create function company_common_allowance_private.admin_state(cid uuid) returns jsonb
language plpgsql stable security definer set search_path='' as $$
declare editable boolean;source_value jsonb;refs jsonb;
begin
 editable:=company_common_allowance_private.authorize(cid,false);
 source_value:=company_common_allowance_private.source(cid);
 if source_value is null then raise exception 'legacy allowance settings unavailable' using errcode='55000';end if;
 select jsonb_agg(jsonb_build_object('slot',(item->>'slot')::integer,'id',i.id,'generation',i.generation,
 'applicability','all','section','earning','unit','day','name',item->'name','source_unit',item->'unit','amount_yen',item->'amount_yen') order by (item->>'slot')::integer)
 into refs from jsonb_array_elements(source_value->'legacy_slots') item
 left join company_allowance_identity_private.identities i on i.company_id=cid and i.slot=(item->>'slot')::integer and i.retired_at is null;
 return jsonb_build_object('contract_version',1,'company_id',cid,'can_edit',editable,
 'version',coalesce((select s.version from company_common_allowance_private.state s where s.company_id=cid),0),
 'expected_source',source_value,'tax_rate',source_value->'tax_rate','welfare_rate',source_value->'welfare_rate',
 'items',company_common_allowance_private.active_items(cid),'legacy_refs',refs);
end $$;
create function company_common_allowance_private.request_result(cid uuid,rid uuid) returns jsonb
language plpgsql stable security definer set search_path='' as $$
declare r company_common_allowance_private.requests%rowtype;
begin
 perform company_common_allowance_private.authorize(cid,true);
 if rid is null then raise exception 'invalid request id' using errcode='22023';end if;
 select * into r from company_common_allowance_private.requests where company_id=cid and request_id=rid and actor_id=auth.uid();
 if not found then return jsonb_build_object('contract_version',1,'company_id',cid,'request_id',rid,'found',false);end if;
 return jsonb_build_object('contract_version',1,'company_id',cid,'request_id',rid,'found',true,
 'actor_id',r.actor_id,'operation',r.operation,'payroll_type',r.payroll_type,'expected_version',r.expected_version,
 'request_payload',r.request_payload,'committed_version',r.committed_version,'result',r.result);
end $$;
create function company_common_allowance_private.save(cid uuid,typ text,expected bigint,expected_source jsonb,rid uuid,input_items jsonb,legacy_input jsonb,confirm_adoption boolean) returns jsonb
language plpgsql volatile security definer set search_path='' as $$
declare v bigint;payload jsonb;receipt company_common_allowance_private.requests%rowtype;
 item jsonb;item_id uuid;seen uuid[]:='{}';keys_seen text[]:='{}';key text;pos integer:=0;
 before_items jsonb;before_legacy jsonb;outcome jsonb;mapping jsonb:='[]';legacy_item jsonb;ref jsonb;legacy_version bigint;
begin
 perform company_common_allowance_private.authorize(cid,true);
 if typ is null or typ not in ('daily','hourly','monthly') or expected is null or expected<0 or expected>9007199254740990
 or rid is null or input_items is null or jsonb_typeof(input_items)<>'array'
 or jsonb_array_length(input_items)>100 or octet_length(input_items::text)>131072 then
  raise exception 'invalid company common allowance request' using errcode='22023';end if;
 perform company_common_allowance_private.lock_writer(cid);
 payload:=jsonb_build_object('operation','allowances','payroll_type',typ,'expected_version',expected,'expected_source',expected_source,'items',input_items,'legacy_slots',legacy_input,'confirm_adoption',confirm_adoption);
 select * into receipt from company_common_allowance_private.requests where company_id=cid and request_id=rid;
 if found then
  if receipt.actor_id is distinct from auth.uid() or receipt.request_payload is distinct from payload then
   raise exception 'request id payload mismatch' using errcode='22023';end if;
  return receipt.result;
 end if;
 insert into company_common_allowance_private.state(company_id,version,created_by)
 values(cid,0,auth.uid()) on conflict(company_id) do nothing;
 select version into v from company_common_allowance_private.state where company_id=cid for update;
 if v<>expected or expected_source is distinct from company_common_allowance_private.source(cid) then raise exception 'company common allowance version conflict' using errcode='40001';end if;
 -- Validate three references against the observed source BEFORE first adoption.
 before_legacy:=company_common_allowance_private.admin_state(cid)->'legacy_refs';
 if legacy_input is null or jsonb_typeof(legacy_input)<>'array' or jsonb_array_length(legacy_input)<>3 or octet_length(legacy_input::text)>8192 then
  raise exception 'invalid legacy allowance snapshot' using errcode='22023';end if;
 for pos in 0..2 loop
  legacy_item:=legacy_input->pos;ref:=before_legacy->pos;
  if jsonb_typeof(legacy_item)<>'object' or (select count(*) from jsonb_object_keys(legacy_item))<>6
  or not(legacy_item ?& array['slot','id','generation','name','source_unit','amount_yen'])
  or legacy_item->'slot' is distinct from ref->'slot' or legacy_item->'id' is distinct from ref->'id'
  or legacy_item->'generation' is distinct from ref->'generation'
  or (legacy_item->'source_unit' is distinct from ref->'source_unit' and (jsonb_typeof(legacy_item->'source_unit')<>'string' or length(btrim(legacy_item->>'source_unit')) not between 1 and 12))
  or (legacy_item->'name' is distinct from ref->'name' and ((legacy_item->'name'<>'null'::jsonb and jsonb_typeof(legacy_item->'name')<>'string') or length(btrim(coalesce(legacy_item->>'name','')))>80))
  or jsonb_typeof(legacy_item->'amount_yen')<>'number' or legacy_item->>'amount_yen' !~ '^(0|[1-9][0-9]*)$'
  or (legacy_item->>'amount_yen')::numeric>2147483647 then
   raise exception 'invalid legacy allowance reference' using errcode='22023';end if;
 end loop;
 insert into company_common_allowance_private.unit_aliases(company_id,units,adopted_by)
 values(cid,company_common_allowance_private.current_units(cid),auth.uid()) on conflict(company_id) do nothing;
 if (expected_source->>'legacy_adopted')::boolean is not true then
  if confirm_adoption is not true then raise exception 'explicit legacy adoption confirmation required' using errcode='22023';end if;
  perform company_allowance_identity_private.adopt(cid,expected_source->'legacy_slots',true);
 end if;
 -- Only the legacy names/amounts/explicit display units are updated. Tax and
 -- other rate columns stay untouched; existing trigger supplies the original UUID lifecycle/history.
 if exists(select 1 from generate_series(0,2) n where legacy_input->n->'name' is distinct from before_legacy->n->'name' or legacy_input->n->'amount_yen' is distinct from before_legacy->n->'amount_yen' or legacy_input->n->'source_unit' is distinct from before_legacy->n->'source_unit') then
  update public.company_rate_settings set
   allowance_1_unit=case when legacy_input->0->'source_unit' is distinct from before_legacy->0->'source_unit' then btrim(legacy_input->0->>'source_unit') else allowance_1_unit end,
   allowance_2_unit=case when legacy_input->1->'source_unit' is distinct from before_legacy->1->'source_unit' then btrim(legacy_input->1->>'source_unit') else allowance_2_unit end,
   allowance_3_unit=case when legacy_input->2->'source_unit' is distinct from before_legacy->2->'source_unit' then btrim(legacy_input->2->>'source_unit') else allowance_3_unit end,
   allowance_1_name=legacy_input->0->>'name',allowance_1_amount_yen=(legacy_input->0->>'amount_yen')::integer,
   allowance_2_name=legacy_input->1->>'name',allowance_2_amount_yen=(legacy_input->1->>'amount_yen')::integer,
   allowance_3_name=legacy_input->2->>'name',allowance_3_amount_yen=(legacy_input->2->>'amount_yen')::integer,
   updated_by=auth.uid(),updated_at=clock_timestamp() where company_id=cid;
 end if;
 pos:=0;
 before_items:=company_common_allowance_private.active_items(cid,typ);
 for item in select value from jsonb_array_elements(input_items) loop
  if jsonb_typeof(item)<>'object' or (select count(*) from jsonb_object_keys(item))<>6
  or not(item ?& array['id','client_key','section','unit','name','amount_yen'])
  or jsonb_typeof(item->'client_key')<>'string' or item->>'client_key' !~ '^[A-Za-z0-9_-]{1,120}$'
  or jsonb_typeof(item->'section')<>'string' or item->>'section' not in ('earning','deduction')
  or jsonb_typeof(item->'unit')<>'string' or item->>'unit' not in ('hour','day','month')
  or jsonb_typeof(item->'name')<>'string' or length(btrim(item->>'name')) not between 1 and 80
  or jsonb_typeof(item->'amount_yen')<>'number' or item->>'amount_yen' !~ '^(0|[1-9][0-9]*)$'
  or (item->>'amount_yen')::numeric>2147483647 then
   raise exception 'invalid company common allowance item' using errcode='22023';end if;
  key:=item->>'client_key';
  if key=any(keys_seen) then raise exception 'duplicate client key' using errcode='22023';end if;
  keys_seen:=array_append(keys_seen,key);
  if item->'id'='null'::jsonb then
   insert into company_common_allowance_private.items(company_id,payroll_type,section,unit,name,amount_yen,position,created_by,updated_by)
   values(cid,typ,item->>'section',item->>'unit',btrim(item->>'name'),(item->>'amount_yen')::integer,pos,auth.uid(),auth.uid()) returning id into item_id;
  else
   if jsonb_typeof(item->'id')<>'string' or item->>'id' !~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' then
    raise exception 'invalid allowance id' using errcode='22023';end if;
   item_id:=(item->>'id')::uuid;
   if item_id=any(seen) then raise exception 'duplicate allowance id' using errcode='22023';end if;
   update company_common_allowance_private.items set section=item->>'section',unit=item->>'unit',
    name=btrim(item->>'name'),amount_yen=(item->>'amount_yen')::integer,position=pos,updated_by=auth.uid(),updated_at=clock_timestamp()
   where id=item_id and company_id=cid and payroll_type=typ and retired_at is null;
   if not found then raise exception 'allowance id unavailable' using errcode='22023';end if;
  end if;
  seen:=array_append(seen,item_id);mapping:=mapping||jsonb_build_array(jsonb_build_object('client_key',key,'id',item_id));pos:=pos+1;
 end loop;
 update company_common_allowance_private.items set retired_at=clock_timestamp(),retired_by=auth.uid(),updated_at=clock_timestamp(),updated_by=auth.uid()
 where company_id=cid and payroll_type=typ and retired_at is null and not(id=any(seen));
 update company_common_allowance_private.state set version=v+1 where company_id=cid;
 insert into company_common_allowance_private.history(company_id,version,actor_id,payroll_type,request_id,operation,before_value,after_value)
 values(cid,v+1,auth.uid(),typ,rid,'allowances',jsonb_build_object('items',before_items,'legacy_refs',before_legacy),jsonb_build_object('items',company_common_allowance_private.active_items(cid,typ),'legacy_refs',company_common_allowance_private.admin_state(cid)->'legacy_refs'));
 outcome:=company_common_allowance_private.admin_state(cid)||jsonb_build_object('request_id',rid,'committed_version',v+1,'id_map',mapping);
 insert into company_common_allowance_private.requests(company_id,request_id,actor_id,payroll_type,operation,expected_version,request_payload,committed_version,result)
 values(cid,rid,auth.uid(),typ,'allowances',expected,payload,v+1,outcome);
 return outcome;
end $$;
create function company_common_allowance_private.history_page(cid uuid,before_v bigint,lim integer) returns jsonb
language plpgsql stable security definer set search_path='' as $$
declare entries jsonb;oldest bigint;
begin
 perform company_common_allowance_private.authorize(cid,false);
 if lim is null or lim not between 1 and 100 or (before_v is not null and before_v<1) then
  raise exception 'invalid allowance history page' using errcode='22023';end if;
 select coalesce(jsonb_agg(to_jsonb(h) order by version desc),'[]'::jsonb),min(version) into entries,oldest
 from (select * from company_common_allowance_private.history where company_id=cid and (before_v is null or version<before_v) order by version desc limit lim) h;
 return jsonb_build_object('contract_version',1,'company_id',cid,'entries',entries,'before_version',
 case when exists(select 1 from company_common_allowance_private.history where company_id=cid and version<oldest) then oldest end);
end $$;
create function company_common_allowance_private.save_tax(cid uuid,expected bigint,expected_source jsonb,tax numeric,welfare numeric,rid uuid) returns jsonb
language plpgsql volatile security definer set search_path='' as $$
declare v bigint;payload jsonb;receipt company_common_allowance_private.requests%rowtype;outcome jsonb;before_tax jsonb;
begin
 perform company_common_allowance_private.lock_writer(cid);
 if expected is null or expected<0 or expected>9007199254740990 or rid is null
 or tax is null or welfare is null or tax<0 or tax>100 or welfare<0 or welfare>100
 or tax<>round(tax,4) or welfare<>round(welfare,4) then
  raise exception 'invalid company common tax request' using errcode='22023';end if;
 payload:=jsonb_build_object('operation','tax','expected_version',expected,'expected_source',expected_source,'tax_rate',tax,'welfare_rate',welfare);
 select * into receipt from company_common_allowance_private.requests where company_id=cid and request_id=rid;
 if found then
  if receipt.actor_id is distinct from auth.uid() or receipt.request_payload is distinct from payload then
   raise exception 'request id payload mismatch' using errcode='22023';end if;
  return receipt.result;
 end if;
 insert into company_common_allowance_private.state(company_id,version,created_by) values(cid,0,auth.uid()) on conflict(company_id) do nothing;
 select version into v from company_common_allowance_private.state where company_id=cid for update;
 if v<>expected or expected_source is distinct from company_common_allowance_private.source(cid) then
  raise exception 'company common allowance version conflict' using errcode='40001';end if;
 before_tax:=jsonb_build_object('tax_rate',expected_source->'tax_rate','welfare_rate',expected_source->'welfare_rate');
 update public.companies set tax_rate=tax,default_welfare_rate=welfare where id=cid;
 update company_common_allowance_private.state set version=v+1 where company_id=cid;
 insert into company_common_allowance_private.history(company_id,version,actor_id,payroll_type,request_id,operation,before_value,after_value)
 values(cid,v+1,auth.uid(),null,rid,'tax',before_tax,jsonb_build_object('tax_rate',tax,'welfare_rate',welfare));
 outcome:=company_common_allowance_private.admin_state(cid)||jsonb_build_object('request_id',rid,'committed_version',v+1,'id_map','[]'::jsonb);
 insert into company_common_allowance_private.requests(company_id,request_id,actor_id,payroll_type,operation,expected_version,request_payload,committed_version,result)
 values(cid,rid,auth.uid(),null,'tax',expected,payload,v+1,outcome);
 return outcome;
end $$;
revoke all on all functions in schema company_common_allowance_private from public,anon,authenticated,service_role;
grant usage on schema company_common_allowance_private to authenticated;
grant execute on function company_common_allowance_private.admin_state(uuid),company_common_allowance_private.save(uuid,text,bigint,jsonb,uuid,jsonb,jsonb,boolean),company_common_allowance_private.save_tax(uuid,bigint,jsonb,numeric,numeric,uuid),company_common_allowance_private.request_result(uuid,uuid),company_common_allowance_private.history_page(uuid,bigint,integer) to authenticated;
create function public.read_company_common_allowances_admin(p_company_id uuid) returns jsonb
language sql stable security invoker set search_path='' as $$select company_common_allowance_private.admin_state(p_company_id)$$;
create function public.save_company_common_allowances(p_company_id uuid,p_payroll_type text,p_expected_version bigint,p_expected_source jsonb,p_request_id uuid,p_items jsonb,p_legacy_slots jsonb,p_confirm_adoption boolean) returns jsonb
language sql volatile security invoker set search_path='' as $$select company_common_allowance_private.save(p_company_id,p_payroll_type,p_expected_version,p_expected_source,p_request_id,p_items,p_legacy_slots,p_confirm_adoption)$$;
create function public.read_company_common_allowance_request(p_company_id uuid,p_request_id uuid) returns jsonb
language sql stable security invoker set search_path='' as $$select company_common_allowance_private.request_result(p_company_id,p_request_id)$$;
create function public.read_company_common_allowances_history(p_company_id uuid,p_before_version bigint default null,p_limit integer default 50) returns jsonb
language sql stable security invoker set search_path='' as $$select company_common_allowance_private.history_page(p_company_id,p_before_version,p_limit)$$;
create function public.save_company_common_tax_settings(p_company_id uuid,p_expected_version bigint,p_expected_source jsonb,p_tax_rate numeric,p_welfare_rate numeric,p_request_id uuid) returns jsonb
language sql volatile security invoker set search_path='' as $$select company_common_allowance_private.save_tax(p_company_id,p_expected_version,p_expected_source,p_tax_rate,p_welfare_rate,p_request_id)$$;
revoke all on function public.read_company_common_allowances_admin(uuid),public.save_company_common_allowances(uuid,text,bigint,jsonb,uuid,jsonb,jsonb,boolean),public.save_company_common_tax_settings(uuid,bigint,jsonb,numeric,numeric,uuid),public.read_company_common_allowance_request(uuid,uuid),public.read_company_common_allowances_history(uuid,bigint,integer) from public,anon,authenticated,service_role;
grant execute on function public.read_company_common_allowances_admin(uuid),public.save_company_common_allowances(uuid,text,bigint,jsonb,uuid,jsonb,jsonb,boolean),public.save_company_common_tax_settings(uuid,bigint,jsonb,numeric,numeric,uuid),public.read_company_common_allowance_request(uuid,uuid),public.read_company_common_allowances_history(uuid,bigint,integer) to authenticated;
create or replace function public.my_attendance_allowance_units()
returns jsonb
language plpgsql
stable
security definer
set search_path to 'public','pg_temp'
as $$
declare
  v_user_id uuid:=auth.uid();
  v_company_id uuid;
  v_rates public.company_rate_settings%rowtype;
begin
  if v_user_id is null then raise exception 'authentication required'; end if;
  select company_id into v_company_id
  from public.company_members
  where user_id=v_user_id
  limit 1;
  if v_company_id is null then return '{}'::jsonb; end if;

  select * into v_rates
  from public.company_rate_settings
  where company_id=v_company_id;

  return company_common_allowance_private.merge_unit_aliases(v_company_id,jsonb_strip_nulls(jsonb_build_object(
    coalesce(nullif(trim(v_rates.allowance_1_name),''),'__none1'),
      coalesce(nullif(trim(v_rates.allowance_1_unit),''),'回'),
    coalesce(nullif(trim(v_rates.allowance_2_name),''),'__none2'),
      coalesce(nullif(trim(v_rates.allowance_2_unit),''),'回'),
    coalesce(nullif(trim(v_rates.allowance_3_name),''),'__none3'),
      coalesce(nullif(trim(v_rates.allowance_3_unit),''),'回')
  )) - '__none1' - '__none2' - '__none3');
end;
$$;
commit;
