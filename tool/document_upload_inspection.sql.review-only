-- Isolated proof candidate. NOT A MIGRATION: no upload permission or API.
-- Service authorization and actual bytes must be verified by a trusted service.
create table private.document_upload_inspection_candidates (
 id uuid primary key, actor_id uuid not null, company_id uuid not null,
 worker_id uuid not null, requirement_id uuid not null, request_id uuid not null,
 object_path text not null unique, object_version text not null,
 status text not null check(status in ('awaiting_inspection','inspected','cancelled')),
 sha256 text, byte_count bigint, mime text,
 created_at timestamptz not null default clock_timestamp(),
 expires_at timestamptz not null,
 check (expires_at > created_at)
);
alter table private.document_upload_inspection_candidates enable row level security;
revoke all on private.document_upload_inspection_candidates from public, anon, authenticated, service_role;

create function private.commit_document_upload_inspection(
 p_id uuid, p_actor uuid, p_request uuid, p_version text, p_sha text, p_bytes bigint, p_mime text
) returns boolean language plpgsql security definer set search_path='' as $$
declare r private.document_upload_inspection_candidates%rowtype; obj storage.objects%rowtype;
begin
 if p_sha is null or p_sha !~ '^[0-9a-f]{64}$' or p_bytes is null or p_bytes <= 0 or p_bytes > 20971520
  or p_mime is null or p_mime not in ('application/pdf','image/jpeg','image/png','image/heic') or p_version is null then return false; end if;
 select * into r from private.document_upload_inspection_candidates where id=p_id for update;
 if not found or r.status <> 'awaiting_inspection' or r.expires_at <= clock_timestamp()
  or r.actor_id is distinct from p_actor or r.request_id is distinct from p_request
  or r.object_version is distinct from p_version then return false; end if;
 -- The caller must also enforce the live session, feature gate and relationship
 -- in the same transaction before invoking this private helper.
 select * into obj from storage.objects where bucket_id='worker-documents' and name=r.object_path for share;
 if not found or obj.version is distinct from r.object_version or obj.is_delete_marker then return false; end if;
 update private.document_upload_inspection_candidates set status='inspected',sha256=p_sha,byte_count=p_bytes,mime=p_mime where id=r.id;
 return true;
end $$;
revoke all on function private.commit_document_upload_inspection(uuid,uuid,uuid,text,text,bigint,text) from public,anon,authenticated,service_role;
-- Explicit grant is intentionally withheld until the enclosing transaction and
-- trusted service are implemented and audited.
